}
],
"blocks": [
{
"type": "service_card",
"name": "Service card",
"settings": [
{
"type": "image_picker",
"id": "image",
"label": "Image"
},
{
"type": "text",
"id": "title",
"label": "Title",
"default": "Service title"
},
{
"type": "textarea",
