{% doc %}
  @prompt
    Create an “Add Location” control intended for the storefront navbar. Clicking it opens an accessible popup where customers can enter or select their delivery location. Display the selected location in the control after confirmation and allow customers to change it. Match the theme’s existing styling and support mobile navigation. This selects a storefront location preference only; do not claim it verifies delivery availability or changes checkout shipping addresses.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-location-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #000000;
    font-family: inherit;
    z-index: 20;
  }

  .ai-location-{{ ai_gen_id }}__trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 8px 12px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 100px;
    background: #ffffff;
    color: #000000;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
    max-width: 100%;
  }

  .ai-location-{{ ai_gen_id }}__trigger:focus-visible,
  .ai-location-{{ ai_gen_id }}__panel button:focus-visible,
  .ai-location-{{ ai_gen_id }}__panel input:focus-visible {
    outline: 2px solid #000000;
    outline-offset: 3px;
  }

  .ai-location-{{ ai_gen_id }}__pin { width: 18px; height: 18px; flex: 0 0 auto; }
  .ai-location-{{ ai_gen_id }}__value { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ai-location-{{ ai_gen_id }}__chevron { width: 12px; height: 12px; flex: 0 0 auto; }

  .ai-location-{{ ai_gen_id }}__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(360px, calc(100vw - 32px));
    padding: 22px;
    border: 1px solid #e6e6e6;
    border-radius: 8px;
    background: #ffffff;
    color: #000000;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.16);
  }

  .ai-location-{{ ai_gen_id }}__panel[hidden] { display: none; }
  .ai-location-{{ ai_gen_id }}__heading { margin: 0 32px 6px 0; font-size: 20px; line-height: 1.3; }
  .ai-location-{{ ai_gen_id }}__note { margin: 0 0 18px; font-size: 14px; line-height: 1.5; }
  .ai-location-{{ ai_gen_id }}__close {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #000000;
    cursor: pointer;
  }
  .ai-location-{{ ai_gen_id }}__close svg { width: 18px; height: 18px; }
  .ai-location-{{ ai_gen_id }}__label { display: block; margin-bottom: 6px; font-size: 14px; font-weight: 600; }
  .ai-location-{{ ai_gen_id }}__input {
    box-sizing: border-box;
    width: 100%;
    min-height: 46px;
    padding: 10px 12px;
    border: 1px solid #767676;
    border-radius: 8px;
    background: #ffffff;
    color: #000000;
    font: inherit;
    font-size: 16px;
  }
  .ai-location-{{ ai_gen_id }}__submit {
    width: 100%;
    min-height: 46px;
    margin-top: 12px;
    padding: 10px 16px;
    border: 1px solid #000000;
    border-radius: 100px;
    background: #c3cca6;
    color: #000000;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .ai-location-{{ ai_gen_id }}__submit:hover { background: #b5c095; }

  @media screen and (max-width: 749px) {
    .ai-location-{{ ai_gen_id }} { width: 100%; }
    .ai-location-{{ ai_gen_id }}__trigger { min-height: 44px; }
    .ai-location-{{ ai_gen_id }}__panel {
      position: fixed;
      top: auto;
      right: 12px;
      bottom: 12px;
      left: 12px;
      width: auto;
      max-width: none;
      z-index: 1000;
    }
  }
{% endstyle %}

<location-preference-{{ ai_gen_id }} class="ai-location-{{ ai_gen_id }}" data-storage-key="ai-location-preference">
  <button class="ai-location-{{ ai_gen_id }}__trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="ai-location-panel-{{ ai_gen_id }}">
    <svg class="ai-location-{{ ai_gen_id }}__pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
    <span class="ai-location-{{ ai_gen_id }}__value">Add location</span>
    <svg class="ai-location-{{ ai_gen_id }}__chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m2 4 4 4 4-4"/></svg>
  </button>
  <div id="ai-location-panel-{{ ai_gen_id }}" class="ai-location-{{ ai_gen_id }}__panel" role="dialog" aria-modal="false" aria-labelledby="ai-location-heading-{{ ai_gen_id }}" hidden>
    <button class="ai-location-{{ ai_gen_id }}__close" type="button" aria-label="Close location dialog">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m18 6-12 12M6 6l12 12"/></svg>
    </button>
    <h2 id="ai-location-heading-{{ ai_gen_id }}" class="ai-location-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    <p class="ai-location-{{ ai_gen_id }}__note">{{ block.settings.helper_text | escape }}</p>
    <form class="ai-location-{{ ai_gen_id }}__form">
      <label class="ai-location-{{ ai_gen_id }}__label" for="ai-location-input-{{ ai_gen_id }}">{{ block.settings.field_label | escape }}</label>
      <input id="ai-location-input-{{ ai_gen_id }}" class="ai-location-{{ ai_gen_id }}__input" type="text" name="location" maxlength="100" autocomplete="address-level2" placeholder="{{ block.settings.placeholder | escape }}" required>
      <button class="ai-location-{{ ai_gen_id }}__submit" type="submit">{{ block.settings.confirm_label | escape }}</button>
    </form>
  </div>
  <span class="visually-hidden" aria-live="polite" aria-atomic="true"></span>
  {{ block.shopify_attributes }}
</location-preference-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'location-preference-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class LocationPreference extends HTMLElement {
      connectedCallback() {
        this.trigger = this.querySelector('button[aria-haspopup="dialog"]');
        this.panel = this.querySelector('[role="dialog"]');
        this.input = this.querySelector('input[name="location"]');
        this.value = this.querySelector('.ai-location-{{ ai_gen_id }}__value');
        this.live = this.querySelector('[aria-live]');
        this.form = this.querySelector('form');
        this.closeButton = this.querySelector('.ai-location-{{ ai_gen_id }}__close');
        try {
          const saved = localStorage.getItem(this.dataset.storageKey);
          if (saved) this.setLocation(saved, false);
        } catch (error) {}
        this.trigger.addEventListener('click', () => this.open());
        this.closeButton.addEventListener('click', () => this.close(true));
        this.form.addEventListener('submit', (event) => {
          event.preventDefault();
          const location = this.input.value.trim();
          if (!location) { this.input.focus(); return; }
          this.setLocation(location, true);
          this.close(true);
        });
        this.panel.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') { this.close(true); return; }
          if (event.key !== 'Tab') return;
          const focusable = Array.from(this.panel.querySelectorAll('button, input')).filter((item) => !item.disabled);
          if (!focusable.length) return;
          if (event.shiftKey && document.activeElement === focusable[0]) { event.preventDefault(); focusable[focusable.length - 1].focus(); }
          else if (!event.shiftKey && document.activeElement === focusable[focusable.length - 1]) { event.preventDefault(); focusable[0].focus(); }
        });
        this.outsideHandler = (event) => {
          if (!this.contains(event.target)) this.close(false);
        };
        document.addEventListener('click', this.outsideHandler);
      }
      disconnectedCallback() { document.removeEventListener('click', this.outsideHandler); }
      open() {
        this.panel.hidden = false;
        this.trigger.setAttribute('aria-expanded', 'true');
        this.input.value = this.value.textContent === 'Add location' ? '' : this.value.textContent;
        this.input.focus();
      }
      close(restoreFocus) {
        if (this.panel.hidden) return;
        this.panel.hidden = true;
        this.trigger.setAttribute('aria-expanded', 'false');
        if (restoreFocus) this.trigger.focus();
      }
      setLocation(location, announce) {
        this.value.textContent = location;
        this.input.value = location;
        if (announce) this.live.textContent = 'Location preference saved: ' + location;
        try { localStorage.setItem(this.dataset.storageKey, location); } catch (error) {}
      }
    }
    customElements.define(tagName, LocationPreference);
  })();
</script>

{% schema %}
{
  "name": "Add location",
  "settings": [
    { "type": "header", "content": "Location prompt" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your location" },
    { "type": "text", "id": "helper_text", "label": "Helper text", "default": "Save a location preference for your storefront experience. This does not check delivery availability or change your checkout shipping address." },
    { "type": "text", "id": "field_label", "label": "Field label", "default": "City or area" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Enter a city or area" },
    { "type": "text", "id": "confirm_label", "label": "Confirm button", "default": "Confirm location" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Add location" }],
  "tag": null,
  "class": "add-location-control"
}
{% endschema %}