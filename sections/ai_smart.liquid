{% liquid
  assign selected_product = section.settings.main_product
%}

<section
  id="AiSmart-{{ section.id }}"
  class="ai-smart color-{{ section.settings.color_scheme }}"
  style="
    --ai-bg: {{ section.settings.background_color }};
    --ai-heading: {{ section.settings.heading_color }};
    --ai-text: {{ section.settings.text_color }};
    --ai-pill-bg: {{ section.settings.pill_background }};
    --ai-pill-text: {{ section.settings.pill_text_color }};
    --ai-pill-border: {{ section.settings.pill_border_color }};
    --ai-pill-active-bg: {{ section.settings.pill_active_background }};
    --ai-pill-active-text: {{ section.settings.pill_active_text_color }};
    --ai-panel-bg: {{ section.settings.panel_background }};
    --ai-panel-heading: {{ section.settings.panel_heading_color }};
    --ai-card-bg: {{ section.settings.update_card_background }};
    --ai-card-text: {{ section.settings.update_card_text_color }};
    --ai-card-shadow: {{ section.settings.update_card_shadow_color }};
    --ai-card-radius: {{ section.settings.card_radius }}px;
    --ai-pill-radius: {{ section.settings.pill_radius }}px;
    --ai-gap: {{ section.settings.content_gap }}px;
    --ai-padding-top: {{ section.settings.padding_top }}px;
    --ai-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width-normal ai-smart__inner">
    <header class="ai-smart__header">
      {% if section.settings.eyebrow != blank %}
        <p class="ai-smart__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="ai-smart__heading">{{ section.settings.heading }}</h2>
        <span class="ai-smart__rule" aria-hidden="true"></span>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="ai-smart__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    <div class="ai-smart__body">
      <div class="ai-smart__left">
        {% assign chip_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'chip' %}
            {% assign chip_count = chip_count | plus: 1 %}
          {% endif %}
        {% endfor %}

        {% if chip_count > 0 %}
          <div class="ai-smart__chips" role="list" aria-label="Recommendation filters">
            <div class="ai-smart__sparkle" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="ai-smart__sparkle-icon" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2l1.7 4.3L18 8l-4.3 1.7L12 14l-1.7-4.3L6 8l4.3-1.7L12 2Z"></path>
                <path d="M5 14l0.9 2.1L8 17l-2.1 0.9L5 20l-0.9-2.1L2 17l2.1-0.9L5 14Z"></path>
              </svg>
            </div>

            {% assign first_chip_rendered = false %}
            {% for block in section.blocks %}
              {% if block.type == 'chip' %}
                <span class="ai-smart__chip{% unless first_chip_rendered %} is-active{% endunless %}" role="listitem" {{ block.shopify_attributes }}>
                  {{ block.settings.label }}
                </span>
                {% assign first_chip_rendered = true %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        <div class="ai-smart__media">
          {% if selected_product != blank %}
            <a class="ai-smart__product-link" href="{{ selected_product.url }}" aria-label="View {{ selected_product.title | escape }}">
              {% if selected_product.featured_media != blank %}
                {% assign product_alt = selected_product.featured_media.alt | default: selected_product.title %}
                {{
                  selected_product.featured_media
                  | image_url: width: 1600
                  | image_tag:
                    widths: '480, 720, 960, 1200, 1600',
                    sizes: '(max-width: 749px) 100vw, (max-width: 999px) 90vw, 56vw',
                    class: 'ai-smart__image',
                    loading: 'lazy',
                    alt: product_alt
                }}

                {% if section.settings.show_product_caption %}
                  <div class="ai-smart__caption">
                    <div class="ai-smart__caption-text">
                      <span class="ai-smart__caption-title">{{ selected_product.title }}</span>
                      <span class="ai-smart__caption-price">
                        {{ selected_product.price | money }}
                        {% if selected_product.compare_at_price > selected_product.price %}
                          <s class="ai-smart__caption-compare">{{ selected_product.compare_at_price | money }}</s>
                        {% endif %}
                      </span>
                    </div>
                    {% if section.settings.button_label != blank %}
                      <span class="ai-smart__cta">
                        {{ section.settings.button_label }}
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                      </span>
                    {% endif %}
                  </div>
                {% endif %}
              {% else %}
                <div class="ai-smart__product-fallback">
                  <p class="ai-smart__product-name">{{ selected_product.title }}</p>
                  <p class="ai-smart__product-price">{{ selected_product.price | money }}</p>
                </div>
              {% endif %}
            </a>
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'ai-smart__image ai-smart__image--placeholder' }}
          {% endif %}
        </div>
      </div>

      <aside class="ai-smart__panel" aria-label="{{ section.settings.panel_heading | escape }}">
        {% if section.settings.panel_heading != blank %}
          <h3 class="ai-smart__panel-heading">
            <span class="ai-smart__live-dot" aria-hidden="true"></span>
            {{ section.settings.panel_heading }}
          </h3>
        {% endif %}

        <div class="ai-smart__updates">
          {% assign update_count = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'update' %}
              {% assign update_count = update_count | plus: 1 %}
              <article class="ai-smart__update" {{ block.shopify_attributes }}>
                <div class="ai-smart__update-body">
                  {% if block.settings.title != blank %}
                    <h4 class="ai-smart__update-title">{{ block.settings.title }}</h4>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <p class="ai-smart__update-text">{{ block.settings.text }}</p>
                  {% endif %}
                </div>
              </article>
            {% endif %}
          {% endfor %}

          {% if update_count == 0 %}
            <p class="ai-smart__empty">Add update blocks to show live updates.</p>
          {% endif %}
        </div>
      </aside>
    </div>
  </div>
</section>

{% stylesheet %}
  .ai-smart {
    position: relative;
    overflow: hidden;
    background: var(--ai-bg);
    padding-top: var(--ai-padding-top);
    padding-bottom: var(--ai-padding-bottom);
  }

  /* soft ambient glow behind the content */
  .ai-smart::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto auto;
    width: 60%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--ai-heading) 9%, transparent), transparent 65%);
    pointer-events: none;
  }

  .ai-smart__inner {
    --ai-page-margin: 16px;
    position: relative;
    width: min(var(--narrow-page-width), calc(100% - (var(--ai-page-margin) * 2)));
    margin-inline: auto;
  }

  @media screen and (min-width: 750px) {
    .ai-smart__inner {
      --ai-page-margin: 40px;
    }
  }

  /* ---------- Header ---------- */
  .ai-smart__header {
    margin-bottom: 2.25rem;
    animation: ai-smart-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .ai-smart__eyebrow {
    display: inline-block;
    margin: 0 0 0.75rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ai-heading) 8%, transparent);
    color: var(--ai-heading);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ai-smart__heading {
    margin: 0;
    color: var(--ai-heading);
    font-size: clamp(2.2rem, 4vw, 3.7rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .ai-smart__rule {
    display: block;
    width: 56px;
    height: 4px;
    margin-top: 1rem;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--ai-heading), color-mix(in srgb, var(--ai-heading) 15%, transparent));
  }

  .ai-smart__subheading {
    margin: 0.9rem 0 0;
    max-width: 52ch;
    color: var(--ai-text);
    font-size: clamp(1rem, 1.45vw, 1.3rem);
    line-height: 1.45;
    opacity: 0.9;
  }

  /* ---------- Layout ---------- */
  .ai-smart__body {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.95fr);
    gap: clamp(20px, 3vw, 44px);
    align-items: stretch;
  }

  .ai-smart__left {
    min-width: 0;
    animation: ai-smart-rise 0.7s 0.08s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* ---------- Filter pills ---------- */
  .ai-smart__chips {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
    padding: 0.2rem 0.1rem 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .ai-smart__chips::-webkit-scrollbar {
    display: none;
  }

  .ai-smart__sparkle {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 50%;
    background: var(--ai-heading);
    color: var(--ai-bg);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--ai-heading) 30%, transparent);
  }

  .ai-smart__sparkle-icon {
    display: block;
    width: 1.2rem;
    height: 1.2rem;
  }

  .ai-smart__chip {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-height: 2.35rem;
    padding: 0.45rem 1.15rem;
    border: 1px solid var(--ai-pill-border);
    border-radius: var(--ai-pill-radius);
    background: var(--ai-pill-bg);
    color: var(--ai-pill-text);
    font-size: 0.93rem;
    line-height: 1.1;
    text-align: center;
    white-space: nowrap;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .ai-smart__chip:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 14px color-mix(in srgb, var(--ai-heading) 12%, transparent);
  }

  .ai-smart__chip.is-active {
    border-color: var(--ai-pill-active-text);
    background: var(--ai-pill-active-bg);
    color: var(--ai-pill-active-text);
    font-weight: 600;
    box-shadow: 0 6px 16px color-mix(in srgb, var(--ai-heading) 16%, transparent);
  }

  .ai-smart__chip.is-active::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }

  /* ---------- Product media ---------- */
  .ai-smart__media {
    position: relative;
    overflow: hidden;
    border-radius: calc(var(--ai-card-radius) + 6px);
    background: #fff;
    aspect-ratio: 1.35 / 1;
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--ai-heading) 8%, transparent),
      0 24px 48px -20px color-mix(in srgb, var(--ai-heading) 35%, transparent);
  }

  .ai-smart__product-link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .ai-smart__product-link:focus-visible {
    outline: 3px solid var(--ai-heading);
    outline-offset: -3px;
  }

  .ai-smart__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ai-smart__product-link:hover .ai-smart__image {
    transform: scale(1.045);
  }

  .ai-smart__image--placeholder {
    background: #f3f0ee;
    color: #cabdbc;
  }

  .ai-smart__caption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 3.5rem 1.4rem 1.25rem;
    background: linear-gradient(to top, rgb(22 8 12 / 0.78), rgb(22 8 12 / 0));
    color: #fff;
  }

  .ai-smart__caption-text {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .ai-smart__caption-title {
    overflow: hidden;
    font-size: clamp(1.05rem, 1.6vw, 1.45rem);
    font-weight: 700;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ai-smart__caption-price {
    font-size: 0.98rem;
    opacity: 0.95;
  }

  .ai-smart__caption-compare {
    margin-left: 0.4rem;
    opacity: 0.65;
  }

  .ai-smart__cta {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.05rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.94);
    color: var(--ai-heading);
    font-size: 0.9rem;
    font-weight: 600;
    transition: transform 0.25s ease, gap 0.25s ease;
  }

  .ai-smart__product-link:hover .ai-smart__cta {
    gap: 0.7rem;
    transform: translateY(-2px);
  }

  .ai-smart__product-fallback {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.4rem;
    width: 100%;
    height: 100%;
    padding: 1.25rem;
    background: linear-gradient(180deg, #fff, #f5efeb);
    text-align: center;
  }

  .ai-smart__product-name {
    margin: 0;
    color: var(--ai-heading);
    font-size: clamp(1.2rem, 1.8vw, 1.7rem);
    font-weight: 700;
  }

  .ai-smart__product-price {
    margin: 0;
    color: var(--ai-text);
    font-size: 1rem;
  }

  /* ---------- Live updates panel ---------- */
  .ai-smart__panel {
    display: flex;
    flex-direction: column;
    padding: 1.7rem 1.3rem 1.4rem;
    border: 1px solid color-mix(in srgb, var(--ai-heading) 9%, transparent);
    border-radius: calc(var(--ai-card-radius) + 6px);
    background: linear-gradient(180deg, color-mix(in srgb, var(--ai-panel-bg) 90%, white 10%), var(--ai-panel-bg));
    animation: ai-smart-rise 0.7s 0.16s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .ai-smart__panel-heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin: 0 0 1.4rem;
    color: var(--ai-panel-heading);
    font-size: clamp(1.3rem, 1.8vw, 1.8rem);
    line-height: 1.2;
    text-align: center;
  }

  .ai-smart__live-dot {
    position: relative;
    flex: 0 0 auto;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #e5484d;
  }

  .ai-smart__live-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: inherit;
    animation: ai-smart-pulse 1.8s ease-out infinite;
  }

  .ai-smart__updates {
    display: grid;
    flex: 1;
    grid-auto-rows: 1fr;
    gap: var(--ai-gap);
    counter-reset: ai-update;
  }

  .ai-smart__update {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.95rem;
    padding: 1rem 1.2rem 1rem 1rem;
    overflow: hidden;
    border-radius: calc(var(--ai-card-radius) + 4px);
    background: var(--ai-card-bg);
    box-shadow: 0 10px 24px -14px color-mix(in srgb, var(--ai-card-text) 40%, transparent);
    counter-increment: ai-update;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    animation: ai-smart-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .ai-smart__update:nth-child(1) { animation-delay: 0.22s; }
  .ai-smart__update:nth-child(2) { animation-delay: 0.3s; }
  .ai-smart__update:nth-child(3) { animation-delay: 0.38s; }
  .ai-smart__update:nth-child(4) { animation-delay: 0.46s; }
  .ai-smart__update:nth-child(5) { animation-delay: 0.54s; }

  .ai-smart__update::before {
    content: counter(ai-update, decimal-leading-zero);
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ai-card-shadow) 45%, transparent);
    color: var(--ai-card-text);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .ai-smart__update::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--ai-card-shadow);
    transition: width 0.25s ease;
  }

  .ai-smart__update:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 30px -14px color-mix(in srgb, var(--ai-card-text) 45%, transparent);
  }

  .ai-smart__update:hover::after {
    width: 7px;
  }

  .ai-smart__update-body {
    min-width: 0;
  }

  .ai-smart__update-title {
    margin: 0;
    color: var(--ai-card-text);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .ai-smart__update-text {
    margin: 0.25rem 0 0;
    color: var(--ai-card-text);
    font-size: 0.92rem;
    line-height: 1.4;
    opacity: 0.85;
  }

  .ai-smart__empty {
    margin: 0;
    color: var(--ai-card-text);
    font-size: 0.95rem;
  }

  /* ---------- Responsive ---------- */
  @media screen and (max-width: 999px) {
    .ai-smart__body {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .ai-smart__updates {
      grid-auto-rows: auto;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-smart__header {
      margin-bottom: 1.5rem;
    }

    .ai-smart__chips {
      gap: 0.5rem;
      margin-inline: -0.25rem;
      padding-inline: 0.25rem;
    }

    .ai-smart__chip {
      min-height: 2.15rem;
      padding: 0.4rem 0.95rem;
      font-size: 0.85rem;
    }

    .ai-smart__media {
      aspect-ratio: 1.1 / 1;
    }

    .ai-smart__caption {
      padding: 3rem 1rem 1rem;
    }

    .ai-smart__panel {
      padding: 1.3rem 1rem 1.1rem;
    }

    .ai-smart__update {
      padding: 0.85rem 1rem 0.85rem 0.85rem;
    }
  }

  /* ---------- Motion ---------- */
  @keyframes ai-smart-rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes ai-smart-pulse {
    0% { opacity: 0.7; transform: scale(1); }
    100% { opacity: 0; transform: scale(2.8); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-smart__header,
    .ai-smart__left,
    .ai-smart__panel,
    .ai-smart__update,
    .ai-smart__live-dot::after {
      animation: none;
    }

    .ai-smart__image,
    .ai-smart__cta,
    .ai-smart__chip,
    .ai-smart__update {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AI smart section",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AI Smart Recommendations"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Personalized for you based on your preferences"
    },
    {
      "type": "product",
      "id": "main_product",
      "label": "Main product"
    },
    {
      "type": "checkbox",
      "id": "show_product_caption",
      "label": "Show product name and price on image",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Image button label",
      "default": "Shop now"
    },
    {
      "type": "text",
      "id": "panel_heading",
      "label": "Panel heading",
      "default": "Live Updates"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FCFBFA"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#3A1E25"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Subheading color",
      "default": "#4A2A30"
    },
    {
      "type": "color",
      "id": "pill_background",
      "label": "Pill background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "pill_text_color",
      "label": "Pill text color",
      "default": "#5A3B41"
    },
    {
      "type": "color",
      "id": "pill_border_color",
      "label": "Pill border color",
      "default": "#B99EA3"
    },
    {
      "type": "color",
      "id": "pill_active_background",
      "label": "Active pill background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "pill_active_text_color",
      "label": "Active pill text color",
      "default": "#3A1E25"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background",
      "default": "#F8F5F2"
    },
    {
      "type": "color",
      "id": "panel_heading_color",
      "label": "Panel heading color",
      "default": "#4A2A30"
    },
    {
      "type": "color",
      "id": "update_card_background",
      "label": "Update card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "update_card_text_color",
      "label": "Update card text color",
      "default": "#4A2A30"
    },
    {
