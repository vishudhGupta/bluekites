{% doc %}
  @prompt
    Add product category segments above Our Services
    Create segments in the same style as Our Services for Surgical Products, Hand Rub &
    Disinfectants, Health Care, and Cosmetics, placed above the Our Services section. Use
    glassmorphism for their Add to Cart buttons and other suitable elements.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-segments-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: 36px 24px;
    color: #1b1b1b;
  }

  .ai-category-segments-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    text-align: center;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(26px, 3vw, 40px);
    line-height: 1.15;
  }

  .ai-category-segments-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .ai-category-segments-{{ ai_gen_id }}__category {
    min-width: 0;
    padding: 18px;
    border: 1px solid rgba(55, 24, 29, 0.14);
    border-radius: 16px;
    background: #faf9f7;
  }

  .ai-category-segments-{{ ai_gen_id }}__category-title {
    margin: 0 0 14px;
    font-size: 20px;
    line-height: 1.25;
  }

  .ai-category-segments-{{ ai_gen_id }}__products {
    display: grid;
    gap: 14px;
  }

  .ai-category-segments-{{ ai_gen_id }}__product {
    padding-top: 12px;
    border-top: 1px solid rgba(55, 24, 29, 0.14);
  }

  .ai-category-segments-{{ ai_gen_id }}__product-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 10px;
  }

  .ai-category-segments-{{ ai_gen_id }}__product-name {
    margin: 0 0 5px;
    font-size: 15px;
    line-height: 1.35;
  }

  .ai-category-segments-{{ ai_gen_id }}__product-name a {
    color: inherit;
    text-decoration: none;
  }

  .ai-category-segments-{{ ai_gen_id }}__price {
    margin-bottom: 10px;
    font-size: 14px;
  }

  .ai-category-segments-{{ ai_gen_id }}__button {
    display: inline-flex;
    width: 100%;
    min-height: 42px;
    justify-content: center;
    align-items: center;
    padding: 9px 14px;
    border: 1px solid rgba(255,255,255,.9);
    border-radius: 999px;
    background: rgba(55, 24, 29, .88);
    color: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(34, 17, 19, .16);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .ai-category-segments-{{ ai_gen_id }}__button:hover {
    background: rgba(38, 14, 18, .96);
  }

  .ai-category-segments-{{ ai_gen_id }}__button:focus-visible,
  .ai-category-segments-{{ ai_gen_id }}__product-name a:focus-visible {
    outline: 3px solid #c3cca6;
    outline-offset: 3px;
  }

  .ai-category-segments-{{ ai_gen_id }}__empty {
    margin: 0;
    color: #555;
    font-size: 14px;
    line-height: 1.5;
  }

  @media screen and (max-width: 900px) {
    .ai-category-segments-{{ ai_gen_id }}__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 560px) {
    .ai-category-segments-{{ ai_gen_id }} { padding: 28px 16px; }
    .ai-category-segments-{{ ai_gen_id }}__grid { grid-template-columns: 1fr; gap: 12px; }
    .ai-category-segments-{{ ai_gen_id }}__category { padding: 16px; }
  }
{% endstyle %}

<category-segments-{{ ai_gen_id }} class="ai-category-segments-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-category-segments-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  <div class="ai-category-segments-{{ ai_gen_id }}__grid">
    {% for i in (1..4) %}
      {% liquid
        assign title_key = 'category_' | append: i | append: '_title'
        assign collection_key = 'category_' | append: i | append: '_collection'
        assign category_title = block.settings[title_key]
        assign category_collection = block.settings[collection_key]
      %}
      <section class="ai-category-segments-{{ ai_gen_id }}__category" aria-label="{{ category_title | escape }}">
        <h3 class="ai-category-segments-{{ ai_gen_id }}__category-title">{{ category_title | escape }}</h3>
        {% if category_collection != blank and category_collection.products.size > 0 %}
          <div class="ai-category-segments-{{ ai_gen_id }}__products">
            {% for product in category_collection.products limit: 2 %}
              <article class="ai-category-segments-{{ ai_gen_id }}__product">
                {% if product.featured_image %}<a href="{{ product.url }}" aria-label="{{ product.title | escape }}"><img class="ai-category-segments-{{ ai_gen_id }}__product-image" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="600" height="450"></a>{% endif %}
                <h4 class="ai-category-segments-{{ ai_gen_id }}__product-name"><a href="{{ product.url }}">{{ product.title | escape }}</a></h4>
                <div class="ai-category-segments-{{ ai_gen_id }}__price">{{ product.price | money }}</div>
                {% if product.available %}
                  {% if product.has_only_default_variant %}
                    <form method="post" action="{{ routes.cart_add_url }}">
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button class="ai-category-segments-{{ ai_gen_id }}__button" type="submit">Add to cart</button>
                    </form>
                  {% else %}
                    <a class="ai-category-segments-{{ ai_gen_id }}__button" href="{{ product.url }}">Choose options</a>
                  {% endif %}
                {% else %}
                  <button class="ai-category-segments-{{ ai_gen_id }}__button" type="button" disabled aria-disabled="true">Sold out</button>
                {% endif %}
              </article>
            {% endfor %}
          </div>
        {% else %}
          <p class="ai-category-segments-{{ ai_gen_id }}__empty">Choose a collection for this category in the theme editor.</p>
        {% endif %}
      </section>
    {% endfor %}
  </div>
</category-segments-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Product categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Category 1" },
    { "type": "text", "id": "category_1_title", "label": "Title", "default": "Surgical Products" },
    { "type": "collection", "id": "category_1_collection", "label": "Collection" },
    { "type": "header", "content": "Category 2" },
    { "type": "text", "id": "category_2_title", "label": "Title", "default": "Hand Rub & Disinfectants" },
    { "type": "collection", "id": "category_2_collection", "label": "Collection" },
    { "type": "header", "content": "Category 3" },
    { "type": "text", "id": "category_3_title", "label": "Title", "default": "Health Care" },
    { "type": "collection", "id": "category_3_collection", "label": "Collection" },
    { "type": "header", "content": "Category 4" },
    { "type": "text", "id": "category_4_title", "label": "Title", "default": "Cosmetics" },
    { "type": "collection", "id": "category_4_collection", "label": "Collection" }
  ],
  "presets": [{ "name": "Product categories" }],
  "tag": null,
  "class": "product-category-segments"
}
{% endschema %}