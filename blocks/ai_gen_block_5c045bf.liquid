{% doc %}
  @prompt
    Create a new section at the bottom of the surgical-products collection page, above the footer, matching the current theme. Include a clearly visible button labeled Download PDF. Provide an editable PDF URL setting so the merchant can connect their PDF file. When a valid PDF URL is configured, make the button link to that actual file and request a download where browser support allows. Do not use a fake link or fabricate a PDF; when no URL is set, show an editor-only instruction to connect a PDF and do not show visitors a broken or nonfunctional button. Keep button label, spacing, and alignment editable and make the section mobile friendly and accessible., no no , i will attach a pdf doc , that will be downloaded by the user
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pdf-download-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: {{ block.settings.vertical_spacing }}px 20px;
    text-align: {{ block.settings.alignment }};
    color: #000000;
    background: #ffffff;
  }

  .ai-pdf-download-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-pdf-download-{{ ai_gen_id }}__button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    border: 1px solid #000000;
    border-radius: 100px;
    background: #c3cca6;
    color: #000000;
    font: inherit;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
  }

  .ai-pdf-download-{{ ai_gen_id }}__button:hover {
    background: #000000;
    color: #ffffff;
  }

  .ai-pdf-download-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid #000000;
    outline-offset: 4px;
  }

  .ai-pdf-download-{{ ai_gen_id }}__instruction {
    margin: 0;
    color: #4b4b4b;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-pdf-download-{{ ai_gen_id }} {
      padding-right: 16px;
      padding-left: 16px;
    }

    .ai-pdf-download-{{ ai_gen_id }}__button {
      max-width: 100%;
    }
  }
{% endstyle %}

<div class="ai-pdf-download-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  <div class="ai-pdf-download-{{ ai_gen_id }}__inner">
    {% if block.settings.pdf_url != blank %}
      <a class="ai-pdf-download-{{ ai_gen_id }}__button" href="{{ block.settings.pdf_url }}" download>
        {{ block.settings.button_label | escape }}
      </a>
    {% elsif request.design_mode %}
      <p class="ai-pdf-download-{{ ai_gen_id }}__instruction">Upload your PDF under Content → Files, then add its file URL in this block's PDF URL setting.</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "PDF download button",
  "settings": [
    {
      "type": "url",
      "id": "pdf_url",
      "label": "PDF file URL",
      "info": "Upload your PDF under Content → Files, then paste or select its file URL here."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Download PDF"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "vertical_spacing",
      "label": "Vertical spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "PDF download button"
    }
  ],
  "tag": null,
  "class": "pdf-download-block"
}
{% endschema %}