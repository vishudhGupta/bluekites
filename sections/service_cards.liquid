"default": "scheme-1"
},
{
"type": "header",
"content": "Colors"
},
{
"type": "color",
"id": "section_background",
"label": "Section background",
"default": "#F8F7F4"
},
{
"type": "color",
"id": "heading_color",
"label": "Heading and title color",
"default": "#1C2740"
},
{
"type": "color",
"id": "text_color",
"label": "Description color",
"default": "#5C6478"
},
{
"type": "color",
"id": "card_background",
"label": "Card background",
