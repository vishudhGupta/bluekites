```liquid
{%- doc -%}
  This snippet renders a collection card using the parent block's settings.

  @param {string} card_image - The image to display in the collection card
  @param {string} children - The content to render inside the collection card
  @param {object} collection - The collection to render
  @param {object} block - The parent block object
  @param {object} section - The parent section object
{%- enddoc -%}

{% liquid
  assign onboarding = false
  assign block_settings = block.settings

  if collection == blank
    assign onboarding = true
  endif
%}

{% style %}
  {% if request.visual_preview_mode %}
    .collection-card {
      min-width: 250px;
    }
  {% endif %}
{% endstyle %}

<div
  class="
    collection-card
    border-style
    {% if block_settings.placement == 'on_image' %}collection-card--image-bg{% endif %}
    {% if section.settings.layout_type == 'bento' %}collection-card--image-height-fixed{% endif %}
    {% if section.settings.layout_type == 'editorial' %}collection-card--flexible-aspect-ratio{% endif %}
    {% if block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}
  "
  data-block-id="{{ block.id }}"
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
  style="
    {% render 'border-override', settings: block_settings %}
    --horizontal-alignment: {{ block_settings.horizontal_alignment }};
    --vertical-alignment: {{ block_settings.vertical_alignment }};
    --background-overlay-color: {{ block_settings.overlay_color }};
    --gap: {{ block_settings.collection_card_gap }}px;
  "
  {{- block.shopify_attributes -}}
>
  <a
    class="collection-card__link"
    {% unless onboarding %}
      href="{{ collection.url }}"
    {% endunless %}
  >
    <span class="visually-hidden">
      {% if onboarding %}
        Collection preview
      {% else %}
        {{ collection.title | escape }}
      {% endif %}
    </span>
  </a>

  <div class="collection-card__inner">
    {{ card_image }}

    <div class="collection-card__content layout-panel-flex--column">
      {{ children }}
    </div>
  </div>
</div>

{% stylesheet %}
  .collection-card {
    --fixed-card-height: var(--height-small);
    --collection-card-transition: 220ms ease;

    position: relative;
    isolation: isolate;
    flex: 1 1 var(--card-width-small);
    min-width: 0;
    overflow: hidden;
    transition:
      box-shadow var(--collection-card-transition),
      transform var(--collection-card-transition);
  }

  .collection-card__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    width: 100%;
    min-width: 0;
    height: 100%;
  }

  .collection-card__inner a,
  .collection-card__inner button {
    pointer-events: auto;
  }

  .collection-card__content {
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    --flex-wrap: wrap;
  }

  .collection-card > svg {
    width: 100%;
    height: 100%;
    aspect-ratio: var(--ratio);
  }

  /* Image presentation */

  .collection-card__image {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: 100%;
    overflow: hidden;
  }

  .collection-card__image .resource-image__image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
    transition: transform 450ms cubic-bezier(0.2, 0.65, 0.3, 1);
  }

  .collection-card__image svg,
  .collection-card__image .placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Image zoom: restrained and only on interactive devices */

  @media (hover: hover) and (pointer: fine) {
    .collection-card:hover .collection-card__image .resource-image__image {
      transform: scale(1.045);
    }

    .collection-card:hover {
      box-shadow: 0 10px 28px rgb(0 0 0 / 8%);
    }
  }

  /* Content positioned over the image */

  .collection-card.collection-card--image-bg {
    aspect-ratio: var(--ratio);
  }

  .collection-card--image-bg .collection-card__inner {
    height: 100%;
    min-height: 0;
    gap: 0;
  }

  .collection-card--image-bg .collection-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .collection-card--image-bg .collection-card__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: var(--vertical-alignment, center);
    align-items: var(--horizontal-alignment, flex-start);
    padding: clamp(16px, 3%, 28px);
    gap: var(--gap);
    overflow: hidden;
    background: linear-gradient(
      180deg,
      rgb(0 0 0 / 0%) 20%,
      rgb(0 0 0 / 12%) 48%,
      rgb(0 0 0 / 58%) 100%
    );
    color: #fff;
  }

  .collection-card--image-bg .collection-card__content > * {
    max-width: 100%;
  }

  /* Content positioned below the image */

  .collection-card:not(.collection-card--image-bg) .collection-card__content {
    padding: 16px 0 4px;
    gap: var(--gap);
  }

  /* Bento layout */

  .collection-card--image-height-fixed {
    height: 100%;
  }

  .collection-card--image-height-fixed .collection-card__image {
    height: var(--fixed-card-height);
    width: 100%;
  }

  .collection-card--image-height-fixed.collection-card--image-bg {
    height: var(--fixed-card-height);
    aspect-ratio: unset;
  }

  .collection-card--image-height-fixed.collection-card--image-bg
    .collection-card__image {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  /* Editorial layout */

  .resource-list:not(.hidden--desktop)
    .collection-card--flexible-aspect-ratio.collection-card.collection-card--image-bg,
  .resource-list:not(.hidden--desktop)
    .collection-card--flexible-aspect-ratio.collection-card .placeholder-svg {
    aspect-ratio: 99;
  }

  /* Keyboard accessibility */

  .collection-card__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
    border-radius: inherit;
  }

  /* Keep Shopify theme-editor blocks selectable */

  .shopify-design-mode .collection-card__content * {
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-card,
    .collection-card__image .resource-image__image {
      transition: none;
    }

    .collection-card:hover .collection-card__image .resource-image__image {
      transform: none;
    }
  }
{% endstylesheet %}
