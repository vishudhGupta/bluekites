{% doc %}
  @prompt
    Add a second hero banner slider for Bluekites Global, placed immediately below the existing Bluekites hero slider on the homepage. Keep the existing slider unchanged. Match its current visual style, width, height, corner radius, responsive behavior, and autoplay controls. Provide three editable banner slots, each with desktop image, optional mobile image, banner link, optional headline, subtitle, and button. Keep text overlays off by default so uploaded banner artwork remains unobstructed. Allow each banner to be uploaded independently and skip empty image slots.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .bk-hero-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; position: relative; overflow: hidden; border-radius: {{ block.settings.corner_radius }}px; }
  .bk-hero-{{ ai_gen_id }}__track { position: relative; width: 100%; aspect-ratio: {{ block.settings.desktop_ratio }}; background: #f4f4f4; }
  .bk-hero-{{ ai_gen_id }}__slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity 350ms ease; }
  .bk-hero-{{ ai_gen_id }}__slide.is-active { opacity: 1; visibility: visible; z-index: 1; }
  .bk-hero-{{ ai_gen_id }}__media, .bk-hero-{{ ai_gen_id }}__link { display: block; width: 100%; height: 100%; }
  .bk-hero-{{ ai_gen_id }}__media { object-fit: cover; }
  .bk-hero-{{ ai_gen_id }}__placeholder { width: 100%; height: 100%; display: grid; place-items: center; background: #f4f4f4; }
  .bk-hero-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; object-fit: cover; }
  .bk-hero-{{ ai_gen_id }}__empty { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); color: #444; font: 14px/1.4 sans-serif; text-align: center; }
  .bk-hero-{{ ai_gen_id }}__copy { position: absolute; z-index: 2; left: 8%; bottom: 12%; max-width: min(520px, 80%); color: #fff; text-shadow: 0 1px 5px #000; }
  .bk-hero-{{ ai_gen_id }}__copy h2 { margin: 0 0 8px; color: inherit; }
  .bk-hero-{{ ai_gen_id }}__copy p { margin: 0 0 14px; }
  .bk-hero-{{ ai_gen_id }}__button { display: inline-flex; padding: 10px 20px; border-radius: 24px; background: #fff; color: #111; text-decoration: none; text-shadow: none; font-weight: 600; }
  .bk-hero-{{ ai_gen_id }}__controls { position: absolute; z-index: 3; inset: 50% 12px auto; display: flex; justify-content: space-between; transform: translateY(-50%); pointer-events: none; }
  .bk-hero-{{ ai_gen_id }}__arrow { pointer-events: auto; display: grid; place-items: center; width: 40px; height: 40px; border: 0; border-radius: 50%; background: rgba(255,255,255,.94); color: #111; cursor: pointer; }
  .bk-hero-{{ ai_gen_id }}__arrow:focus-visible, .bk-hero-{{ ai_gen_id }}__dot:focus-visible, .bk-hero-{{ ai_gen_id }}__button:focus-visible { outline: 2px solid #000; outline-offset: 3px; }
  .bk-hero-{{ ai_gen_id }}__dots { position: absolute; z-index: 3; inset: auto 0 14px; display: flex; justify-content: center; gap: 8px; }
  .bk-hero-{{ ai_gen_id }}__dot { width: 9px; height: 9px; padding: 0; border: 1px solid #fff; border-radius: 50%; background: rgba(0,0,0,.5); cursor: pointer; }
  .bk-hero-{{ ai_gen_id }}__dot[aria-current="true"] { background: #fff; }
  @media (max-width: 749px) {
    .bk-hero-{{ ai_gen_id }}__track { aspect-ratio: {{ block.settings.mobile_ratio }}; }
    .bk-hero-{{ ai_gen_id }}__desktop { display: none; }
    .bk-hero-{{ ai_gen_id }}__copy { left: 6%; bottom: 12%; }
  }
  @media (min-width: 750px) { .bk-hero-{{ ai_gen_id }}__mobile { display: none; } }
  @media (prefers-reduced-motion: reduce) { .bk-hero-{{ ai_gen_id }}__slide { transition: none; } }
{% endstyle %}

<bk-hero-{{ ai_gen_id }} class="bk-hero-{{ ai_gen_id }}" data-autoplay="{{ block.settings.autoplay }}" data-interval="{{ block.settings.autoplay_seconds | times: 1000 }}" {{ block.shopify_attributes }}>
  <div class="bk-hero-{{ ai_gen_id }}__track" aria-live="off">
    {% assign slide_count = 0 %}
    {% for i in (1..3) %}
      {% assign desktop_key = 'banner_' | append: i | append: '_desktop' %}
      {% assign mobile_key = 'banner_' | append: i | append: '_mobile' %}
      {% assign link_key = 'banner_' | append: i | append: '_link' %}
      {% assign heading_key = 'banner_' | append: i | append: '_heading' %}
      {% assign subtitle_key = 'banner_' | append: i | append: '_subtitle' %}
      {% assign button_key = 'banner_' | append: i | append: '_button' %}
      {% assign desktop_image = block.settings[desktop_key] %}
      {% assign mobile_image = block.settings[mobile_key] %}
      {% if desktop_image != blank %}
        {% assign slide_count = slide_count | plus: 1 %}
        <div class="bk-hero-{{ ai_gen_id }}__slide{% if slide_count == 1 %} is-active{% endif %}" data-slide="{{ slide_count }}" {% if slide_count != 1 %}aria-hidden="true"{% endif %}>
          {% if block.settings[link_key] != blank %}<a class="bk-hero-{{ ai_gen_id }}__link" href="{{ block.settings[link_key] }}" aria-label="{{ block.settings[heading_key] | default: 'View banner' | escape }}">{% endif %}
          {% if mobile_image != blank %}<img class="bk-hero-{{ ai_gen_id }}__media bk-hero-{{ ai_gen_id }}__mobile" src="{{ mobile_image | image_url: width: 1200 }}" alt="{{ mobile_image.alt | escape }}" width="{{ mobile_image.width }}" height="{{ mobile_image.height }}" loading="lazy">{% endif %}
          <img class="bk-hero-{{ ai_gen_id }}__media{% if mobile_image != blank %} bk-hero-{{ ai_gen_id }}__desktop{% endif %}" src="{{ desktop_image | image_url: width: 2400 }}" alt="{{ desktop_image.alt | escape }}" width="{{ desktop_image.width }}" height="{{ desktop_image.height }}" loading="lazy">
          {% if block.settings.show_overlay and block.settings[heading_key] != blank or block.settings.show_overlay and block.settings[subtitle_key] != blank or block.settings.show_overlay and block.settings[button_key] != blank %}
            <div class="bk-hero-{{ ai_gen_id }}__copy">
              {% if block.settings[heading_key] != blank %}<h2>{{ block.settings[heading_key] | escape }}</h2>{% endif %}
              {% if block.settings[subtitle_key] != blank %}<p>{{ block.settings[subtitle_key] | escape }}</p>{% endif %}
              {% if block.settings[button_key] != blank and block.settings[link_key] != blank %}<span class="bk-hero-{{ ai_gen_id }}__button">{{ block.settings[button_key] | escape }}</span>{% endif %}
            </div>
          {% endif %}
          {% if block.settings[link_key] != blank %}</a>{% endif %}
        </div>
      {% endif %}
    {% endfor %}
    {% if slide_count == 0 %}<div class="bk-hero-{{ ai_gen_id }}__placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag }}<span class="bk-hero-{{ ai_gen_id }}__empty">Add a desktop banner image to display this slider.</span></div>{% endif %}
    {% if slide_count > 1 %}
      <div class="bk-hero-{{ ai_gen_id }}__controls"><button class="bk-hero-{{ ai_gen_id }}__arrow" type="button" data-prev aria-label="Previous banner">&#8592;</button><button class="bk-hero-{{ ai_gen_id }}__arrow" type="button" data-next aria-label="Next banner">&#8594;</button></div>
      <div class="bk-hero-{{ ai_gen_id }}__dots" role="group" aria-label="Choose a banner">
        {% for i in (1..slide_count) %}<button type="button" class="bk-hero-{{ ai_gen_id }}__dot" data-dot="{{ i }}" aria-label="Show banner {{ i }}" aria-current="{% if i == 1 %}true{% else %}false{% endif %}"></button>{% endfor %}
      </div>
    {% endif %}
  </div>
</bk-hero-{{ ai_gen_id }}>

<script>
  (() => {
    const tag = 'bk-hero-{{ ai_gen_id }}';
    if (customElements.get(tag)) return;
    class BluekitesHero{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.slides = [...this.querySelectorAll('[data-slide]')];
        this.dots = [...this.querySelectorAll('[data-dot]')];
        if (this.slides.length < 2) return;
        this.index = 0;
        this.querySelector('[data-prev]').addEventListener('click', () => this.show(this.index - 1));
        this.querySelector('[data-next]').addEventListener('click', () => this.show(this.index + 1));
        this.dots.forEach((dot, i) => dot.addEventListener('click', () => this.show(i)));
        this.addEventListener('mouseenter', () => this.pause());
        this.addEventListener('mouseleave', () => this.play());
        this.addEventListener('focusin', () => this.pause());
        this.addEventListener('focusout', () => this.play());
        this.play();
      }
      show(next) {
        this.index = (next + this.slides.length) % this.slides.length;
        this.slides.forEach((slide, i) => { const active = i === this.index; slide.classList.toggle('is-active', active); slide.setAttribute('aria-hidden', String(!active)); });
        this.dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === this.index)));
      }
      pause() { window.clearInterval(this.timer); }
      play() {
        this.pause();
        if (this.dataset.autoplay === 'true' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) this.timer = window.setInterval(() => this.show(this.index + 1), Number(this.dataset.interval));
      }
      disconnectedCallback() { this.pause(); }
    }
    customElements.define(tag, BluekitesHero{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Bluekites hero slider",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },
    { "type": "select", "id": "desktop_ratio", "label": "Desktop image ratio", "options": [{"value":"3 / 1","label":"Wide (3:1)"},{"value":"16 / 9","label":"Landscape (16:9)"},{"value":"2 / 1","label":"Banner (2:1)"}], "default": "2 / 1" },
    { "type": "select", "id": "mobile_ratio", "label": "Mobile image ratio", "options": [{"value":"1 / 1","label":"Square (1:1)"},{"value":"4 / 5","label":"Portrait (4:5)"},{"value":"3 / 2","label":"Landscape (3:2)"}], "default": "4 / 5" },
    { "type": "checkbox", "id": "show_overlay", "label": "Show text overlays", "default": false },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "autoplay_seconds", "label": "Slide interval", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 5 },
    { "type": "header", "content": "Banner 1" },
    { "type": "image_picker", "id": "banner_1_desktop", "label": "Desktop image" },
    { "type": "image_picker", "id": "banner_1_mobile", "label": "Mobile image (optional)" },
    { "type": "url", "id": "banner_1_link", "label": "Banner link" },
    { "type": "text", "id": "banner_1_heading", "label": "Headline" },
    { "type": "text", "id": "banner_1_subtitle", "label": "Subtitle" },
    { "type": "text", "id": "banner_1_button", "label": "Button text" },
    { "type": "header", "content": "Banner 2" },
    { "type": "image_picker", "id": "banner_2_desktop", "label": "Desktop image" },
    { "type": "image_picker", "id": "banner_2_mobile", "label": "Mobile image (optional)" },
    { "type": "url", "id": "banner_2_link", "label": "Banner link" },
    { "type": "text", "id": "banner_2_heading", "label": "Headline" },
    { "type": "text", "id": "banner_2_subtitle", "label": "Subtitle" },
    { "type": "text", "id": "banner_2_button", "label": "Button text" },
    { "type": "header", "content": "Banner 3" },
    { "type": "image_picker", "id": "banner_3_desktop", "label": "Desktop image" },
    { "type": "image_picker", "id": "banner_3_mobile", "label": "Mobile image (optional)" },
    { "type": "url", "id": "banner_3_link", "label": "Banner link" },
    { "type": "text", "id": "banner_3_heading", "label": "Headline" },
    { "type": "text", "id": "banner_3_subtitle", "label": "Subtitle" },
    { "type": "text", "id": "banner_3_button", "label": "Button text" }
  ],
  "presets": [{ "name": "Bluekites hero slider" }],
  "tag": null,
  "class": "bluekites-hero-slider"
}
{% endschema %}