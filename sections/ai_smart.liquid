{% liquid
  assign product_one = section.settings.product_one
  assign product_two = section.settings.product_two
  assign product_three = section.settings.product_three
  assign visible_products = 0

  if product_one != blank
    assign visible_products = visible_products | plus: 1
  endif
  if product_two != blank
    assign visible_products = visible_products | plus: 1
  endif
  if product_three != blank
    assign visible_products = visible_products | plus: 1
  endif
%}

<section
  id="LastSearched-{{ section.id }}"
  class="bk-last-products color-{{ section.settings.color_scheme }}"
  style="
    --blp-bg: {{ section.settings.background_color }};
    --blp-heading: {{ section.settings.heading_color }};
    --blp-text: {{ section.settings.text_color }};
    --blp-card-bg: {{ section.settings.card_background }};
    --blp-border: {{ section.settings.card_border }};
    --blp-radius: {{ section.settings.card_radius }}px;
    --blp-gap: {{ section.settings.grid_gap }}px;
    --blp-top: {{ section.settings.padding_top }}px;
    --blp-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="bk-last-products__inner">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="bk-last-products__header">
        {% if section.settings.heading != blank %}
          <h2 class="bk-last-products__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="bk-last-products__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
        <span class="bk-last-products__rule" aria-hidden="true"></span>
      </header>
    {% endif %}

    {% if visible_products > 0 %}
      <div class="bk-last-products__grid" role="list" aria-label="{{ section.settings.heading | default: 'Selected products' | escape }}">
        {% for slot in (1..3) %}
          {% liquid
            case slot
              when 1
                assign product_item = product_one
              when 2
                assign product_item = product_two
              when 3
                assign product_item = product_three
            endcase
          %}

          {% if product_item != blank %}
            <article class="bk-last-products__card" role="listitem">
              <a class="bk-last-products__product-link" href="{{ product_item.url }}" aria-label="View {{ product_item.title | escape }}">
                <div class="bk-last-products__media">
                  {% if product_item.featured_media != blank %}
                    {% assign product_alt = product_item.featured_media.alt | default: product_item.title %}
                    {{
                      product_item.featured_media
                      | image_url: width: 700
                      | image_tag:
                        widths: '240, 320, 420, 560, 700',
                        sizes: '(max-width: 549px) 42vw, (max-width: 749px) 38vw, 230px',
                        loading: 'lazy',
                        class: 'bk-last-products__image',
                        alt: product_alt
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'bk-last-products__placeholder' }}
                  {% endif %}
                  {% if product_item.compare_at_price > product_item.price %}
                    <span class="bk-last-products__badge">{{ section.settings.sale_label | escape }}</span>
                  {% endif %}
                </div>
                <div class="bk-last-products__details">
                  <h3 class="bk-last-products__title">{{ product_item.title | escape }}</h3>
                  <div class="bk-last-products__prices">
                    <span class="bk-last-products__price">{{ product_item.price | money }}</span>
                    {% if product_item.compare_at_price > product_item.price %}
                      <s class="bk-last-products__compare-price">{{ product_item.compare_at_price | money }}</s>
                    {% endif %}
                  </div>
                </div>
              </a>
              <a class="bk-last-products__button" href="{{ product_item.url }}">
                {{ section.settings.button_label | escape }}
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M3.75 10h12.5M10 3.75 16.25 10 10 16.25" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="bk-last-products__empty">
        <p>Choose up to three products in this section’s settings to display them here.</p>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .bk-last-products {
    width: 100%;
    padding-block: var(--blp-top) var(--blp-bottom);
    overflow: hidden;
    background: var(--blp-bg);
  }

  .bk-last-products,
  .bk-last-products * {
    box-sizing: border-box;
  }

  /* Match the horizontal gutter used by the other Bluekites homepage sections. */
  .bk-last-products__inner {
    width: calc(100% - 96px);
    max-width: 1640px;
    margin-inline: auto;
  }

  .bk-last-products__header {
    margin: 0 0 20px;
  }

  .bk-last-products__heading {
    margin: 0;
    color: var(--blp-heading);
    font-family: inherit;
    font-size: clamp(25px, 2.2vw, 32px);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .bk-last-products__subheading {
    margin: 6px 0 0;
    color: var(--blp-text);
    font-size: 13px;
    line-height: 1.5;
  }

  .bk-last-products__rule {
    display: block;
    width: 34px;
    height: 2px;
    margin-top: 10px;
    border-radius: 99px;
    background: var(--blp-heading);
    opacity: .65;
  }

  .bk-last-products__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 232px));
    align-items: stretch;
    gap: var(--blp-gap);
  }

  .bk-last-products__card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 9px;
    overflow: hidden;
    border: 1px solid var(--blp-border);
    border-radius: var(--blp-radius);
    background: var(--blp-card-bg);
    box-shadow: 0 3px 12px rgb(35 25 27 / 4%);
    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }

  .bk-last-products__card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--blp-heading) 30%, var(--blp-border));
    box-shadow: 0 9px 22px rgb(35 25 27 / 8%);
  }

  .bk-last-products__product-link {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .bk-last-products__product-link:focus-visible,
  .bk-last-products__button:focus-visible {
    outline: 2px solid var(--blp-heading);
    outline-offset: 3px;
  }

  .bk-last-products__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1.08 / 1;
    overflow: hidden;
    border-radius: max(3px, calc(var(--blp-radius) - 5px));
    background: #f5f4f2;
  }

  .bk-last-products__image,
  .bk-last-products__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform .3s ease;
  }

  .bk-last-products__card:hover .bk-last-products__image {
    transform: scale(1.035);
  }

  .bk-last-products__badge {
    position: absolute;
    top: 7px;
    right: 7px;
    padding: 4px 7px;
    border-radius: 4px;
    background: var(--blp-heading);
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.1;
  }

  .bk-last-products__details {
    display: grid;
    gap: 6px;
    padding: 10px 2px 11px;
  }

  .bk-last-products__title {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--blp-heading);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -.01em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .bk-last-products__prices {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
  }

  .bk-last-products__price {
    color: var(--blp-heading);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
  }

  .bk-last-products__compare-price {
    color: var(--blp-text);
    font-size: 11px;
    opacity: .65;
  }

  .bk-last-products__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 35px;
    width: 100%;
    margin-top: auto;
    padding: 8px 10px;
    border: 1px solid var(--blp-heading);
    border-radius: max(3px, calc(var(--blp-radius) - 5px));
    background: var(--blp-heading);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition: background .2s ease, color .2s ease;
  }

  .bk-last-products__button:hover {
    background: transparent;
    color: var(--blp-heading);
  }

  .bk-last-products__button svg {
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
  }

  .bk-last-products__empty {
    max-width: 700px;
    padding: 18px 20px;
    border: 1px dashed var(--blp-border);
    border-radius: var(--blp-radius);
    color: var(--blp-text);
    font-size: 13px;
  }

  .bk-last-products__empty p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .bk-last-products__inner {
      width: calc(100% - 48px);
    }

    .bk-last-products__header {
      margin-bottom: 15px;
    }

    .bk-last-products__heading {
      font-size: clamp(23px, 5.8vw, 28px);
    }

    .bk-last-products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 9px;
    }

    .bk-last-products__card {
      padding: 6px;
      border-radius: max(6px, calc(var(--blp-radius) - 2px));
    }

    .bk-last-products__media {
      aspect-ratio: .82 / 1;
    }

    .bk-last-products__details {
      gap: 5px;
      padding: 8px 1px;
    }

    .bk-last-products__title {
      font-size: 11px;
      line-height: 1.35;
    }

    .bk-last-products__price {
      font-size: 11px;
    }

    .bk-last-products__compare-price {
      font-size: 9px;
    }

    .bk-last-products__button {
      min-height: 31px;
      gap: 4px;
      padding: 6px 3px;
      font-size: 10px;
    }

    .bk-last-products__button svg {
      width: 12px;
      height: 12px;
    }

    .bk-last-products__badge {
      top: 4px;
      right: 4px;
      padding: 3px 4px;
      font-size: 8px;
    }
  }

  @media screen and (max-width: 390px) {
    .bk-last-products__inner {
      width: calc(100% - 32px);
    }

    .bk-last-products__grid {
      gap: 6px;
    }

    .bk-last-products__card {
      padding: 5px;
    }

    .bk-last-products__title {
      font-size: 10px;
    }

    .bk-last-products__button {
      font-size: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bk-last-products__card,
    .bk-last-products__image,
    .bk-last-products__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Last searched products",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Last Searched Product"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pick up where you left off."
    },
    {
      "type": "product",
      "id": "product_one",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_two",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_three",
      "label": "Product 3"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "text",
      "id": "sale_label",
      "label": "Sale badge label",
      "default": "Sale"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FCFBFA"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading and price color",
      "default": "#3A1E25"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Supporting text color",
      "default": "#5C454A"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Product card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Product card border",
      "default": "#DCCBCD"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Space between cards",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Last searched products"
    }
  ]
}
{% endschema %}
