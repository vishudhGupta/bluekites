{%- doc -%}
  Renders the "Add location" storefront preference control inside the header menu.
  This only saves a location preference in the browser. It does not check delivery
  availability and does not change checkout shipping addresses.

  @param {object} block - The header menu block (settings are read from it)
  @param {object} section - The parent section
  @param {string} [variant] - 'desktop' (default) or 'mobile'
{%- enddoc -%}

{%- liquid
  assign bs = block.settings
  assign loc_variant = variant | default: 'desktop'
  assign uid = section.id | append: '-' | append: loc_variant
  assign loc_heading = bs.location_heading | default: 'Choose your location'
  assign loc_helper = bs.location_helper_text | default: 'Save a location preference for your storefront experience. This does not check delivery availability or change your checkout shipping address.'
  assign loc_field_label = bs.location_field_label | default: 'City or area'
  assign loc_placeholder = bs.location_placeholder | default: 'Enter a city or area'
  assign loc_confirm = bs.location_confirm_label | default: 'Confirm location'
  assign loc_empty = bs.location_empty_label | default: 'Add location'
  assign loc_suggestions = bs.location_suggestions | split: ','
-%}

<div
  class="loc-pref loc-pref--{{ loc_variant }}"
  data-empty-label="{{ loc_empty | escape }}"
  data-saved-prefix="Location preference saved: "
>
  <button
    class="loc-pref__trigger"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="loc-pref-panel-{{ uid }}"
  >
    <svg class="loc-pref__pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
    <span class="loc-pref__text">
      <span class="loc-pref__eyebrow">Deliver to</span>
      <span class="loc-pref__value">{{ loc_empty | escape }}</span>
    </span>
    <svg class="loc-pref__chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 4 4 4 4-4"/></svg>
  </button>

  <div class="loc-pref__scrim" hidden></div>

  <div
    id="loc-pref-panel-{{ uid }}"
    class="loc-pref__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="loc-pref-heading-{{ uid }}"
    hidden
  >
    <button class="loc-pref__close" type="button" aria-label="Close location dialog">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m18 6-12 12M6 6l12 12"/></svg>
    </button>
    <h2 id="loc-pref-heading-{{ uid }}" class="loc-pref__heading">{{ loc_heading | escape }}</h2>
    <p class="loc-pref__note">{{ loc_helper | escape }}</p>

    <form class="loc-pref__form">
      <label class="loc-pref__label" for="loc-pref-input-{{ uid }}">{{ loc_field_label | escape }}</label>
      <input
        id="loc-pref-input-{{ uid }}"
        class="loc-pref__input"
        type="text"
        name="location"
        maxlength="100"
        autocomplete="address-level2"
        placeholder="{{ loc_placeholder | escape }}"
        required
      >

      {%- if bs.location_suggestions != blank -%}
        <ul class="loc-pref__chips" role="list" aria-label="Suggested locations">
          {%- for item in loc_suggestions -%}
            {%- assign chip = item | strip -%}
            {%- if chip != blank -%}
              <li><button class="loc-pref__chip" type="button" data-location="{{ chip | escape }}">{{ chip | escape }}</button></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <button class="loc-pref__submit" type="submit">{{ loc_confirm | escape }}</button>
    </form>
  </div>

  <span class="visually-hidden loc-pref__live" aria-live="polite" aria-atomic="true"></span>
</div>

{% stylesheet %}
  .loc-pref {
    display: block;
    position: relative;
    flex: 0 0 auto;
    width: max-content;
    max-width: 100%;
    font-family: inherit;
    pointer-events: auto;
  }

  .loc-pref__trigger {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 6px 14px 6px 12px;
    border: 1px solid #000000;
    border-radius: 100px;
    background: #000000;
    color: #ffffff;
    font: inherit;
    font-size: 14px;
    text-align: start;
    white-space: nowrap;
    cursor: pointer;
    pointer-events: auto;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .loc-pref__trigger:hover {
    border-color: currentColor;
  }

  .loc-pref__trigger[aria-expanded='true'] .loc-pref__chevron {
    transform: rotate(180deg);
  }

  .loc-pref__trigger:focus-visible,
  .loc-pref__panel button:focus-visible,
  .loc-pref__panel input:focus-visible {
    outline: 2px solid #000000;
    outline-offset: 3px;
  }

  .loc-pref__pin {
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
  }

  .loc-pref__text {
    display: grid;
    line-height: 1.15;
  }

  .loc-pref__eyebrow {
    font-size: 11px;
    opacity: 0.65;
  }

  .loc-pref__value {
    max-width: 140px;
    overflow: hidden;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .loc-pref__chevron {
    width: 12px;
    height: 12px;
    flex: 0 0 auto;
    transition: transform 0.2s ease;
  }

  /* Dark header: transparent pill that follows the menu text colour */
  .loc-pref--desktop .loc-pref__trigger {
    background: transparent;
    color: var(--menu-top-level-font-color, #ffffff);
    border-color: color-mix(in srgb, currentColor 40%, transparent);
  }

  .loc-pref--desktop .loc-pref__trigger:hover,
  .loc-pref--desktop .loc-pref__trigger[aria-expanded='true'] {
    background: color-mix(in srgb, currentColor 12%, transparent);
    border-color: currentColor;
  }

  .loc-pref--desktop .loc-pref__trigger:focus-visible {
    outline-color: currentColor;
  }

  .loc-pref--desktop .loc-pref__eyebrow {
    display: none;
  }

  .loc-pref--desktop .loc-pref__value {
    max-width: 84px;
    font-size: 13px;
    font-weight: 500;
  }

  /* Compact size so it never crowds the search / account / cart icons */
  .loc-pref--desktop .loc-pref__trigger {
    gap: 6px;
    min-height: 34px;
    padding: 4px 10px 4px 8px;
  }

  .loc-pref--desktop .loc-pref__pin {
    width: 16px;
    height: 16px;
  }

  .loc-pref--desktop .loc-pref__chevron {
    width: 9px;
    height: 9px;
  }

  .loc-pref--mobile {
    margin-inline-start: 8px;
    min-width: 0;
  }

  .loc-pref--mobile .loc-pref__trigger {
    gap: 6px;
    padding: 6px 10px;
    background: transparent;
    color: var(--color-foreground, currentColor);
    border-color: color-mix(in srgb, currentColor 40%, transparent);
  }

  .loc-pref--mobile .loc-pref__eyebrow,
  .loc-pref--mobile .loc-pref__chevron {
    display: none;
  }

  .loc-pref--mobile .loc-pref__value {
    max-width: 96px;
    font-size: 13px;
  }

  /* Popup. It is moved to <body> while open so the header can never clip or cover it. */
  .loc-pref__panel {
    --loc-fg: #000000;
    --loc-bg: #ffffff;
    --loc-accent: #c3cca6;
    --loc-accent-hover: #b5c095;

    position: fixed;
    z-index: 100001;
    box-sizing: border-box;
    width: min(380px, calc(100vw - 32px));
    padding: 24px;
    border: 1px solid #e6e6e6;
    border-radius: 12px;
    background: var(--loc-bg);
    color: var(--loc-fg);
    font-family: inherit;
    text-align: start;
    box-shadow: 0 12px 36px rgb(0 0 0 / 0.25);
    animation: loc-pref-pop 0.18s ease-out;
  }

  .loc-pref__panel[hidden],
  .loc-pref__scrim[hidden] {
    display: none !important;
  }

  .loc-pref__scrim {
    position: fixed;
    inset: 0;
    z-index: 100000;
    background: rgb(0 0 0 / 0.35);
  }

  .loc-pref__heading {
    margin: 0 36px 6px 0;
    font-size: 20px;
    line-height: 1.3;
    color: var(--loc-fg);
  }

  .loc-pref__note {
    margin: 0 0 18px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--loc-fg);
    opacity: 0.8;
  }

  .loc-pref__close {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--loc-fg);
    cursor: pointer;
  }

  .loc-pref__close:hover {
    background: rgb(0 0 0 / 0.06);
  }

  .loc-pref__close svg {
    width: 18px;
    height: 18px;
  }

  .loc-pref__label {
    display: block;
    margin-bottom: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--loc-fg);
  }

  .loc-pref__input {
    box-sizing: border-box;
    width: 100%;
    min-height: 46px;
    padding: 10px 12px;
    border: 1px solid #767676;
    border-radius: 8px;
    background: var(--loc-bg);
    color: var(--loc-fg);
    font: inherit;
    font-size: 16px;
  }

  .loc-pref__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .loc-pref__chip {
    min-height: 36px;
    padding: 6px 14px;
    border: 1px solid rgb(0 0 0 / 0.2);
    border-radius: 100px;
    background: transparent;
    color: var(--loc-fg);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .loc-pref__chip:hover {
    border-color: var(--loc-fg);
    background: rgb(195 204 166 / 0.35);
  }

  .loc-pref__submit {
    width: 100%;
    min-height: 46px;
    margin-top: 16px;
    padding: 10px 16px;
    border: 1px solid var(--loc-fg);
    border-radius: 100px;
    background: var(--loc-accent);
    color: #000000;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .loc-pref__submit:hover {
    background: var(--loc-accent-hover);
  }

  @media screen and (max-width: 749px) {
    .loc-pref__panel {
      top: auto !important;
      right: 12px !important;
      bottom: 12px !important;
      left: 12px !important;
      width: auto;
      max-height: calc(100dvh - 24px);
      overflow-y: auto;
      animation: loc-pref-sheet 0.22s ease-out;
    }
  }

  @keyframes loc-pref-pop {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes loc-pref-sheet {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .loc-pref__panel { animation: none; }
    .loc-pref__chevron,
    .loc-pref__trigger { transition: none; }
  }
{% endstylesheet %}

<script>
  (function () {
    if (window.__locPrefReady) return;
    window.__locPrefReady = true;

    var KEY = 'ai-location-preference';
    var active = null; // the .loc-pref root whose popup is open

    function readSaved() {
      try { return localStorage.getItem(KEY) || ''; } catch (e) { return ''; }
    }

    function parts(root) {
      return {
        trigger: root.querySelector('.loc-pref__trigger'),
        panel: root.__panel || root.querySelector('.loc-pref__panel'),
        scrim: root.__scrim || root.querySelector('.loc-pref__scrim'),
        input: (root.__panel || root).querySelector('.loc-pref__input'),
        value: root.querySelector('.loc-pref__value'),
        live: root.querySelector('.loc-pref__live')
      };
    }

    function render(root, location) {
      var p = parts(root);
      var empty = root.getAttribute('data-empty-label') || 'Add location';
      if (p.value) {
        p.value.textContent = location || empty;
        p.value.title = location || '';
      }
      if (p.input) p.input.value = location || '';
    }

    function renderAll() {
      var saved = readSaved();
      document.querySelectorAll('.loc-pref').forEach(function (root) { render(root, saved); });
    }

    function position(root) {
      var p = parts(root);
      if (window.innerWidth < 750) {
        p.panel.style.top = p.panel.style.left = p.panel.style.right = '';
        return;
      }
      var r = p.trigger.getBoundingClientRect();
      var width = Math.min(380, window.innerWidth - 32);
      var left = Math.max(16, Math.min(r.right - width, window.innerWidth - width - 16));
      p.panel.style.top = Math.round(r.bottom + 12) + 'px';
      p.panel.style.left = Math.round(left) + 'px';
      p.panel.style.right = 'auto';
    }

    function open(root) {
      if (active && active !== root) close(active, false);
      var p = parts(root);
      root.__panel = p.panel;
      root.__scrim = p.scrim;
      document.body.appendChild(p.scrim); // lift above the header
      document.body.appendChild(p.panel);
      p.scrim.hidden = false;
      p.panel.hidden = false;
      p.trigger.setAttribute('aria-expanded', 'true');
      active = root;
      render(root, readSaved());
      position(root);
      p.input.focus();
      p.input.select();
    }

    function close(root, restoreFocus) {
      if (!root) return;
      var p = parts(root);
      p.panel.hidden = true;
      p.scrim.hidden = true;
      p.trigger.setAttribute('aria-expanded', 'false');
      if (root.isConnected) {
        root.appendChild(p.scrim);
        root.appendChild(p.panel);
      } else {
        p.panel.remove();
        p.scrim.remove();
      }
      root.__panel = root.__scrim = null;
      if (active === root) active = null;
      if (restoreFocus && p.trigger) p.trigger.focus();
    }

    function confirm(root, raw) {
      var location = (raw || '').trim();
      var p = parts(root);
      if (!location) { p.input.focus(); return; }
      try { localStorage.setItem(KEY, location); } catch (e) {}
      renderAll();
      if (p.live) p.live.textContent = (root.getAttribute('data-saved-prefix') || '') + location;
      close(root, true);
    }

    // Capture phase so nothing in the header can swallow the click.
    document.addEventListener('click', function (event) {
      var target = event.target;
      if (!(target instanceof Element)) return;

      var trigger = target.closest('.loc-pref__trigger');
      if (trigger) {
        var root = trigger.closest('.loc-pref');
        if (active === root) close(root, true); else open(root);
        return;
      }

      if (!active) return;

      if (target.closest('.loc-pref__close') || target.closest('.loc-pref__scrim')) {
        close(active, true);
        return;
      }

      var chip = target.closest('.loc-pref__chip');
      if (chip) {
        confirm(active, chip.getAttribute('data-location'));
        return;
      }

      if (!target.closest('.loc-pref__panel')) close(active, false);
    }, true);

    document.addEventListener('submit', function (event) {
      var form = event.target;
      if (!(form instanceof Element) || !form.classList.contains('loc-pref__form') || !active) return;
      event.preventDefault();
      confirm(active, form.querySelector('.loc-pref__input').value);
    }, true);

    document.addEventListener('keydown', function (event) {
      if (!active) return;
      var panel = parts(active).panel;
      if (event.key === 'Escape') {
        event.stopPropagation();
        close(active, true);
        return;
      }
      if (event.key !== 'Tab') return;
      var focusable = Array.prototype.slice.call(panel.querySelectorAll('button, input')).filter(function (el) { return !el.disabled; });
      if (!focusable.length) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    }, true);

    window.addEventListener('resize', function () { if (active) position(active); });
    window.addEventListener('scroll', function () { if (active) position(active); }, { passive: true });

    renderAll();
    document.addEventListener('DOMContentLoaded', renderAll);
    document.addEventListener('shopify:section:load', renderAll);
    window.addEventListener('pageshow', renderAll);
  })();
</script>
