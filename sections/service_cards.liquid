<section
	id="ServiceCards-{{ section.id }}"
	class="bk-service-cards color-{{ section.settings.color_scheme }}"
	style="
		--bk-sc-bg: {{ section.settings.section_background }};
		--bk-sc-heading: {{ section.settings.heading_color }};
		--bk-sc-text: {{ section.settings.text_color }};
		--bk-sc-card-bg: {{ section.settings.card_background }};
		--bk-sc-card-border: {{ section.settings.card_border }};
		--bk-sc-gap: {{ section.settings.grid_gap }}px;
		--bk-sc-radius: {{ section.settings.card_radius }}px;
		--bk-sc-padding-top: {{ section.settings.padding_top }}px;
		--bk-sc-padding-bottom: {{ section.settings.padding_bottom }}px;
		--bk-sc-columns: {{ section.settings.columns_desktop }};
	"
>
	<div class="bk-service-cards__inner page-width-normal">
		{% if section.settings.subheading != blank or section.settings.heading != blank or section.settings.description != blank %}
			<header class="bk-service-cards__header">
				{% if section.settings.subheading != blank %}
					<p class="bk-service-cards__subheading">{{ section.settings.subheading }}</p>
				{% endif %}

				{% if section.settings.heading != blank %}
					<h2 class="bk-service-cards__heading">{{ section.settings.heading }}</h2>
				{% endif %}

				{% if section.settings.description != blank %}
					<p class="bk-service-cards__description">{{ section.settings.description }}</p>
				{% endif %}
			</header>
		{% endif %}

		{% if section.blocks.size > 0 %}
			<div class="bk-service-cards__grid" role="list">
				{% for block in section.blocks %}
					{% if block.type == 'service_card' %}
						{% assign card_link = block.settings.custom_url %}
						{% if card_link == blank and block.settings.link_page != blank %}
							{% assign card_link = block.settings.link_page.url %}
						{% endif %}

						<article class="bk-service-cards__card" role="listitem" {{ block.shopify_attributes }}>
							{% if card_link != blank %}
								<a class="bk-service-cards__card-link" href="{{ card_link }}">
							{% else %}
								<div class="bk-service-cards__card-link">
							{% endif %}

								<div class="bk-service-cards__media">
									{% if block.settings.image != blank %}
										{{
											block.settings.image
											| image_url: width: 480
											| image_tag:
												widths: '200, 320, 400, 480',
												sizes: '(max-width: 749px) 46vw, (max-width: 1099px) 30vw, 16vw',
												loading: 'lazy',
												class: 'bk-service-cards__image',
												alt: block.settings.title
										}}
									{% else %}
										<div class="bk-service-cards__image bk-service-cards__image--placeholder" aria-hidden="true"></div>
									{% endif %}
								</div>

								<div class="bk-service-cards__content">
									{% if block.settings.title != blank %}
										<h3 class="bk-service-cards__title">{{ block.settings.title }}</h3>
									{% endif %}

									{% if section.settings.show_description and block.settings.description != blank %}
										<p class="bk-service-cards__text">{{ block.settings.description }}</p>
									{% endif %}

									{% if card_link != blank and block.settings.button_label != blank %}
										<span class="bk-service-cards__button">{{ block.settings.button_label }}</span>
									{% endif %}
								</div>

							{% if card_link != blank %}
								</a>
							{% else %}
								</div>
							{% endif %}
						</article>
					{% endif %}
				{% endfor %}
			</div>
		{% else %}
			<p class="bk-service-cards__empty">Add Service card blocks to show your services.</p>
		{% endif %}
	</div>
</section>

{% stylesheet %}
	.bk-service-cards {
		background: var(--bk-sc-bg);
		padding-top: var(--bk-sc-padding-top);
		padding-bottom: var(--bk-sc-padding-bottom);
		/* 60vh viewport height. min-height (not fixed height) so content is never clipped on small screens. */
		min-height: 60vh;
		min-height: 60svh;
		display: flex;
		align-items: center;
		box-sizing: border-box;
	}

	.bk-service-cards__inner {
		--bk-sc-inline-space: 16px;
		width: min(var(--narrow-page-width), calc(100% - (var(--bk-sc-inline-space) * 2)));
		margin-inline: auto;
	}

	@media screen and (min-width: 750px) {
		.bk-service-cards__inner {
			--bk-sc-inline-space: 36px;
		}
	}

	.bk-service-cards__header {
		margin-bottom: 1.1rem;
	}

	.bk-service-cards__subheading {
		margin: 0;
		font-size: 0.7rem;
		line-height: 1;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--bk-sc-text);
		font-weight: 600;
	}

	.bk-service-cards__heading {
		margin: 0.5rem 0 0;
		color: var(--bk-sc-heading);
		font-size: clamp(1.5rem, 2.4vw, 2.4rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.bk-service-cards__description {
		margin: 0.55rem 0 0;
		color: var(--bk-sc-text);
		font-size: 0.92rem;
		line-height: 1.45;
		max-width: 64ch;
	}

	.bk-service-cards__grid {
		display: grid;
		grid-template-columns: repeat(var(--bk-sc-columns, 6), minmax(0, 1fr));
		gap: var(--bk-sc-gap);
	}

	.bk-service-cards__card {
		background: var(--bk-sc-card-bg);
		border: 1px solid var(--bk-sc-card-border);
		border-radius: var(--bk-sc-radius);
		overflow: hidden;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.bk-service-cards__card:hover,
	.bk-service-cards__card:focus-within {
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
	}

	.bk-service-cards__card-link {
		display: grid;
		grid-template-rows: auto 1fr;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.bk-service-cards__card-link:focus-visible {
		outline: 2px solid var(--bk-sc-heading);
		outline-offset: -2px;
	}

	.bk-service-cards__media {
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.bk-service-cards__image {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
	}

	.bk-service-cards__image--placeholder {
		background: linear-gradient(140deg, #d7dce6 0%, #b4bfce 100%);
	}

	.bk-service-cards__content {
		padding: 0.6rem 0.65rem 0.7rem;
		display: grid;
		gap: 0.4rem;
		align-content: start;
	}

	.bk-service-cards__title {
		margin: 0;
		color: var(--bk-sc-heading);
		font-size: 0.88rem;
		line-height: 1.25;
	}

	.bk-service-cards__text {
		margin: 0;
		color: var(--bk-sc-text);
		font-size: 0.78rem;
		line-height: 1.35;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.bk-service-cards__button {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		margin-top: 0.1rem;
		font-size: 0.72rem;
		line-height: 1;
		font-weight: 600;
		padding: 0.45rem 0.7rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--bk-sc-heading) 10%, transparent);
		color: var(--bk-sc-heading);
	}

	.bk-service-cards__empty {
		margin: 0;
		color: var(--bk-sc-text);
		font-size: 0.96rem;
	}

	/* Tablet */
	@media screen and (max-width: 1099px) {
		.bk-service-cards__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	/* Mobile */
	@media screen and (max-width: 749px) {
		.bk-service-cards__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.65rem;
		}

		.bk-service-cards__description {
			font-size: 0.88rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.bk-service-cards__card {
			transition: none;
		}

		.bk-service-cards__card:hover,
		.bk-service-cards__card:focus-within {
			transform: none;
		}
	}
{% endstylesheet %}

{% schema %}
{
	"name": "Service cards",
	"tag": "section",
	"class": "section-wrapper",
	"settings": [
		{
			"type": "text",
			"id": "subheading",
			"label": "Subheading",
			"default": "Our Services"
		},
		{
			"type": "text",
			"id": "heading",
			"label": "Heading",
			"default": "What We Can Help You With"
		},
		{
			"type": "textarea",
			"id": "description",
			"label": "Description",
			"default": "Create cards with an image and link each service to a specific page."
		},
		{
			"type": "range",
			"id": "columns_desktop",
			"label": "Desktop columns",
			"min": 3,
			"max": 8,
			"step": 1,
			"default": 6
		},
		{
			"type": "checkbox",
			"id": "show_description",
			"label": "Show card descriptions",
			"default": false
		},
		{
			"type": "range",
			"id": "grid_gap",
			"label": "Grid gap",
			"min": 8,
			"max": 32,
			"step": 2,
			"unit": "px",
			"default": 12
		},
		{
			"type": "range",
			"id": "card_radius",
			"label": "Card radius",
			"min": 0,
			"max": 28,
			"step": 1,
			"unit": "px",
			"default": 10
		},
		{
			"type": "range",
			"id": "padding_top",
			"label": "Top padding",
			"min": 0,
			"max": 120,
			"step": 4,
			"unit": "px",
			"default": 32
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"label": "Bottom padding",
			"min": 0,
			"max": 120,
			"step": 4,
			"unit": "px",
			"default": 32
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme",
			"default": "scheme-1"
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "color",
			"id": "section_background",
			"label": "Section background",
			"default": "#F8F7F4"
		},
		{
			"type": "color",
			"id": "heading_color",
			"label": "Heading and title color",
			"default": "#1C2740"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Text color",
			"default": "#5C6478"
		},
		{
			"type": "color",
			"id": "card_background",
			"label": "Card background",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "card_border",
			"label": "Card border",
			"default": "#E5E8EE"
		}
	],
	"blocks": [
		{
			"type": "service_card",
			"name": "Service card",
			"settings": [
				{
					"type": "image_picker",
					"id": "image",
					"label": "Image"
				},
				{
					"type": "text",
					"id": "title",
					"label": "Title",
					"default": "Service title"
				},
				{
					"type": "textarea",
					"id": "description",
					"label": "Description",
					"default": "Short service description goes here."
				},
				{
					"type": "page",
					"id": "link_page",
					"label": "Link to page"
				},
				{
					"type": "url",
					"id": "custom_url",
					"label": "Custom URL (optional override)",
					"info": "If provided, this URL is used instead of the page link."
				},
				{
					"type": "text",
					"id": "button_label",
					"label": "Button label",
					"default": "Explore service"
				}
			]
		}
	],
	"max_blocks": 24,
	"presets": [
		{
			"name": "Service cards",
			"blocks": [
				{ "type": "service_card" },
				{ "type": "service_card" },
				{ "type": "service_card" },
				{ "type": "service_card" },
				{ "type": "service_card" },
				{ "type": "service_card" }
			]
		}
	]
}
{% endschema %}
