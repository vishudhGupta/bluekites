        "custom_liquid": "<!-- ============================================================\n  Services grid: plain HTML + CSS (no Liquid)\n  Paste this whole file into a Custom Liquid section.\n  - Change colors / sizes in the \":root-like\" block at the top of the <style> (.bk-svc).\n  - Duplicate or delete any <li class=\"bk-svc__item\"> to add or remove cards.\n  - Replace the placeholder <div class=\"bk-svc__ph\"> with <img class=\"bk-svc__img\" src=\"YOUR-IMAGE-URL\" alt=\"...\" loading=\"lazy\" width=\"800\" height=\"800\">\n============================================================ -->\n\n<style>\n.bk-svc {\n  /* ---- Edit these ---- */\n  --svc-page-bg: #ffffff;\n  --svc-bar: #800000;\n  --svc-bar-text: #ffffff;\n  --svc-body: #eef4fb;\n  --svc-card: #ffffff;\n  --svc-title: #111111;\n  --svc-text: #6b7280;\n  --svc-btn: #13294b;\n  --svc-cols: 6;\n  --svc-top: 24px;\n  --svc-bottom: 24px;\n  --svc-max: 1440px;      /* same width as Featured Products */\n  --svc-gutter: 32px;     /* total side space on screens narrower than max */\n  --svc-ratio: 1 / 1;\n\n  background: var(--svc-page-bg);\n  padding-block: var(--svc-top) var(--svc-bottom);\n}\n.bk-svc *,\n.bk-svc *::before,\n.bk-svc *::after { box-sizing: border-box; }\n\n/* Panel */\n.bk-svc__panel {\n  width: min(calc(100% - var(--svc-gutter)), var(--svc-max));\n  margin-inline: auto;\n  border-radius: 12px;\n  overflow: hidden;\n  background: var(--svc-body);\n}\n\n/* Header bar */\n.bk-svc__bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 14px 20px 12px;\n  background: var(--svc-bar);\n  color: var(--svc-bar-text);\n}\n.bk-svc__bar-text { min-width: 0; }\n.bk-svc__heading {\n  margin: 0;\n  color: var(--svc-bar-text);\n  font-family: inherit;\n  font-weight: bold;\n  font-size: clamp(20px, 2vw, 28px);\n  line-height: 1.2;\n}\n.bk-svc__sub {\n  margin: 2px 0 0;\n  font-size: 13px;\n  line-height: 1.4;\n  opacity: .95;\n}\n/* Body + grid */\n.bk-svc__body { padding: 16px; }\n.bk-svc__grid {\n  display: grid;\n  grid-template-columns: repeat(var(--svc-cols, 6), minmax(0, 1fr));\n  gap: 8px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n.bk-svc__item { min-width: 0; margin: 0; padding: 0; }\n\n/* Card */\n.bk-svc__card {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  padding: 6px;\n  background: var(--svc-card);\n  border-radius: 6px;\n  box-shadow: 0 1px 2px rgba(16, 24, 40, .06);\n  transition: transform .25s ease, box-shadow .25s ease;\n}\n.bk-svc__card:hover {\n  transform: translateY(-3px);\n  box-shadow: 0 12px 28px -12px rgba(16, 24, 40, .28);\n}\n\n.bk-svc__media {\n  position: relative;\n  display: grid;\n  place-items: center;\n  aspect-ratio: var(--svc-ratio, 1 / 1);\n  overflow: hidden;\n  background: #f3f4f6;\n  border-radius: 4px;\n}\n.bk-svc__img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform .5s ease;\n}\n.bk-svc__card:hover .bk-svc__img { transform: scale(1.06); }\n\n/* Placeholder (remove once you add real images) */\n.bk-svc__ph {\n  display: grid;\n  place-items: center;\n  width: 100%;\n  height: 100%;\n  color: #9ca3af;\n}\n.bk-svc__ph svg { width: 36%; height: auto; opacity: .55; }\n\n.bk-svc__badge {\n  position: absolute;\n  top: 6px;\n  right: 6px;\n  z-index: 1;\n  padding: 2px 6px;\n  font-size: 9px;\n  font-weight: 600;\n  color: #fff;\n  background: #2b2b2b;\n  border-radius: 4px;\n}\n\n.bk-svc__content {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  gap: 4px;\n  padding: 8px 2px 2px;\n}\n.bk-svc__title {\n  margin: 0;\n  color: var(--svc-title);\n  font-family: inherit;\n  font-size: 13px;\n  font-weight: 700;\n  line-height: 1.35;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n.bk-svc__title-link { color: inherit; text-decoration: none; }\n.bk-svc__title-link::after { content: \"\"; position: absolute; inset: 0; z-index: 2; }\n.bk-svc__title-link:focus-visible { outline: none; }\n.bk-svc__card:has(.bk-svc__title-link:focus-visible) { outline: 2px solid var(--svc-btn); outline-offset: 2px; }\n\n.bk-svc__text {\n  margin: 0;\n  color: var(--svc-text);\n  font-size: 11px;\n  line-height: 1.45;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n/* Glassmorphism maroon button */\n.bk-svc__btn {\n  --glass-maroon: 128, 0, 0;\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 32px;\n  margin-top: auto;\n  padding: 0 10px;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: .02em;\n  color: #fff;\n  text-shadow: 0 1px 2px rgba(0, 0, 0, .45);\n  background: linear-gradient(135deg, rgba(var(--glass-maroon), .92) 0%, rgba(var(--glass-maroon), .78) 100%);\n  -webkit-backdrop-filter: blur(10px) saturate(160%);\n  backdrop-filter: blur(10px) saturate(160%);\n  border: 1px solid rgba(255, 255, 255, .35);\n  border-radius: 6px;\n  box-shadow: 0 4px 14px rgba(var(--glass-maroon), .35), inset 0 1px 0 rgba(255, 255, 255, .35);\n  transition: transform .2s ease, box-shadow .2s ease, background .2s ease;\n}\n.bk-svc__content > .bk-svc__btn { margin-top: auto; }\n.bk-svc__content > :nth-last-child(2) { margin-bottom: 6px; }\n.bk-svc__card:hover .bk-svc__btn {\n  background: linear-gradient(135deg, rgba(var(--glass-maroon), 1) 0%, rgba(var(--glass-maroon), .88) 100%);\n  box-shadow: 0 6px 18px rgba(var(--glass-maroon), .5), inset 0 1px 0 rgba(255, 255, 255, .45);\n  transform: translateY(-1px);\n}\n\n/* Contact / CTA tile */\n.bk-svc__card--cta .bk-svc__media { background: color-mix(in srgb, var(--svc-bar) 10%, #fff); }\n.bk-svc__cta-icon { display: grid; place-items: center; width: 44%; color: var(--svc-bar); }\n.bk-svc__cta-icon svg { width: 100%; height: auto; }\n\n/* Medium devices (tablets): 3 columns */\n@media screen and (max-width: 1099px) {\n  .bk-svc__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }\n  .bk-svc__body { padding: 12px; }\n  .bk-svc__title { font-size: 14px; }\n  .bk-svc__text { font-size: 12px; }\n}\n\n/* Small devices (phones): 2 columns */\n@media screen and (max-width: 749px) {\n  .bk-svc { padding-block: calc(var(--svc-top) * .6) calc(var(--svc-bottom) * .6); }\n  .bk-svc__panel { width: calc(100% - 24px); }\n  .bk-svc__bar { padding: 10px 12px 8px; }\n  .bk-svc__heading { font-size: 18px; }\n  .bk-svc__sub { font-size: 11px; }\n  .bk-svc__body { padding: 8px; }\n  .bk-svc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }\n  .bk-svc__card { padding: 5px; }\n  .bk-svc__content { padding: 7px 2px 2px; }\n  .bk-svc__title { font-size: 13px; }\n  .bk-svc__text { font-size: 11px; }\n  .bk-svc__btn { min-height: 36px; font-size: 12px; }\n}\n\n/* Very small phones */\n@media screen and (max-width: 359px) {\n  .bk-svc__panel { width: calc(100% - 16px); }\n  .bk-svc__grid { gap: 6px; }\n  .bk-svc__title { font-size: 12px; }\n  .bk-svc__text { font-size: 10.5px; }\n}\n\n/* Touch devices: skip hover lift */\n@media (hover: none) {\n  .bk-svc__card:hover { transform: none; }\n  .bk-svc__card:hover .bk-svc__img { transform: none; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .bk-svc__card, .bk-svc__img, .bk-svc__btn { transition: none !important; }\n}\n</style>\n\n<section class=\"bk-svc\" aria-labelledby=\"bk-svc-heading\">\n  <div class=\"bk-svc__panel\">\n\n    <header class=\"bk-svc__bar\">\n      <div class=\"bk-svc__bar-text\">\n        <h2 class=\"bk-svc__heading\" id=\"bk-svc-heading\">Categories</h2>\n        <p class=\"bk-svc__sub\">Everything we offer, all in one place</p>\n      </div>\n    </header>\n\n    <div class=\"bk-svc__body\">\n      <ul class=\"bk-svc__grid\" role=\"list\">\n\n        <!-- Card 1 -->\n        <li class=\"bk-svc__item\">\n          <article class=\"bk-svc__card\">\n            <div class=\"bk-svc__media\">\n              <!-- Replace the placeholder below with: <img class=\"bk-svc__img\" src=\"IMAGE-URL\" alt=\"Service title\" loading=\"lazy\" width=\"800\" height=\"800\"> -->\n              <img class=\"bk-svc__img\" src=\"https://images.unsplash.com/photo-1766325693394-138c599bd739?auto=format&fit=crop&w=800&q=85\" alt=\"Surgical instruments and medical equipment\" loading=\"lazy\" width=\"800\" height=\"800\">\n            </div>\n            <div class=\"bk-svc__content\">\n              <h3 class=\"bk-svc__title\"><a href=\"https://bluekitesglobal.com/collections/surgical-products\" class=\"bk-svc__title-link\">Surgical Products</a></h3>\n              <p class=\"bk-svc__text\">Quality instruments and supplies for clinical and surgical use.</p>\n              <span class=\"bk-svc__btn\" aria-hidden=\"true\">Browse</span>\n            </div>\n          </article>\n        </li>\n\n        <!-- Card 2 -->\n        <li class=\"bk-svc__item\">\n          <article class=\"bk-svc__card\">\n            <div class=\"bk-svc__media\">\n              <img class=\"bk-svc__img\" src=\"https://images.unsplash.com/photo-1583947581279-4eec08383c38?auto=format&fit=crop&w=800&q=85\" alt=\"Hand sanitizer and disinfectant products\" loading=\"lazy\" width=\"800\" height=\"800\">\n            </div>\n            <div class=\"bk-svc__content\">\n              <h3 class=\"bk-svc__title\"><a href=\"https://bluekitesglobal.com/collections/raman-weil\" class=\"bk-svc__title-link\">Hand Rub &amp; Disinfectants</a></h3>\n              <p class=\"bk-svc__text\">Hand rubs and disinfectants for everyday hygiene and cleanliness.</p>\n              <span class=\"bk-svc__btn\" aria-hidden=\"true\">Browse</span>\n            </div>\n          </article>\n        </li>\n\n        <!-- Card 3 -->\n        <li class=\"bk-svc__item\">\n          <article class=\"bk-svc__card\">\n            <div class=\"bk-svc__media\">\n              <img class=\"bk-svc__img\" src=\"https://images.unsplash.com/photo-1683899473434-3f9012bc804b?auto=format&fit=crop&w=800&q=85\" alt=\"Healthcare and medical supplies\" loading=\"lazy\" width=\"800\" height=\"800\">\n            </div>\n            <div class=\"bk-svc__content\">\n              <h3 class=\"bk-svc__title\"><a href=\"https://bluekitesglobal.com/collections/healthcare-services\" class=\"bk-svc__title-link\">Health Care</a></h3>\n              <p class=\"bk-svc__text\">Everyday health and wellness essentials for you and your family.</p>\n              <span class=\"bk-svc__btn\" aria-hidden=\"true\">Browse</span>\n            </div>\n          </article>\n        </li>\n\n        <!-- Card 4 -->\n        <li class=\"bk-svc__item\">\n          <article class=\"bk-svc__card\">\n            <div class=\"bk-svc__media\">\n              <img class=\"bk-svc__img\" src=\"https://images.unsplash.com/photo-1762651356493-c492ca111a07?auto=format&fit=crop&w=800&q=85\" alt=\"Skincare and cosmetics products\" loading=\"lazy\" width=\"800\" height=\"800\">\n            </div>\n            <div class=\"bk-svc__content\">\n              <h3 class=\"bk-svc__title\"><a href=\"https://bluekitesglobal.com/pages/collections-cosmetics\" class=\"bk-svc__title-link\">Cosmetics</a></h3>\n              <p class=\"bk-svc__text\">Skincare and beauty products for your daily routine.</p>\n              <span class=\"bk-svc__btn\" aria-hidden=\"true\">Browse</span>\n            </div>\n          </article>\n        </li>\n\n        <!-- Card 5 -->\n        <li class=\"bk-svc__item\">\n          <article class=\"bk-svc__card\">\n            <div class=\"bk-svc__media\">\n              <img class=\"bk-svc__img\" src=\"https://images.unsplash.com/photo-1762926627752-37e9b6b42a26?auto=format&fit=crop&w=800&q=85\" alt=\"Gourmet food and packaged products\" loading=\"lazy\" width=\"800\" height=\"800\">\n            </div>\n            <div class=\"bk-svc__content\">\n              <h3 class=\"bk-svc__title\"><a href=\"https://bluekitesglobal.com/collections/food-and-gourmet\" class=\"bk-svc__title-link\">Food and Gourmet</a></h3>\n              <p class=\"bk-svc__text\">Fine foods and gourmet picks for your kitchen and table.</p>\n              <span class=\"bk-svc__btn\" aria-hidden=\"true\">Browse</span>\n            </div>\n          </article>\n        </li>\n\n        <!-- Card 6 -->\n        <li class=\"bk-svc__item\">\n          <article class=\"bk-svc__card\">\n            <div class=\"bk-svc__media\">\n              <img class=\"bk-svc__img\" src=\"https://images.unsplash.com/photo-1772729756487-4f0169ee28e5?auto=format&fit=crop&w=800&q=85\" alt=\"Travel destination landscape\" loading=\"lazy\" width=\"800\" height=\"800\">\n            </div>\n            <div class=\"bk-svc__content\">\n              <h3 class=\"bk-svc__title\"><a href=\"https://bluekites.co.in/travel-services\" class=\"bk-svc__title-link\">Tours and Travels</a></h3>\n              <p class=\"bk-svc__text\">Plan your next trip with tours and travel services.</p>\n              <span class=\"bk-svc__btn\" aria-hidden=\"true\">Browse</span>\n            </div>\n          </article>\n        </li>\n      </ul>\n    </div>\n  </div>\n</section>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
