{% doc %}
  Deals of the Day — glassmorphism slider, lemon-lime theme.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-deals-{{ ai_gen_id }} {
    --lemon: #fff44f;
    --lemon-soft: #fef9c3;
    --lime: #a3e635;
    --lime-mid: #84cc16;
    --lime-deep: #4d7c0f;
    --lime-ink: #1a2e05;
    --glass-bg: rgba(255, 255, 255, 0.38);
    --glass-bg-strong: rgba(255, 255, 255, 0.55);
    --glass-border: rgba(255, 255, 255, 0.65);
    --glass-blur: 16px;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --card-w: 180px;
    --gap: 14px;

    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    margin-block: 10px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: var(--lime-ink);
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    background:
      radial-gradient(60% 80% at 10% 0%, {{ block.settings.blob_one }} 0%, transparent 60%),
      radial-gradient(50% 70% at 90% 100%, {{ block.settings.blob_two }} 0%, transparent 60%),
      linear-gradient(135deg, {{ block.settings.section_background }} 0%, #ecfccb 100%);
    border-radius: 20px;
    overflow: hidden;
    box-sizing: border-box;
  }
  .ai-deals-{{ ai_gen_id }} * { box-sizing: border-box; }

  /* Floating blobs give the glass something to blur */
  .ai-deals-{{ ai_gen_id }}::before,
  .ai-deals-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(40px);
    opacity: .75;
    pointer-events: none;
    animation: ai-deals-float-{{ ai_gen_id }} 14s ease-in-out infinite alternate;
  }
  .ai-deals-{{ ai_gen_id }}::before { width: 260px; height: 260px; top: -60px; right: 18%; background: var(--lemon); }
  .ai-deals-{{ ai_gen_id }}::after { width: 220px; height: 220px; bottom: -70px; left: 12%; background: var(--lime); animation-delay: -7s; }
  @keyframes ai-deals-float-{{ ai_gen_id }} {
    to { transform: translate(40px, 20px) scale(1.15); }
  }

  /* Header */
  .ai-deals-{{ ai_gen_id }} .ai-deals__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin: 12px 12px 0;
    padding: 12px 18px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    box-shadow: 0 8px 24px -12px rgba(77, 124, 15, .35), inset 0 1px 0 rgba(255,255,255,.7);
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__title-wrap { display: flex; align-items: center; gap: 10px; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__bolt {
    display: grid; place-items: center;
    width: 34px; height: 34px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--lemon), var(--lime));
    box-shadow: 0 4px 12px rgba(132, 204, 22, .45);
    font-size: 18px;
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__title { margin: 0; font-size: clamp(18px, 2.6vw, 26px); line-height: 1.2; font-weight: 800; letter-spacing: -.01em; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__timer-wrap { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; white-space: nowrap; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__timer { display: flex; align-items: center; gap: 4px; font-weight: 800; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__unit {
    min-width: 38px; padding: 6px 5px;
    text-align: center;
    color: var(--lemon);
    background: rgba(26, 46, 5, .85);
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 8px;
    font-size: 15px; line-height: 1.2;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 4px 10px rgba(26, 46, 5, .25);
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__controls { display: flex; gap: 8px; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__arrow {
    display: grid; place-items: center;
    width: 36px; height: 36px;
    padding: 0;
    color: var(--lime-ink);
    background: var(--glass-bg-strong);
    border: 1px solid var(--glass-border);
    border-radius: 50%;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    cursor: pointer;
    transition: transform .3s var(--ease), background .3s var(--ease), opacity .3s;
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__arrow:hover { background: var(--lemon); transform: scale(1.08); }
  .ai-deals-{{ ai_gen_id }} .ai-deals__arrow:disabled { opacity: .35; cursor: default; transform: none; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__arrow svg { width: 16px; height: 16px; }

  /* Slider track */
  .ai-deals-{{ ai_gen_id }} .ai-deals__viewport { position: relative; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__products {
    display: flex;
    gap: var(--gap);
    padding: 18px 16px 20px;
    overflow-x: auto;
    overflow-y: visible;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 16px;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__products::-webkit-scrollbar { display: none; }

  /* Glass card */
  .ai-deals-{{ ai_gen_id }} .ai-deals__card {
    position: relative;
    flex: 0 0 var(--card-w);
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 9px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(150%);
    box-shadow: 0 6px 18px -8px rgba(77, 124, 15, .3), inset 0 1px 0 rgba(255,255,255,.8);
    scroll-snap-align: start;
    transition: transform .45s var(--ease), box-shadow .45s var(--ease), background .45s var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .ai-deals-{{ ai_gen_id }} .ai-deals__card:hover {
      z-index: 2;
      transform: translateY(-6px) scale(1.03);
      background: var(--glass-bg-strong);
      box-shadow: 0 18px 36px -12px rgba(77, 124, 15, .45), inset 0 1px 0 rgba(255,255,255,.9);
    }
    .ai-deals-{{ ai_gen_id }} .ai-deals__card:hover .ai-deals__media img { transform: scale(1.08); }
  }

  .ai-deals-{{ ai_gen_id }} .ai-deals__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgba(255, 255, 255, .7);
    border-radius: 11px;
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__media img,
  .ai-deals-{{ ai_gen_id }} .ai-deals__media svg,
  .ai-deals-{{ ai_gen_id }} .ai-deals__placeholder {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: contain;
    padding: 8px;
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__media img {
    mix-blend-mode: multiply;
    transition: transform .6s var(--ease);
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__badge {
    position: absolute; top: 7px; left: 7px; z-index: 1;
    padding: 4px 8px;
    color: var(--lime-ink);
    background: linear-gradient(135deg, var(--lemon), var(--lime));
    border-radius: 999px;
    font-size: 10px; line-height: 1.1; font-weight: 800; letter-spacing: .03em;
    box-shadow: 0 3px 8px rgba(132, 204, 22, .5);
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__name {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--lime-ink);
    font-family: inherit;
    font-size: 13px; line-height: 1.3; font-weight: 600;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    min-height: 2.6em;
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__prices { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__price { color: var(--lime-deep); font-size: 16px; line-height: 1.2; font-weight: 800; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__compare { color: #57534e; font-size: 11px; text-decoration: line-through; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__form { margin: 0; margin-top: auto; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__button {
    display: block; width: 100%;
    min-height: 34px; padding: 8px 6px;
    border: 0; border-radius: 10px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text }};
    text-align: center; text-decoration: none;
    font: inherit; font-size: 12px; line-height: 1.2; font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px -4px rgba(77, 124, 15, .6);
    transition: transform .2s var(--ease), filter .2s, box-shadow .2s;
  }
  .ai-deals-{{ ai_gen_id }} a.ai-deals__button { margin-top: auto; opacity: .55; box-shadow: none; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__button:hover { filter: brightness(1.1); box-shadow: 0 6px 16px -4px rgba(77, 124, 15, .7); }
  .ai-deals-{{ ai_gen_id }} .ai-deals__button:active { transform: scale(.97); }
  .ai-deals-{{ ai_gen_id }} .ai-deals__button:focus-visible,
  .ai-deals-{{ ai_gen_id }} .ai-deals__arrow:focus-visible,
  .ai-deals-{{ ai_gen_id }} .ai-deals__products:focus-visible { outline: 3px solid var(--lime-deep); outline-offset: 2px; }

  /* Progress bar */
  .ai-deals-{{ ai_gen_id }} .ai-deals__progress {
    height: 4px;
    margin: 0 16px 14px;
    background: rgba(255,255,255,.5);
    border-radius: 999px;
    overflow: hidden;
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__progress-bar {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--lemon), var(--lime-mid));
    border-radius: inherit;
    transition: width .35s var(--ease);
  }

  .ai-deals-{{ ai_gen_id }} .ai-deals__empty { display: flex; align-items: center; justify-content: center; min-height: 200px; padding: 16px; text-align: center; }

  @media (max-width: 600px) {
    .ai-deals-{{ ai_gen_id }} { width: 100%; --card-w: 150px; --gap: 10px; border-radius: 16px; }
    .ai-deals-{{ ai_gen_id }} .ai-deals__header { margin: 10px 10px 0; padding: 10px 12px; }
    .ai-deals-{{ ai_gen_id }} .ai-deals__controls { display: none; }
    .ai-deals-{{ ai_gen_id }} .ai-deals__timer-wrap { gap: 5px; font-size: 11px; }
    .ai-deals-{{ ai_gen_id }} .ai-deals__unit { min-width: 30px; padding: 4px; font-size: 12px; }
    .ai-deals-{{ ai_gen_id }} .ai-deals__products { padding: 14px 12px 16px; }
    .ai-deals-{{ ai_gen_id }} .ai-deals__title { font-size: clamp(16px, 4.8vw, 20px); }
    .ai-deals-{{ ai_gen_id }} .ai-deals__bolt { width: 28px; height: 28px; font-size: 15px; }
    .ai-deals-{{ ai_gen_id }} .ai-deals__button { min-height: 36px; }
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .ai-deals-{{ ai_gen_id }} .ai-deals__card,
    .ai-deals-{{ ai_gen_id }} .ai-deals__header { background: rgba(255,255,255,.85); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-deals-{{ ai_gen_id }}::before,
    .ai-deals-{{ ai_gen_id }}::after { animation: none; }
    .ai-deals-{{ ai_gen_id }} .ai-deals__products { scroll-behavior: auto; }
    .ai-deals-{{ ai_gen_id }} .ai-deals__card,
    .ai-deals-{{ ai_gen_id }} .ai-deals__media img { transition: none; transform: none !important; }
  }
{% endstyle %}

<deals-of-day-{{ ai_gen_id }}
  class="ai-deals-{{ ai_gen_id }}"
  data-end="{{ block.settings.end_time | escape }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-speed="{{ block.settings.autoplay_speed | times: 1000 }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-deals__header">
    <div class="ai-deals__title-wrap">
      <span class="ai-deals__bolt" aria-hidden="true">⚡</span>
      <h2 class="ai-deals__title">{{ block.settings.heading | escape }}</h2>
    </div>
    <div class="ai-deals__timer-wrap">
      <span>{{ block.settings.timer_label | escape }}</span>
      <div class="ai-deals__timer" role="timer" aria-live="off">
        <span class="ai-deals__unit" data-hours>00</span><span aria-hidden="true">:</span>
        <span class="ai-deals__unit" data-minutes>00</span><span aria-hidden="true">:</span>
        <span class="ai-deals__unit" data-seconds>00</span>
      </div>
    </div>
    {% if block.settings.products != blank %}
      <div class="ai-deals__controls">
        <button class="ai-deals__arrow" type="button" data-prev aria-label="Previous deals">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="ai-deals__arrow" type="button" data-next aria-label="Next deals">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    {% endif %}
  </div>

  {% assign deal_products = block.settings.products %}
  {% if deal_products != blank %}
    <div class="ai-deals__viewport">
      <div class="ai-deals__products" tabindex="0" aria-label="Deal products" data-track>
        {% for product in deal_products %}
          {% assign deal_variant = product.selected_or_first_available_variant %}
          {% assign has_discount = false %}
          {% assign discount_percent = 0 %}
          {% if deal_variant.compare_at_price > deal_variant.price and deal_variant.compare_at_price > 0 %}
            {% assign has_discount = true %}
            {% assign discount_amount = deal_variant.compare_at_price | minus: deal_variant.price %}
            {% assign discount_percent = discount_amount | times: 100.0 | divided_by: deal_variant.compare_at_price | round %}
          {% endif %}
          <article class="ai-deals__card">
            <a class="ai-deals__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
              {% else %}
                <div class="ai-deals__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
              {% endif %}
              {% if has_discount %}<span class="ai-deals__badge">{{ discount_percent }}% OFF</span>{% endif %}
            </a>
            <h3 class="ai-deals__name">{{ product.title | escape }}</h3>
            <div class="ai-deals__prices">
              <span class="ai-deals__price">{{ deal_variant.price | money }}</span>
              {% if has_discount %}<span class="ai-deals__compare">{{ deal_variant.compare_at_price | money }}</span>{% endif %}
            </div>
            {% if deal_variant.available %}
              <form class="ai-deals__form" method="post" action="{{ routes.cart_add_url }}">
                <input type="hidden" name="id" value="{{ deal_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button class="ai-deals__button" type="submit">{{ block.settings.button_label | escape }}</button>
              </form>
            {% else %}
              <a class="ai-deals__button" href="{{ product.url }}">{{ block.settings.sold_out_label | escape }}</a>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
    <div class="ai-deals__progress" aria-hidden="true"><div class="ai-deals__progress-bar" data-progress></div></div>
  {% else %}
    <div class="ai-deals__empty">Select products in the block settings to show today's deals.</div>
  {% endif %}
</deals-of-day-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'deals-of-day-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;

    class DealsOfDay extends HTMLElement {
      connectedCallback() {
        this.hours = this.querySelector('[data-hours]');
        this.minutes = this.querySelector('[data-minutes]');
        this.seconds = this.querySelector('[data-seconds]');
        this.endTime = Date.parse(this.dataset.end);
        this.updateTimer();
        this.timerInterval = window.setInterval(() => this.updateTimer(), 1000);

        this.track = this.querySelector('[data-track]');
        if (!this.track) return;
        this.prevBtn = this.querySelector('[data-prev]');
        this.nextBtn = this.querySelector('[data-next]');
        this.progress = this.querySelector('[data-progress]');
        this.reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        this.onScroll = () => this.updateSlider();
        this.track.addEventListener('scroll', this.onScroll, { passive: true });
        this.prevBtn?.addEventListener('click', () => this.slide(-1));
        this.nextBtn?.addEventListener('click', () => this.slide(1));

        this.resizeObserver = new ResizeObserver(() => this.updateSlider());
        this.resizeObserver.observe(this.track);

        // Autoplay: pauses on hover, focus, touch, and when tab is hidden
        this.autoplay = this.dataset.autoplay === 'true' && !this.reduceMotion;
        this.speed = Math.max(2000, Number(this.dataset.speed) || 4000);
        if (this.autoplay) {
          const pause = () => this.stopAutoplay();
          const resume = () => this.startAutoplay();
          this.addEventListener('mouseenter', pause);
          this.addEventListener('mouseleave', resume);
          this.addEventListener('focusin', pause);
          this.addEventListener('focusout', resume);
          this.track.addEventListener('touchstart', pause, { passive: true });
          this.track.addEventListener('touchend', resume, { passive: true });
          this.onVisibility = () => (document.hidden ? pause() : resume());
          document.addEventListener('visibilitychange', this.onVisibility);
          this.startAutoplay();
        }

        this.updateSlider();
      }

      disconnectedCallback() {
        window.clearInterval(this.timerInterval);
        this.stopAutoplay();
        this.resizeObserver?.disconnect();
        if (this.onVisibility) document.removeEventListener('visibilitychange', this.onVisibility);
      }

      step() {
        const card = this.track.querySelector('.ai-deals__card');
        if (!card) return this.track.clientWidth;
        const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
        const cardSpan = card.offsetWidth + gap;
        const visible = Math.max(1, Math.floor((this.track.clientWidth + gap) / cardSpan));
        return cardSpan * visible;
      }

      maxScroll() {
        return this.track.scrollWidth - this.track.clientWidth;
      }

      slide(dir) {
        const max = this.maxScroll();
        const atEnd = this.track.scrollLeft >= max - 4;
        const atStart = this.track.scrollLeft <= 4;
        if (dir > 0 && atEnd) return this.track.scrollTo({ left: 0 });
        if (dir < 0 && atStart) return this.track.scrollTo({ left: max });
        this.track.scrollBy({ left: dir * this.step() });
      }

      updateSlider() {
        const max = this.maxScroll();
        const scrollable = max > 4;
        if (this.prevBtn) this.prevBtn.disabled = !scrollable;
        if (this.nextBtn) this.nextBtn.disabled = !scrollable;
        if (this.progress) {
          const viewRatio = this.track.clientWidth / this.track.scrollWidth;
          const pos = scrollable ? this.track.scrollLeft / max : 1;
          this.progress.style.width = `${Math.min(100, (viewRatio + (1 - viewRatio) * pos) * 100)}%`;
        }
      }

      startAutoplay() {
        if (!this.autoplay || this.autoplayTimer) return;
        this.autoplayTimer = window.setInterval(() => this.slide(1), this.speed);
      }

      stopAutoplay() {
        window.clearInterval(this.autoplayTimer);
        this.autoplayTimer = null;
      }

      updateTimer() {
        let remaining = Number.isFinite(this.endTime) ? Math.max(0, Math.floor((this.endTime - Date.now()) / 1000)) : 0;
        const hours = Math.floor(remaining / 3600);
        remaining %= 3600;
        const minutes = Math.floor(remaining / 60);
        const seconds = remaining % 60;
        this.hours.textContent = String(hours).padStart(2, '0');
        this.minutes.textContent = String(minutes).padStart(2, '0');
        this.seconds.textContent = String(seconds).padStart(2, '0');
      }
    }

    customElements.define(tagName, DealsOfDay);
  })();
</script>

{% schema %}
{
  "name": "Deals of the day",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Deals of the Day" },
    { "type": "text", "id": "timer_label", "label": "Timer label", "default": "Ends in" },
    { "type": "text", "id": "end_time", "label": "Countdown end time", "default": "2026-12-31T23:59:59+05:30" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "header", "content": "Slider" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay delay", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 4 },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Add button label", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Unavailable label", "default": "Sold out" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "#FEFCE8" },
    { "type": "color", "id": "blob_one", "label": "Glow color 1", "default": "#FFF44F" },
    { "type": "color", "id": "blob_two", "label": "Glow color 2", "default": "#A3E635" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#4D7C0F" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#FEF9C3" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
