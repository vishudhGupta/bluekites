{%- liquid
  assign s = section.settings
  assign service_count = section.blocks.size
-%}

<style>
  {{ s.heading_font | font_face: font_display: 'swap' }}
</style>

<section
  id="Services-{{ section.id }}"
  class="bk-svc color-{{ s.color_scheme }}"
  style="
    --svc-bg: {{ s.section_background }};
    --svc-heading: {{ s.heading_color }};
    --svc-text: {{ s.text_color }};
    --svc-card: {{ s.card_background }};
    --svc-border: {{ s.card_border }};
    --svc-accent: {{ s.accent_color }};
    --svc-accent-2: {{ s.accent_color_2 }};
    --svc-gap: {{ s.grid_gap }}px;
    --svc-radius: {{ s.card_radius }}px;
    --svc-top: {{ s.padding_top }}px;
    --svc-bottom: {{ s.padding_bottom }}px;
    --svc-cols: {{ s.columns_desktop }};
    --svc-heading-font: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }};
    --svc-heading-weight: {{ s.heading_font.weight }};
  "
>
  <div class="bk-svc__inner">

    {%- if s.subheading != blank or s.heading != blank or s.description != blank -%}
      <header class="bk-svc__head">
        {%- if s.subheading != blank -%}
          <p class="bk-svc__eyebrow">{{ s.subheading | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="bk-svc__title">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.description != blank -%}
          <p class="bk-svc__desc">{{ s.description | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if service_count > 0 -%}
      <ul class="bk-svc__grid" role="list">
        {%- assign num = 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign card_link = b.custom_url
            if card_link == blank and b.link_page != blank
              assign card_link = pages[b.link_page].url
            endif
            assign is_cta = false
            if block.type == 'cta_card'
              assign is_cta = true
            else
              assign num = num | plus: 1
            endif
          -%}
          <li {{ block.shopify_attributes }}>
            {%- if card_link != blank -%}
              <a
                class="bk-svc__card{% if is_cta %} bk-svc__card--cta{% endif %}"
                href="{{ card_link }}"
                {% if b.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              >
            {%- else -%}
              <div class="bk-svc__card{% if is_cta %} bk-svc__card--cta{% endif %}">
            {%- endif -%}

              {%- if s.show_numbers and is_cta == false -%}
                <span class="bk-svc__num">{% if num < 10 %}0{% endif %}{{ num }}</span>
              {%- endif -%}

              <span class="bk-svc__icon" aria-hidden="true">
                {%- if b.image != blank -%}
                  {{ b.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                {%- elsif is_cta -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="7" height="7" rx="2"/><rect x="13" y="4" width="7" height="7" rx="2"/><rect x="4" y="13" width="7" height="7" rx="2"/><rect x="13" y="13" width="7" height="7" rx="2"/></svg>
                {%- endif -%}
              </span>

              {%- if b.title != blank -%}
                <h3 class="bk-svc__card-title">{{ b.title | escape }}</h3>
              {%- endif -%}

              {%- if b.description != blank -%}
                <p class="bk-svc__text">{{ b.description | escape }}</p>
              {%- endif -%}

              {%- if card_link != blank and b.button_label != blank -%}
                <span class="bk-svc__link">
                  {{ b.button_label | escape }}
                  <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              {%- endif -%}

            {%- if card_link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="bk-svc__empty">Add Service card blocks to display your services.</p>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
.bk-svc {
  width: 100%;
  background: var(--svc-bg);
  color: var(--svc-heading);
  padding-block: var(--svc-top) var(--svc-bottom);
}
.bk-svc *,
.bk-svc *::before,
.bk-svc *::after { box-sizing: border-box; }

.bk-svc__inner {
  width: min(calc(100% - 32px), 1240px);
  margin-inline: auto;
}

/* Header */
.bk-svc__head {
  max-width: 640px;
  margin: 0 auto clamp(36px, 5vw, 56px);
  text-align: center;
}
.bk-svc__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin: 0 0 14px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--svc-accent);
}
.bk-svc__eyebrow::before,
.bk-svc__eyebrow::after {
  content: "";
  width: 28px;
  height: 1px;
  background: currentColor;
  opacity: .6;
}
.bk-svc__title {
  margin: 0;
  color: var(--svc-heading);
  font-family: var(--svc-heading-font);
  font-weight: var(--svc-heading-weight);
  font-size: clamp(28px, 4vw, 44px);
  line-height: 1.15;
  letter-spacing: -.02em;
}
.bk-svc__desc {
  margin: 14px 0 0;
  font-size: 15px;
  line-height: 1.6;
  color: var(--svc-text);
}

/* Grid */
.bk-svc__grid {
  display: grid;
  grid-template-columns: repeat(var(--svc-cols, 4), minmax(0, 1fr));
  gap: var(--svc-gap);
  margin: 0;
  padding: 0;
  list-style: none;
}
.bk-svc__grid > li { min-width: 0; }

/* Card */
.bk-svc__card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 14px;
  height: 100%;
  padding: 28px 24px 24px;
  background: var(--svc-card);
  border: 1px solid var(--svc-border);
  border-radius: var(--svc-radius);
  color: var(--svc-heading);
  text-decoration: none;
  overflow: hidden;
  isolation: isolate;
  transition: transform .35s ease, box-shadow .35s ease, border-color .35s ease, color .35s ease;
}
.bk-svc__card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(160deg, color-mix(in srgb, var(--svc-accent) 85%, #fff), var(--svc-accent) 60%, color-mix(in srgb, var(--svc-accent) 75%, #000));
  transform: translateY(101%);
  transition: transform .45s cubic-bezier(.2, .7, .2, 1);
}
.bk-svc__card:hover,
.bk-svc__card:focus-visible {
  transform: translateY(-6px);
  border-color: transparent;
  box-shadow: 0 24px 48px -24px color-mix(in srgb, var(--svc-accent) 70%, transparent);
  color: #fff;
}
.bk-svc__card:hover::before,
.bk-svc__card:focus-visible::before { transform: translateY(0); }
.bk-svc__card:focus-visible { outline: 2px solid var(--svc-accent-2); outline-offset: 3px; }

.bk-svc__num {
  position: absolute;
  top: 20px;
  right: 22px;
  font-size: 13px;
  font-weight: 600;
  color: var(--svc-text);
  opacity: .5;
  transition: color .35s ease, opacity .35s ease;
}
.bk-svc__card:hover .bk-svc__num { color: var(--svc-accent-2); opacity: 1; }

.bk-svc__icon {
  display: grid;
  place-items: center;
  width: 60px;
  height: 60px;
  color: var(--svc-accent);
  background: color-mix(in srgb, var(--svc-accent) 8%, #fff);
  border-radius: 16px;
  transition: background .35s ease, transform .35s ease;
}
.bk-svc__icon img { width: 36px; height: 36px; object-fit: contain; }
.bk-svc__icon svg { width: 26px; height: 26px; }
.bk-svc__card:hover .bk-svc__icon { background: #fff; transform: rotate(-6deg) scale(1.05); }

.bk-svc__card-title {
  margin: 6px 0 0;
  color: inherit;
  font-family: var(--font-body--family, inherit);
  font-size: 19px;
  font-weight: 600;
  line-height: 1.3;
}
.bk-svc__text {
  margin: 0;
  font-size: 14px;
  line-height: 1.65;
  color: var(--svc-text);
  transition: color .35s ease;
}
.bk-svc__card:hover .bk-svc__text { color: rgba(255, 255, 255, .82); }

.bk-svc__link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: auto;
  padding-top: 6px;
  font-size: 14px;
  font-weight: 600;
  color: var(--svc-accent);
  transition: color .35s ease, gap .35s ease;
}
.bk-svc__link svg { width: 16px; height: 16px; }
.bk-svc__card:hover .bk-svc__link { color: var(--svc-accent-2); gap: 12px; }

/* CTA card */
.bk-svc__card--cta {
  justify-content: center;
  background: var(--svc-accent);
  border-color: var(--svc-accent);
  color: #fff;
}
.bk-svc__card--cta::before { background: linear-gradient(160deg, color-mix(in srgb, var(--svc-accent-2) 70%, #000), var(--svc-accent-2)); }
.bk-svc__card--cta .bk-svc__icon { color: #fff; background: rgba(255, 255, 255, .14); }
.bk-svc__card--cta .bk-svc__text { color: rgba(255, 255, 255, .8); }
.bk-svc__card--cta .bk-svc__link { color: var(--svc-accent-2); }
.bk-svc__card--cta:hover { color: var(--svc-heading); }
.bk-svc__card--cta:hover .bk-svc__icon { color: var(--svc-accent); }
.bk-svc__card--cta:hover .bk-svc__text { color: color-mix(in srgb, var(--svc-heading) 75%, transparent); }
.bk-svc__card--cta:hover .bk-svc__link { color: var(--svc-heading); }

.bk-svc__empty { margin: 0; text-align: center; font-size: 14px; color: var(--svc-text); }

/* Responsive */
@media screen and (max-width: 1080px) {
  .bk-svc__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media screen and (max-width: 760px) {
  .bk-svc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .bk-svc__card { padding: 22px 18px 18px; }
  .bk-svc__card-title { font-size: 16px; }
  .bk-svc__text { font-size: 13px; }
}
@media screen and (max-width: 460px) {
  .bk-svc__grid { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) {
  .bk-svc__card,
  .bk-svc__card *,
  .bk-svc__card::before { transition: none !important; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Services grid",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "subheading", "label": "Eyebrow", "default": "Our Services" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What We Can Help You With" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "poppins_n6" },
    { "type": "header", "content": "Cards" },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_numbers", "label": "Show card numbers", "default": true },
    { "type": "range", "id": "grid_gap", "label": "Card spacing", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "card_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 18 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "#FAF8F6" },
    { "type": "color", "id": "heading_color", "label": "Heading and title color", "default": "#1A1416" },
    { "type": "color", "id": "text_color", "label": "Description color", "default": "#6B6466" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#ECE6E3" },
    { "type": "color", "id": "accent_color", "label": "Accent (hover fill)", "default": "#7A1F24" },
    { "type": "color", "id": "accent_color_2", "label": "Highlight (gold)", "default": "#D9B77E" }
  ],
  "blocks": [
    {
      "type": "service_card",
      "name": "Service card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon", "info": "Small square icon, transparent PNG works best." },
        { "type": "text", "id": "title", "label": "Title", "default": "Service title" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Discover how our service can help you." },
        { "type": "page", "id": "link_page", "label": "Link to page" },
        { "type": "url", "id": "custom_url", "label": "Custom URL", "info": "Overrides the selected page when provided." },
        { "type": "text", "id": "button_label", "label": "Link label", "default": "Explore" },
        { "type": "checkbox", "id": "open_in_new_tab", "label": "Open link in a new tab", "default": false }
      ]
    },
    {
      "type": "cta_card",
      "name": "Contact card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Need something else?" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Tell us what you're looking for and our team will get back to you." },
        { "type": "page", "id": "link_page", "label": "Link to page" },
        { "type": "url", "id": "custom_url", "label": "Custom URL", "info": "Overrides the selected page when provided." },
        { "type": "text", "id": "button_label", "label": "Link label", "default": "Contact us" },
        { "type": "checkbox", "id": "open_in_new_tab", "label": "Open link in a new tab", "default": false }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Services grid",
      "blocks": [
        { "type": "service_card", "settings": { "title": "Surgical Products", "description": "Reliable surgical supplies and consumables for hospitals, clinics and healthcare professionals." } },
        { "type": "service_card", "settings": { "title": "Handrub & Disinfectants", "description": "Hospital-grade hand rubs and surface disinfectants for effective infection control." } },
        { "type": "service_card", "settings": { "title": "Healthcare", "description": "Quality healthcare essentials that support better care, safety and everyday wellbeing." } },
        { "type": "service_card", "settings": { "title": "Cosmetics", "description": "Trusted personal care and beauty products, carefully selected for quality." } },
        { "type": "service_card", "settings": { "title": "Food & Gourmet", "description": "Fine food and gourmet selections, sourced with the same care we bring to everything." } },
        { "type": "service_card", "settings": { "title": "Tours & Travels", "description": "Well-planned travel and tour packages for comfortable, hassle-free journeys." } },
        { "type": "service_card", "settings": { "title": "IT Services", "description": "Practical technology solutions that help businesses work smarter and grow faster." } },
        { "type": "cta_card" }
      ]
    }
  ]
}
{% endschema %}
