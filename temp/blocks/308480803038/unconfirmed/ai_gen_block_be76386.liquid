{% doc %}
  @prompt
    please add a section listing of all the products associated to a particular category, the user will select the category and all the products will get listed down, here i want a modification , the user can  add multiple sub categories
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign selected_collections = block.settings.subcategories %}

{% style %}
  .ai-category-products-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 32px 0;
    color: #111111;
  }

  .ai-category-products-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.2;
  }

  .ai-category-products-{{ ai_gen_id }}__subcategory {
    margin: 0 0 32px;
  }

  .ai-category-products-{{ ai_gen_id }}__subcategory-title {
    margin: 0 0 16px;
    font-size: 20px;
    line-height: 1.3;
  }

  .ai-category-products-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 24px 16px;
  }

  .ai-category-products-{{ ai_gen_id }}__card {
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .ai-category-products-{{ ai_gen_id }}__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 10px;
    background: #f4f4f4;
    margin-bottom: 12px;
  }

  .ai-category-products-{{ ai_gen_id }}__media img,
  .ai-category-products-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-category-products-{{ ai_gen_id }}__title {
    margin: 0 0 6px;
    font-size: 15px;
    line-height: 1.4;
  }

  .ai-category-products-{{ ai_gen_id }}__price {
    margin: 0;
    font-size: 14px;
  }

  .ai-category-products-{{ ai_gen_id }}__empty {
    padding: 20px;
    border: 1px solid #e6e6e6;
    border-radius: 8px;
    color: #333333;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-category-products-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-category-products-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 20px 12px;
    }
  }
{% endstyle %}

<div class="ai-category-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-category-products-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  {% if selected_collections != blank %}
    {% for selected_collection in selected_collections %}
      {% if selected_collection != blank %}
        <section class="ai-category-products-{{ ai_gen_id }}__subcategory" aria-labelledby="ai-subcategory-{{ ai_gen_id }}-{{ forloop.index }}">
          <h3 class="ai-category-products-{{ ai_gen_id }}__subcategory-title" id="ai-subcategory-{{ ai_gen_id }}-{{ forloop.index }}">{{ selected_collection.title | escape }}</h3>
          {% if selected_collection.products_count > 0 %}
            <div class="ai-category-products-{{ ai_gen_id }}__grid">
              {% for product in selected_collection.products limit: block.settings.product_limit %}
                <a class="ai-category-products-{{ ai_gen_id }}__card" href="{{ product.url }}">
                  <div class="ai-category-products-{{ ai_gen_id }}__media">
                    {% if product.featured_image %}
                      <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
                    {% else %}
                      <div>{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
                    {% endif %}
                  </div>
                  <h4 class="ai-category-products-{{ ai_gen_id }}__title">{{ product.title | escape }}</h4>
                  <p class="ai-category-products-{{ ai_gen_id }}__price">
                    {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s> {% endif %}{{ product.price | money }}
                  </p>
                </a>
              {% endfor %}
            </div>
          {% else %}
            <p class="ai-category-products-{{ ai_gen_id }}__empty">This subcategory currently has no products to display.</p>
          {% endif %}
        </section>
      {% endif %}
    {% endfor %}
  {% else %}
    <div class="ai-category-products-{{ ai_gen_id }}__empty">Select one or more collections in the block settings to display their products.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Category products",
  "settings": [
    { "type": "collection_list", "id": "subcategories", "label": "Subcategory collections", "limit": 12 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Products in this category" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "product_limit", "label": "Products per subcategory", "min": 4, "max": 50, "step": 2, "default": 12 },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" }
  ],
  "presets": [{ "name": "Category products" }],
  "tag": null,
  "class": "category-products-block"
}
{% endschema %}