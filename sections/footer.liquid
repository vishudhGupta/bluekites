<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} bk-footer"
>
  {% liquid
    assign total_blocks = section.blocks.size
    assign grid_columns = total_blocks | at_most: 4
    assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 4 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}

  <div
    class="
      footer-content
      bk-footer__content
      spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
    "
  >
    {% content_for 'blocks' %}
  </div>

  <div class="bk-footer__bottom">
    <p class="bk-footer__copyright">© {{ 'now' | date: '%Y' }} Bluekites. All rights reserved.</p>
    {% if shop.policies.size > 0 %}
      <nav class="bk-footer__legal" aria-label="Legal">
        {% for policy in shop.policies %}
          {% if policy != blank %}
            <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
          {% endif %}
        {% endfor %}
      </nav>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .bk-footer {
    --bk-footer-ink: #12325B;
    --bk-footer-muted: #4D617A;
    --bk-footer-border: #DCE8F5;
    --bk-footer-surface: #FFFFFF;
    --bk-footer-blue: #1F74BA;
    --bk-footer-yellow: #F8D706;
    --bk-footer-orange: #F09120;
    position: relative;
    color: var(--bk-footer-ink);
    background: var(--bk-footer-surface);
    border-top: 3px solid var(--bk-footer-blue);
  }

  .bk-footer,
  .bk-footer * {
    box-sizing: border-box;
  }

  .bk-footer .bk-footer__content {
    display: grid;
    grid-template-columns: minmax(220px, 1.1fr) minmax(0, 1.15fr) minmax(0, 1fr) minmax(240px, 1.1fr);
    align-items: start;
    gap: clamp(28px, 3.2vw, 56px);
    width: calc(100% - 96px);
    max-width: 1640px;
    margin-inline: auto;
    padding-block: clamp(36px, 4.5vw, 64px) 34px;
    contain: none;
    content-visibility: visible;
  }

  .bk-footer .bk-footer__content > * {
    min-width: 0;
  }

  .bk-footer .bk-footer__content h2,
  .bk-footer .bk-footer__content h3,
  .bk-footer .bk-footer__content h4,
  .bk-footer .bk-footer__content .menu__heading,
  .bk-footer .bk-footer__content .menu__heading__default {
    margin-block: 0 16px;
    color: var(--bk-footer-ink);
    font-family: inherit;
    font-size: clamp(20px, 1.7vw, 27px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .bk-footer .bk-footer__content p {
    margin-block: 0 12px;
    color: var(--bk-footer-muted);
    font-size: 13px;
    line-height: 1.65;
  }

  .bk-footer .bk-footer__content a {
    color: var(--bk-footer-muted);
    text-decoration: none;
    text-underline-offset: 3px;
    transition: color 160ms ease, opacity 160ms ease;
  }

  .bk-footer .bk-footer__content a:hover {
    color: var(--bk-footer-ink);
    text-decoration: underline;
  }

  .bk-footer .bk-footer__content a:focus-visible,
  .bk-footer__bottom a:focus-visible {
    outline: 2px solid var(--bk-footer-ink);
    outline-offset: 4px;
    border-radius: 3px;
  }

  .bk-footer .bk-footer__content ul,
  .bk-footer .bk-footer__content ol {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bk-footer .bk-footer__content li {
    margin: 0;
    color: var(--bk-footer-muted);
    font-size: 13px;
    line-height: 1.55;
  }

  .bk-footer .bk-footer__content img,
  .bk-footer .bk-footer__content svg {
    max-width: 100%;
  }

  .bk-footer .bk-footer__content img {
    display: block;
    width: auto;
    max-height: 92px;
    object-fit: contain;
    object-position: left center;
  }

  /* Restore a prominent logo without changing the theme's saved logo block settings. */
  .bk-footer .bk-footer__content > :first-child img,
  .bk-footer .bk-footer__content > :first-child .image-block img,
  .bk-footer .bk-footer__content > :first-child .footer-logo img {
    width: 180px !important;
    max-width: 100%;
    max-height: 128px;
    height: auto;
    object-fit: contain;
    object-position: left top;
  }

  /* Keep block content aligned consistently inside each grid column. */
  .bk-footer .bk-footer__content > * {
    align-self: start;
    justify-self: stretch;
  }

  .bk-footer .bk-footer__content input:not([type='checkbox']):not([type='radio']),
  .bk-footer .bk-footer__content select,
  .bk-footer .bk-footer__content textarea {
    width: 100%;
    min-height: 42px;
    padding: 10px 12px;
    border: 1px solid var(--bk-footer-border);
    border-radius: 8px;
    background: #fff;
    color: var(--bk-footer-ink);
    font: inherit;
  }

  .bk-footer .bk-footer__content button,
  .bk-footer .bk-footer__content input[type='submit'] {
    min-height: 42px;
    padding: 10px 17px;
    border: 1px solid var(--bk-footer-ink);
    border-radius: 8px;
    background: var(--bk-footer-blue);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .bk-footer .bk-footer__content button:hover,
  .bk-footer .bk-footer__content input[type='submit']:hover {
    opacity: .9;
    transform: translateY(-1px);
  }

  .bk-footer .bk-footer__content .social-links,
  .bk-footer .bk-footer__content .social-links__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .bk-footer .bk-footer__content .social-links a,
  .bk-footer .bk-footer__content .social-links__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--bk-footer-border);
    border-radius: 50%;
    background: #fff;
    color: var(--bk-footer-blue);
  }

  .bk-footer .bk-footer__content .social-links a:hover,
  .bk-footer .bk-footer__content .social-links__link:hover {
    border-color: var(--bk-footer-ink);
    background: var(--bk-footer-blue);
    color: #fff;
    text-decoration: none;
  }

  .bk-footer .bk-footer__content .payment-icons,
  .bk-footer .bk-footer__content .list-payment {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .bk-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    width: 100%;
    max-width: 100%;
    margin-inline: 0;
    padding: 18px max(48px, calc((100% - 1640px) / 2)) 22px;
    border-top: 1px solid var(--bk-footer-border);
    background: linear-gradient(90deg, #12325B 0%, #1F74BA 100%);
  }

  .bk-footer__copyright {
    margin: 0;
    color: #FFFFFF;
    font-size: 11px;
    line-height: 1.5;
  }

  .bk-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }

  .bk-footer__legal a {
    color: #FFFFFF;
    font-size: 11px;
    line-height: 1.5;
    text-decoration: none;
  }

  .bk-footer__legal a:hover {
    color: var(--bk-footer-yellow);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (min-width: 750px) and (max-width: 1099px) {
    .bk-footer .bk-footer__content {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 34px 40px;
      width: calc(100% - 64px);
      padding-block: 38px 28px;
    }

    .bk-footer .bk-footer__content img {
      max-height: 82px;
    }

    .bk-footer .bk-footer__content > :first-child img,
    .bk-footer .bk-footer__content > :first-child .image-block img,
    .bk-footer .bk-footer__content > :first-child .footer-logo img {
      width: 165px !important;
      max-height: 112px;
    }

    .bk-footer__bottom {
      padding-inline: 32px;
    }
  }

  @media screen and (max-width: 749px) {
    .bk-footer .bk-footer__content {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
      width: calc(100% - 40px);
      padding-block: 32px 24px;
    }

    .bk-footer .bk-footer__content h2,
    .bk-footer .bk-footer__content h3,
    .bk-footer .bk-footer__content h4,
    .bk-footer .bk-footer__content .menu__heading,
    .bk-footer .bk-footer__content .menu__heading__default {
      margin-bottom: 12px;
      font-size: 20px;
    }

    .bk-footer .bk-footer__content p,
    .bk-footer .bk-footer__content li {
      font-size: 12px;
    }

    .bk-footer .bk-footer__content ul,
    .bk-footer .bk-footer__content ol {
      gap: 9px;
    }

    .bk-footer .bk-footer__content img {
      max-height: 72px;
    }

    .bk-footer .bk-footer__content > :first-child img,
    .bk-footer .bk-footer__content > :first-child .image-block img,
    .bk-footer .bk-footer__content > :first-child .footer-logo img {
      width: 150px !important;
      max-height: 100px;
    }

    .bk-footer__bottom {
      width: 100%;
      justify-content: center;
      text-align: center;
      padding: 16px 20px 20px;
    }

    .bk-footer__legal {
      justify-content: center;
    }
  }

  @media screen and (max-width: 480px) {
    .bk-footer .bk-footer__content {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      width: calc(100% - 36px);
    }

    .bk-footer .bk-footer__content > * {
      width: 100%;
    }

    .bk-footer .bk-footer__content img {
      max-height: 76px;
    }

    .bk-footer .bk-footer__content > :first-child img,
    .bk-footer .bk-footer__content > :first-child .image-block img,
    .bk-footer .bk-footer__content > :first-child .footer-logo img {
      width: 160px !important;
      max-height: 104px;
    }

    .bk-footer__bottom {
      width: 100%;
      padding-inline: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bk-footer *,
    .bk-footer *::before,
    .bk-footer *::after {
      scroll-behavior: auto !important;
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "blocks": [
    { "type": "_divider" },
    { "type": "@app" },
    { "type": "button" },
    { "type": "follow-on-shop" },
    { "type": "group" },
    { "type": "icon" },
    { "type": "image" },
    { "type": "menu" },
    { "type": "payment-icons" },
    { "type": "text" },
    { "type": "logo" },
    { "type": "jumbo-text" },
    { "type": "social-links" },
    { "type": "email-signup" }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer",
      "settings": {
        "gap": 0,
        "color_scheme": "scheme-1",
        "padding-block-start": 20,
        "padding-block-end": 20
      },
      "blocks": {
        "newsletter-group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "gap": 6,
            "width": "fill",
            "inherit_color_scheme": true
          },
          "blocks": {
            "newsletter-heading": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.join_our_email_list",
                "width": "100%",
                "alignment": "left",
                "type_preset": "h3"
              }
            },
            "newsletter-text": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.get_exclusive_deals_and_early_access_to_new_products",
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte"
              }
            }
          },
          "block_order": ["newsletter-heading", "newsletter-text"]
        },
        "newsletter-form": {
          "type": "email-signup",
          "settings": {
            "width": "fill"
          }
        }
      },
      "block_order": ["newsletter-group", "newsletter-form"]
    }
  ]
}
{% endschema %}
