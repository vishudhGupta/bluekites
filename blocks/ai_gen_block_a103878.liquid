{% doc %}
  @prompt
    please generate a section in which there will be colections categories and sub- categories of cosmetics and it sprodutcs
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cosmetics-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 40px 24px;
    color: #241b1d;
    background: #faf9f1;
    font-family: var(--font-body-family, sans-serif);
  }

  .ai-cosmetics-{{ ai_gen_id }}__inner { max-width: 1280px; margin: 0 auto; }
  .ai-cosmetics-{{ ai_gen_id }}__title { margin: 0 0 10px; color: #37181d; font-family: var(--font-heading-family, Georgia, serif); font-size: clamp(28px, 4vw, 44px); line-height: 1.15; }
  .ai-cosmetics-{{ ai_gen_id }}__intro { margin: 0 0 32px; max-width: 680px; line-height: 1.6; }
  .ai-cosmetics-{{ ai_gen_id }}__group { margin-top: 36px; }
  .ai-cosmetics-{{ ai_gen_id }}__group-title { margin: 0 0 18px; color: #37181d; font-family: var(--font-heading-family, Georgia, serif); font-size: 26px; }
  .ai-cosmetics-{{ ai_gen_id }}__collection { margin: 24px 0 32px; }
  .ai-cosmetics-{{ ai_gen_id }}__collection-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
  .ai-cosmetics-{{ ai_gen_id }}__collection-heading h3 { margin: 0; font-size: 20px; color: #37181d; }
  .ai-cosmetics-{{ ai_gen_id }}__collection-heading a { color: #37181d; font-weight: 600; text-underline-offset: 3px; }
  .ai-cosmetics-{{ ai_gen_id }}__products { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  .ai-cosmetics-{{ ai_gen_id }}__card { min-width: 0; overflow: hidden; background: #fff; border: 1px solid #e6dfdc; border-radius: 10px; }
  .ai-cosmetics-{{ ai_gen_id }}__image { display: block; aspect-ratio: 1 / 1; background: #f1ede7; }
  .ai-cosmetics-{{ ai_gen_id }}__image img, .ai-cosmetics-{{ ai_gen_id }}__image svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-cosmetics-{{ ai_gen_id }}__image svg { background: #f1ede7; }
  .ai-cosmetics-{{ ai_gen_id }}__details { padding: 12px 14px 16px; }
  .ai-cosmetics-{{ ai_gen_id }}__product-name { display: block; margin: 0 0 7px; color: #241b1d; font-weight: 600; text-decoration: none; line-height: 1.4; }
  .ai-cosmetics-{{ ai_gen_id }}__price { margin: 0; color: #37181d; }
  .ai-cosmetics-{{ ai_gen_id }}__empty { padding: 18px; border: 1px dashed #8a7778; border-radius: 8px; color: #473b3d; }
  @media (max-width: 749px) {
    .ai-cosmetics-{{ ai_gen_id }} { padding: 30px 16px; }
    .ai-cosmetics-{{ ai_gen_id }}__products { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .ai-cosmetics-{{ ai_gen_id }}__details { padding: 10px; }
  }
{% endstyle %}

<div class="ai-cosmetics-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-cosmetics-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-cosmetics-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.intro != blank %}<p class="ai-cosmetics-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p>{% endif %}

    {% assign category_collections = block.settings.categories %}
    {% if category_collections != blank %}
      <section class="ai-cosmetics-{{ ai_gen_id }}__group" aria-label="Cosmetics categories">
        <h3 class="ai-cosmetics-{{ ai_gen_id }}__group-title">{{ block.settings.category_label | escape }}</h3>
        {% for collection in category_collections %}
          <div class="ai-cosmetics-{{ ai_gen_id }}__collection">
            <div class="ai-cosmetics-{{ ai_gen_id }}__collection-heading"><h3>{{ collection.title | escape }}</h3><a href="{{ collection.url }}">Explore collection</a></div>
            {% if collection.products.size > 0 %}
              <div class="ai-cosmetics-{{ ai_gen_id }}__products">
                {% for product in collection.products limit: block.settings.products_per_collection %}
                  <article class="ai-cosmetics-{{ ai_gen_id }}__card">
                    <a class="ai-cosmetics-{{ ai_gen_id }}__image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                      {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="600" height="600">{% else %}<div>{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
                    </a>
                    <div class="ai-cosmetics-{{ ai_gen_id }}__details"><a class="ai-cosmetics-{{ ai_gen_id }}__product-name" href="{{ product.url }}">{{ product.title | escape }}</a><p class="ai-cosmetics-{{ ai_gen_id }}__price">{{ product.price | money }}</p></div>
                  </article>
                {% endfor %}
              </div>
            {% else %}<p class="ai-cosmetics-{{ ai_gen_id }}__empty">No products are available in this collection yet.</p>{% endif %}
          </div>
        {% endfor %}
      </section>
    {% endif %}

    {% assign subcategory_collections = block.settings.subcategories %}
    {% if subcategory_collections != blank %}
      <section class="ai-cosmetics-{{ ai_gen_id }}__group" aria-label="Cosmetics subcategories">
        <h3 class="ai-cosmetics-{{ ai_gen_id }}__group-title">{{ block.settings.subcategory_label | escape }}</h3>
        {% for collection in subcategory_collections %}
          <div class="ai-cosmetics-{{ ai_gen_id }}__collection">
            <div class="ai-cosmetics-{{ ai_gen_id }}__collection-heading"><h3>{{ collection.title | escape }}</h3><a href="{{ collection.url }}">Explore collection</a></div>
            {% if collection.products.size > 0 %}
              <div class="ai-cosmetics-{{ ai_gen_id }}__products">
                {% for product in collection.products limit: block.settings.products_per_collection %}
                  <article class="ai-cosmetics-{{ ai_gen_id }}__card">
                    <a class="ai-cosmetics-{{ ai_gen_id }}__image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                      {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="600" height="600">{% else %}<div>{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
                    </a>
                    <div class="ai-cosmetics-{{ ai_gen_id }}__details"><a class="ai-cosmetics-{{ ai_gen_id }}__product-name" href="{{ product.url }}">{{ product.title | escape }}</a><p class="ai-cosmetics-{{ ai_gen_id }}__price">{{ product.price | money }}</p></div>
                  </article>
                {% endfor %}
              </div>
            {% else %}<p class="ai-cosmetics-{{ ai_gen_id }}__empty">No products are available in this collection yet.</p>{% endif %}
          </div>
        {% endfor %}
      </section>
    {% endif %}

    {% if category_collections == blank and subcategory_collections == blank %}<p class="ai-cosmetics-{{ ai_gen_id }}__empty">Choose category and subcategory collections in the theme editor to display products here.</p>{% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Cosmetics collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore cosmetics" },
    { "type": "text", "id": "intro", "label": "Intro text", "default": "Browse beauty categories, discover specialist collections, and shop your favourites." },
    { "type": "header", "content": "Categories" },
    { "type": "text", "id": "category_label", "label": "Category heading", "default": "Shop by category" },
    { "type": "collection_list", "id": "categories", "label": "Category collections", "limit": 8 },
    { "type": "header", "content": "Subcategories" },
    { "type": "text", "id": "subcategory_label", "label": "Subcategory heading", "default": "Explore subcategories" },
    { "type": "collection_list", "id": "subcategories", "label": "Subcategory collections", "limit": 8 },
    { "type": "range", "id": "products_per_collection", "label": "Products per collection", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Cosmetics collections" }],
  "tag": null,
  "class": "cosmetics-collections-block"
}
{% endschema %}