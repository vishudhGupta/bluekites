
{% doc %}
  Product Category Segments
  Standalone Shopify section with collection navigation,
  product cards, image fallbacks and cart functionality.
{% enddoc %}

{% liquid
  assign ai_gen_id = section.id | replace: '_', '' | downcase
%}

{% style %}
  .ai-category-segments-{{ ai_gen_id }} {
    display: block;
    width: {{ section.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 42px 24px;
    color: #37181d;
  }

  .ai-category-segments-{{ ai_gen_id }} *,
  .ai-category-segments-{{ ai_gen_id }} *::before,
  .ai-category-segments-{{ ai_gen_id }} *::after {
    box-sizing: border-box;
  }

  .ai-category-segments-{{ ai_gen_id }}__heading {
    margin: 0 0 30px;
    text-align: center;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.2;
    color: inherit;
  }

  .ai-category-segments-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .ai-category-segments-{{ ai_gen_id }}__category {
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(55, 24, 29, 0.12);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 5px 20px rgba(55, 24, 29, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-category-segments-{{ ai_gen_id }}__category:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(55, 24, 29, 0.10);
  }

  .ai-category-segments-{{ ai_gen_id }}__category-header {
    padding: 18px 16px;
    background: #f8f4f1;
    border-bottom: 1px solid rgba(55, 24, 29, 0.10);
  }

  .ai-category-segments-{{ ai_gen_id }}__category-title {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.35;
  }

  .ai-category-segments-{{ ai_gen_id }}__category-title a {
    color: inherit;
    text-decoration: none;
  }

  .ai-category-segments-{{ ai_gen_id }}__category-title a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .ai-category-segments-{{ ai_gen_id }}__products {
    flex: 1;
    padding: 16px;
    display: grid;
    gap: 22px;
  }

  .ai-category-segments-{{ ai_gen_id }}__product {
    min-width: 0;
  }

  .ai-category-segments-{{ ai_gen_id }}__product-image-link {
    display: block;
    overflow: hidden;
    border-radius: 12px;
    background: #f5f3f1;
  }

  .ai-category-segments-{{ ai_gen_id }}__product-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    padding: 8px;
    transition: transform 0.35s ease;
  }

  .ai-category-segments-{{ ai_gen_id }}__product:hover
  .ai-category-segments-{{ ai_gen_id }}__product-image {
    transform: scale(1.04);
  }

  .ai-category-segments-{{ ai_gen_id }}__image-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f3f1;
  }

  .ai-category-segments-{{ ai_gen_id }}__image-placeholder svg {
    display: block;
    width: 65%;
    height: auto;
  }

  .ai-category-segments-{{ ai_gen_id }}__product-name {
    margin: 12px 0 6px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
  }

  .ai-category-segments-{{ ai_gen_id }}__product-name a {
    color: #37181d;
    text-decoration: none;
  }

  .ai-category-segments-{{ ai_gen_id }}__product-name a:hover {
    text-decoration: underline;
  }

  .ai-category-segments-{{ ai_gen_id }}__price {
    margin-bottom: 12px;
    font-size: 14px;
    font-weight: 600;
  }

  .ai-category-segments-{{ ai_gen_id }}__product-form {
    margin: 0;
  }

  .ai-category-segments-{{ ai_gen_id }}__button {
    width: 100%;
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: 30px;
    background: rgba(55, 24, 29, 0.88);
    color: #fff;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(55, 24, 29, 0.14);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .ai-category-segments-{{ ai_gen_id }}__button:hover {
    background: rgba(38, 14, 18, 0.98);
    color: #fff;
    transform: translateY(-2px);
  }

  .ai-category-segments-{{ ai_gen_id }}__button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    transform: none;
  }

  .ai-category-segments-{{ ai_gen_id }}__explore {
    width: calc(100% - 32px);
    margin: 0 16px 18px;
    background: rgba(255, 255, 255, 0.75);
    color: #37181d;
    border: 1px solid rgba(55, 24, 29, 0.20);
    box-shadow: 0 4px 14px rgba(55, 24, 29, 0.06);
  }

  .ai-category-segments-{{ ai_gen_id }}__explore:hover {
    background: #37181d;
    color: #fff;
  }

  .ai-category-segments-{{ ai_gen_id }}__empty {
    padding: 20px 16px;
    margin: 0;
    color: #76696a;
    font-size: 13px;
    line-height: 1.5;
  }

  .ai-category-segments-{{ ai_gen_id }} a:focus-visible,
  .ai-category-segments-{{ ai_gen_id }} button:focus-visible {
    outline: 3px solid #c3cca6;
    outline-offset: 3px;
  }

  @media screen and (max-width: 1000px) {
    .ai-category-segments-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media screen and (max-width: 560px) {
    .ai-category-segments-{{ ai_gen_id }} {
      width: 100%;
      padding: 28px 16px;
    }

    .ai-category-segments-{{ ai_gen_id }}__heading {
      margin-bottom: 22px;
      font-size: 25px;
    }

    .ai-category-segments-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .ai-category-segments-{{ ai_gen_id }}__category-header {
      padding: 13px 11px;
    }

    .ai-category-segments-{{ ai_gen_id }}__category-title {
      font-size: 15px;
    }

    .ai-category-segments-{{ ai_gen_id }}__products {
      padding: 10px;
      gap: 16px;
    }

    .ai-category-segments-{{ ai_gen_id }}__product-name {
      font-size: 13px;
    }

    .ai-category-segments-{{ ai_gen_id }}__price {
      font-size: 13px;
    }

    .ai-category-segments-{{ ai_gen_id }}__button {
      min-height: 38px;
      padding: 8px 5px;
      font-size: 11px;
    }

    .ai-category-segments-{{ ai_gen_id }}__explore {
      width: calc(100% - 20px);
      margin: 0 10px 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-category-segments-{{ ai_gen_id }}__category,
    .ai-category-segments-{{ ai_gen_id }}__product-image,
    .ai-category-segments-{{ ai_gen_id }}__button {
      transition: none;
    }
  }
{% endstyle %}

<section
  class="ai-category-segments-{{ ai_gen_id }}"
  id="ProductCategories-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  {% if section.settings.heading != blank %}
    <h2 class="ai-category-segments-{{ ai_gen_id }}__heading">
      {{ section.settings.heading | escape }}
    </h2>
  {% endif %}

  <div class="ai-category-segments-{{ ai_gen_id }}__grid">

    {% for i in (1..4) %}

      {% liquid
        assign title_key = 'category_' | append: i | append: '_title'
        assign collection_key = 'category_' | append: i | append: '_collection'

        assign category_title = section.settings[title_key]
        assign category_collection = section.settings[collection_key]
      %}

      <article class="ai-category-segments-{{ ai_gen_id }}__category">

        <div class="ai-category-segments-{{ ai_gen_id }}__category-header">
          <h3 class="ai-category-segments-{{ ai_gen_id }}__category-title">
            {% if category_collection != blank %}
              <a href="{{ category_collection.url }}">
                {{ category_title | escape }}
              </a>
            {% else %}
              {{ category_title | escape }}
            {% endif %}
          </h3>
        </div>

        {% if category_collection != blank %}

          {% if category_collection.products.size > 0 %}

            <div class="ai-category-segments-{{ ai_gen_id }}__products">

              {% for product in category_collection.products limit: 2 %}

                <article class="ai-category-segments-{{ ai_gen_id }}__product">

                  <a
                    href="{{ product.url }}"
                    class="ai-category-segments-{{ ai_gen_id }}__product-image-link"
                    aria-label="View {{ product.title | escape }}"
                  >
                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 600 }}"
                        alt="{{ product.featured_image.alt | default: product.title | escape }}"
                        class="ai-category-segments-{{ ai_gen_id }}__product-image"
                        loading="lazy"
                        width="600"
                        height="450"
                      >
                    {% else %}
                      <div class="ai-category-segments-{{ ai_gen_id }}__image-placeholder">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </a>

                  <h4 class="ai-category-segments-{{ ai_gen_id }}__product-name">
                    <a href="{{ product.url }}">
                      {{ product.title | escape }}
                    </a>
                  </h4>

                  <div class="ai-category-segments-{{ ai_gen_id }}__price">
                    {% if product.price_varies %}
                      From {{ product.price_min | money }}
                    {% else %}
                      {{ product.price | money }}
                    {% endif %}
                  </div>

                  {% if product.available %}

                    {% if product.has_only_default_variant %}

                      {% assign product_form_class = 'ai-category-segments-' | append: ai_gen_id | append: '__product-form' %}

                      {% form 'product', product, class: product_form_class %}

                        <input
                          type="hidden"
                          name="id"
                          value="{{ product.selected_or_first_available_variant.id }}"
                        >

                        <input
                          type="hidden"
                          name="quantity"
                          value="1"
                        >

                        <button
                          type="submit"
                          name="add"
                          class="ai-category-segments-{{ ai_gen_id }}__button"
                        >
                          Add to Cart
                        </button>

                      {% endform %}

                    {% else %}

                      <a
                        href="{{ product.url }}"
                        class="ai-category-segments-{{ ai_gen_id }}__button"
                      >
                        Choose Options
                      </a>

                    {% endif %}

                  {% else %}

                    <button
                      type="button"
                      class="ai-category-segments-{{ ai_gen_id }}__button"
                      disabled
                    >
                      Sold Out
                    </button>

                  {% endif %}

                </article>

              {% endfor %}

            </div>

          {% else %}

            <p class="ai-category-segments-{{ ai_gen_id }}__empty">
              No products available in this collection.
            </p>

          {% endif %}

          <a
            href="{{ category_collection.url }}"
            class="ai-category-segments-{{ ai_gen_id }}__button ai-category-segments-{{ ai_gen_id }}__explore"
          >
            Explore Collection →
          </a>

        {% else %}

          <p class="ai-category-segments-{{ ai_gen_id }}__empty">
            Please select a collection in the theme editor.
          </p>

        {% endif %}

      </article>

    {% endfor %}

  </div>
</section>

{% schema %}
{
  "name": "Product categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Category 1"
    },
    {
      "type": "text",
      "id": "category_1_title",
      "label": "Title",
      "default": "Surgical Products"
    },
    {
      "type": "collection",
      "id": "category_1_collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Category 2"
    },
    {
      "type": "text",
      "id": "category_2_title",
      "label": "Title",
      "default": "Hand Rub & Disinfectants"
    },
    {
      "type": "collection",
      "id": "category_2_collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Category 3"
    },
    {
      "type": "text",
      "id": "category_3_title",
      "label": "Title",
      "default": "Health Care"
    },
    {
      "type": "collection",
      "id": "category_3_collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Category 4"
    },
    {
      "type": "text",
      "id": "category_4_title",
      "label": "Title",
      "default": "Cosmetics"
    },
    {
      "type": "collection",
      "id": "category_4_collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Product categories"
    }
  ]
}
{% endschema %}
