{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block, featured product block, and the product card block.
  The product object is null or when placeholders are rendered.

  @param {object} product - The product object
  @param {object} children - The children of the product card
  @param {object} [block] - The block object
  @param {number} [product_card_gap] - The gap between the product card children (overrides block settings)
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% style %}
  {% if request.visual_preview_mode %}
    product-card[data-product-transition] {
      width: 100%;
      min-width: 250px;
    }
  {% endif %}
{% endstyle %}

{% liquid
  assign has_quick_add = false
  if settings.quick_add and product.available
    assign has_quick_add = true
  endif

  assign has_mobile_quick_add = false
  if has_quick_add and settings.mobile_quick_add
    assign has_mobile_quick_add = true
  endif

  assign product_card_id = 'product-card-link-' | append: block.id | append: '-' | append: product.id
  assign product_card_gap_value = product_card_gap | default: block_settings.product_card_gap

  # Logic to determine which variant URL to use (matching swatch selection logic)
  assign variant_to_link = product.selected_or_first_available_variant

  if settings.transition_to_main_product
    assign featured_image = variant_to_link.featured_image
    if featured_image == blank
      assign featured_image = product.featured_media.preview_image
    endif

    if featured_image != blank
      assign featured_media_url = featured_image | image_url: width: 500
    endif
  endif

  assign onboarding = false
  if product.id == empty or product == blank
    assign onboarding = true
  endif
%}

<product-card
  class="product-card size-style"
  style="{% render 'size-style', settings: block_settings %}"
  data-product-id="{{ product.id }}"
  id="product-card-{{ block.id }}"
  {% if settings.transition_to_main_product %}
    data-product-transition="true"
    data-featured-media-url="{{ featured_media_url }}"
    on:click="/handleViewTransition"
  {% endif %}
  {{ block.shopify_attributes }}
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
>
  <a
    id="{{ product_card_id | md5 }}"
    {% unless onboarding %}
      href="{{ variant_to_link.url }}"
    {% endunless %}
    class="product-card__link"
    ref="productCardLink"
  >
    <span class="visually-hidden">
      {{ product.title }}
    </span>
  </a>
  <div
    class="
      product-card__content
      layout-panel-flex
      layout-panel-flex--column
      product-grid__card
      spacing-style
      border-style
      gap-style
      {% if block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}
    "
    style="
      {% render 'border-override', settings: block_settings %}
      {% render 'layout-panel-style', settings: block_settings %}
      {% render 'spacing-style', settings: block_settings %}
      {% render 'gap-style', value: product_card_gap_value, name: 'product-card-gap' %}
      --quick-add-display: {% if has_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-display: {% if has_mobile_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-opacity: {% if has_mobile_quick_add %}1{% else %}0{% endif %};
      {% if block_settings.padding-inline-start > 0 %}--zoom-out-padding-inline-start: min(var(--padding-xs), {{ block_settings.padding-inline-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-inline-end > 0 %}--zoom-out-padding-inline-end: min(var(--padding-xs), {{ block_settings.padding-inline-end | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-start > 0 %}--zoom-out-padding-block-start: min(var(--padding-xs), {{ block_settings.padding-block-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-end > 0 %}--zoom-out-padding-block-end: min(var(--padding-xs), {{ block_settings.padding-block-end | times: 0.7}}px);{% endif %}
    "
  >
    {{ children }}
  </div>
</product-card>

{% stylesheet %}
  /* Product card — premium olive design */
  .product-card {
    --pc-bg: #343b20;
    --pc-bg-hover: #41492a;
    --pc-text: #ffffff;
    --pc-muted: #d2d7bf;
    --pc-accent: #dfe6bd;
    --pc-radius: 18px;
    --pc-ease: cubic-bezier(0.22, 1, 0.36, 1);

    position: relative;
    z-index: 0;
    min-width: 0;
    isolation: isolate;
  }

  .product-card__content {
    position: relative;
    overflow: hidden;
    gap: 0 !important;
    padding: 10px !important;
    border: 1px solid rgb(255 255 255 / 9%);
    border-radius: var(--pc-radius);
    background: var(--pc-bg);
    color: var(--pc-text);
    box-shadow: 0 5px 16px rgb(25 30 15 / 8%);
    transform: translateZ(0);
    transition:
      background-color 250ms ease,
      box-shadow 350ms var(--pc-ease),
      transform 350ms var(--pc-ease);
  }

  /* Keep the product image as the visual focal point */
  .product-card__content slideshow-component,
  .product-card__content .product-media,
  .product-card__content .card-gallery {
    overflow: hidden;
    border-radius: 12px;
    background: #dce2bd;
  }

  .product-card__content slideshow-component img,
  .product-card__content .product-media img,
  .product-card__content .card-gallery img {
    display: block;
    transition: transform 550ms var(--pc-ease);
    transform-origin: center;
  }

  .product-card__content .product-media img,
  .product-card__content .card-gallery img {
    object-fit: cover;
  }

  /* Product information */
  .product-card__content .product-title,
  .product-card__content .product-title a,
  .product-card__content .product-information,
  .product-card__content .product-information a,
  .product-card__content .product-card__title,
  .product-card__content .product-card__title a {
    color: var(--pc-text);
  }

  .product-card__content .price,
  .product-card__content .price-item,
  .product-card__content .price__regular,
  .product-card__content .price__sale {
    color: var(--pc-text);
  }

  .product-card__content .price-item {
    font-size: 21px;
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.2;
  }

  .product-card__content .price__compare,
  .product-card__content s {
    color: var(--pc-muted);
    opacity: 0.7;
  }

  /* Product badges and secondary labels */
  .product-card__content .badge,
  .product-card__content .product-badge {
    border-color: rgb(255 255 255 / 14%);
    border-radius: 999px;
    font-size: 10px;
  }

  .product-card__content .rating,
  .product-card__content .rating-count,
  .product-card__content .product-card__vendor {
    color: var(--pc-muted);
  }

  /* Quick-add controls */
  .product-card__content .quick-add,
  .product-card__content .quick-add__button {
    border-radius: 999px;
  }

  .product-card__content .button,
  .product-card__content button {
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease;
  }

  /* Hover: subtle lift, no excessive zoom */
  @media (hover: hover) and (pointer: fine) {
    .product-card:hover,
    .product-card:focus-within {
      z-index: 2;
    }

    .product-card:hover .product-card__content,
    .product-card:focus-within .product-card__content {
      background: var(--pc-bg-hover);
      box-shadow: 0 14px 32px rgb(25 30 15 / 18%);
      transform: translateY(-4px);
    }

    .product-card:hover .product-card__content slideshow-component img,
    .product-card:hover .product-card__content .product-media img,
    .product-card:hover .product-card__content .card-gallery img {
      transform: scale(1.035);
    }
  }

  /* Theme editor placeholders */
  .product-card[data-placeholder='true'] .product-card__content {
    transform: none !important;
    box-shadow: none;
  }

  .product-card__placeholder-image svg {
    width: 100%;
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card__content {
      padding: 7px !important;
      border-radius: 14px;
    }

    .product-card__content slideshow-component,
    .product-card__content .product-media,
    .product-card__content .card-gallery {
      border-radius: 9px;
    }

    .product-card__content .price-item {
      font-size: 18px;
    }

    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card__content,
    .product-card__content img,
    .product-card__content button {
      transition: none !important;
    }

    .product-card:hover .product-card__content,
    .product-card:focus-within .product-card__content {
      transform: none;
    }

    .product-card:hover .product-card__content img {
      transform: none;
    }
  }
{% endstylesheet %}