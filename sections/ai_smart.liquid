{% liquid
  assign first_product = section.settings.main_product
  assign second_product = section.settings.second_product
  assign product_count = 0

  if first_product != blank
    assign product_count = product_count | plus: 1
  endif

  if second_product != blank
    assign product_count = product_count | plus: 1
  endif
%}

<section
  id="LastSearched-{{ section.id }}"
  class="last-searched color-{{ section.settings.color_scheme }}"
  style="
    --ls-bg: {{ section.settings.background_color }};
    --ls-heading: {{ section.settings.heading_color }};
    --ls-text: {{ section.settings.text_color }};
    --ls-pill-bg: {{ section.settings.pill_background }};
    --ls-pill-text: {{ section.settings.pill_text_color }};
    --ls-pill-border: {{ section.settings.pill_border_color }};
    --ls-pill-active-bg: {{ section.settings.pill_active_background }};
    --ls-pill-active-text: {{ section.settings.pill_active_text_color }};
    --ls-panel-bg: {{ section.settings.panel_background }};
    --ls-panel-heading: {{ section.settings.panel_heading_color }};
    --ls-card-bg: {{ section.settings.update_card_background }};
    --ls-card-text: {{ section.settings.update_card_text_color }};
    --ls-card-accent: {{ section.settings.update_card_shadow_color }};
    --ls-radius: {{ section.settings.card_radius }}px;
    --ls-pill-radius: {{ section.settings.pill_radius }}px;
    --ls-gap: {{ section.settings.content_gap }}px;
    --ls-padding-top: {{ section.settings.padding_top }}px;
    --ls-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="last-searched__inner">
    <header class="last-searched__header">
      <div class="last-searched__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="last-searched__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="last-searched__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p class="last-searched__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    </header>

    <div class="last-searched__layout">
      <div class="last-searched__main">
        {% assign chip_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'chip' and block.settings.label != blank %}
            {% assign chip_count = chip_count | plus: 1 %}
          {% endif %}
        {% endfor %}

        {% if chip_count > 0 %}
          <div class="last-searched__chips" aria-label="Product highlights">
            <span class="last-searched__sparkle" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 2 1.7 4.3L18 8l-4.3 1.7L12 14l-1.7-4.3L6 8l4.3-1.7L12 2Z"/>
                <path d="m5 14 .9 2.1L8 17l-2.1.9L5 20l-.9-2.1L2 17l2.1-.9L5 14Z"/>
              </svg>
            </span>
            {% for block in section.blocks %}
              {% if block.type == 'chip' and block.settings.label != blank %}
                <span class="last-searched__chip" {{ block.shopify_attributes }}>
                  {{ block.settings.label | escape }}
                </span>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if product_count > 0 %}
          <div class="last-searched__products{% if product_count == 2 %} last-searched__products--two{% endif %}">
            {% for slot in (1..2) %}
              {% liquid
                if slot == 1
                  assign product_item = first_product
                else
                  assign product_item = second_product
                endif
              %}

              {% if product_item != blank %}
                <article class="last-searched__product">
                  <a
                    class="last-searched__product-link"
                    href="{{ product_item.url }}"
                    aria-label="View {{ product_item.title | escape }}"
                  >
                    <div class="last-searched__product-media">
                      {% if product_item.featured_media != blank %}
                        {{
                          product_item.featured_media
                          | image_url: width: 1000
                          | image_tag:
                            widths: '320, 480, 640, 800, 1000',
                            sizes: '(max-width: 749px) 90vw, (max-width: 999px) 44vw, 30vw',
                            class: 'last-searched__image',
                            loading: 'lazy',
                            alt: product_item.featured_media.alt | default: product_item.title
                        }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'last-searched__placeholder' }}
                      {% endif %}

                      {% if product_item.compare_at_price > product_item.price %}
                        <span class="last-searched__badge">Sale</span>
                      {% endif %}
                    </div>

                    <div class="last-searched__product-info">
                      <h3 class="last-searched__product-title">{{ product_item.title | escape }}</h3>
                      <div class="last-searched__price-row">
                        <span class="last-searched__price">{{ product_item.price | money }}</span>
                        {% if product_item.compare_at_price > product_item.price %}
                          <s class="last-searched__compare-price">{{ product_item.compare_at_price | money }}</s>
                        {% endif %}
                      </div>
                    </div>
                  </a>

                  <a class="last-searched__button" href="{{ product_item.url }}">
                    {{ section.settings.button_label | default: 'View product' | escape }}
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M4 10h12M10 4l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        {% else %}
          <div class="last-searched__empty">
            <span class="last-searched__empty-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="10.8" cy="10.8" r="6.8"/>
                <path d="m16 16 4.5 4.5M8 10.8h5.6"/>
              </svg>
            </span>
            <h3>Discover products you'll love</h3>
            <p>Select one or two products in this section's settings to display them here.</p>
          </div>
        {% endif %}
      </div>

      {% assign update_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'update' %}
          {% assign update_count = update_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      {% if section.settings.panel_heading != blank or update_count > 0 %}
        <aside class="last-searched__panel" aria-label="{{ section.settings.panel_heading | escape }}">
          {% if section.settings.panel_heading != blank %}
            <h3 class="last-searched__panel-heading">
              <span class="last-searched__status-dot" aria-hidden="true"></span>
              {{ section.settings.panel_heading | escape }}
            </h3>
          {% endif %}

          {% if update_count > 0 %}
            <div class="last-searched__updates">
              {% for block in section.blocks %}
                {% if block.type == 'update' %}
                  <article class="last-searched__update" {{ block.shopify_attributes }}>
                    <span class="last-searched__update-marker" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m5 12 4 4L19 6"/>
                      </svg>
                    </span>
                    <div class="last-searched__update-content">
                      {% if block.settings.title != blank %}
                        <h4 class="last-searched__update-title">{{ block.settings.title | escape }}</h4>
                      {% endif %}
                      {% if block.settings.text != blank %}
                        <p class="last-searched__update-text">{{ block.settings.text | escape }}</p>
                      {% endif %}
                    </div>
                  </article>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </aside>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .last-searched {
    box-sizing: border-box;
    width: 100%;
    overflow: hidden;
    padding-block: var(--ls-padding-top) var(--ls-padding-bottom);
    background: var(--ls-bg);
    color: var(--ls-text);
  }

  .last-searched *,
  .last-searched *::before,
  .last-searched *::after {
    box-sizing: border-box;
  }

  .last-searched__inner {
    position: relative;
    width: calc(100% - 96px);
    max-width: 1640px;
    margin-inline: auto;
  }

  .last-searched__header {
    margin-bottom: 22px;
  }

  .last-searched__eyebrow {
    margin: 0 0 7px;
    color: var(--ls-heading);
    font-size: 11px;
    font-weight: 650;
    line-height: 1.4;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .last-searched__heading {
    margin: 0;
    color: var(--ls-heading);
    font-size: clamp(24px, 2.5vw, 32px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -.035em;
    text-wrap: balance;
  }

  .last-searched__subheading {
    max-width: 58ch;
    margin: 7px 0 0;
    color: var(--ls-text);
    font-size: 13px;
    line-height: 1.55;
  }

  .last-searched__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(260px, .9fr);
    align-items: stretch;
    gap: 20px;
  }

  .last-searched__main {
    min-width: 0;
  }

  .last-searched__chips {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .last-searched__sparkle {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: 0 0 auto;
    border-radius: 9px;
    background: var(--ls-heading);
    color: #fff;
  }

  .last-searched__sparkle svg {
    width: 17px;
    height: 17px;
  }

  .last-searched__chip {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 6px 11px;
    border: 1px solid var(--ls-pill-border);
    border-radius: var(--ls-pill-radius);
    background: var(--ls-pill-bg);
    color: var(--ls-pill-text);
    font-size: 11px;
    font-weight: 550;
    line-height: 1.25;
  }

  .last-searched__products {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }

  .last-searched__products--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .last-searched__product {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 10px;
    border: 1px solid var(--ls-pill-border);
    border-radius: var(--ls-radius);
    background: #fff;
    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }

  .last-searched__product:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--ls-heading) 28%, var(--ls-pill-border));
    box-shadow: 0 10px 26px rgb(58 30 37 / 7%);
  }

  .last-searched__product-link {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .last-searched__product-link:focus-visible,
  .last-searched__button:focus-visible {
    outline: 2px solid var(--ls-heading);
    outline-offset: 3px;
  }

  .last-searched__product-media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1.18 / 1;
    overflow: hidden;
    border-radius: max(0px, calc(var(--ls-radius) - 4px));
    background: #f7f5f3;
  }

  .last-searched__image,
  .last-searched__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform .35s ease;
  }

  .last-searched__product:hover .last-searched__image {
    transform: scale(1.035);
  }

  .last-searched__badge {
    position: absolute;
    top: 9px;
    left: 9px;
    padding: 5px 8px;
    border-radius: 5px;
    background: var(--ls-heading);
    color: #fff;
    font-size: 10px;
    font-weight: 650;
    line-height: 1;
  }

  .last-searched__product-info {
    display: grid;
    gap: 7px;
    padding: 12px 2px 10px;
  }

  .last-searched__product-title {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--ls-heading);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -.01em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .last-searched__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 7px;
  }

  .last-searched__price {
    color: var(--ls-heading);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  .last-searched__compare-price {
    color: var(--ls-text);
    font-size: 11px;
    opacity: .65;
  }

  .last-searched__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 38px;
    margin-top: auto;
    padding: 9px 12px;
    border: 1px solid var(--ls-heading);
    border-radius: max(4px, calc(var(--ls-radius) - 3px));
    background: var(--ls-heading);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition: background .2s ease, color .2s ease;
  }

  .last-searched__button:hover {
    background: transparent;
    color: var(--ls-heading);
  }

  .last-searched__button svg {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    transition: transform .2s ease;
  }

  .last-searched__button:hover svg {
    transform: translateX(2px);
  }

  .last-searched__panel {
    min-width: 0;
    padding: 20px;
    border: 1px solid var(--ls-pill-border);
    border-radius: var(--ls-radius);
    background: var(--ls-panel-bg);
  }

  .last-searched__panel-heading {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 16px;
    color: var(--ls-panel-heading);
    font-size: 16px;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -.02em;
  }

  .last-searched__status-dot {
    position: relative;
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #319b68;
  }

  .last-searched__status-dot::after {
    position: absolute;
    inset: -3px;
    border: 1px solid #319b68;
    border-radius: inherit;
    content: "";
    opacity: .4;
  }

  .last-searched__updates {
    display: grid;
    gap: 10px;
  }

  .last-searched__update {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    align-items: start;
    gap: 11px;
    padding: 13px;
    border: 1px solid color-mix(in srgb, var(--ls-card-accent) 48%, transparent);
    border-radius: max(4px, calc(var(--ls-radius) - 3px));
    background: var(--ls-card-bg);
  }

  .last-searched__update-marker {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--ls-card-accent) 28%, white);
    color: var(--ls-card-text);
  }

  .last-searched__update-marker svg {
    width: 15px;
    height: 15px;
  }

  .last-searched__update-content {
    min-width: 0;
  }

  .last-searched__update-title {
    margin: 0;
    color: var(--ls-card-text);
    font-size: 12px;
    font-weight: 650;
    line-height: 1.45;
  }

  .last-searched__update-text {
    margin: 4px 0 0;
    color: var(--ls-card-text);
    font-size: 11px;
    line-height: 1.55;
    opacity: .82;
  }

  .last-searched__empty {
    display: grid;
    justify-items: start;
    gap: 8px;
    padding: 28px;
    border: 1px dashed var(--ls-pill-border);
    border-radius: var(--ls-radius);
    background: color-mix(in srgb, var(--ls-panel-bg) 55%, white);
  }

  .last-searched__empty-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--ls-panel-bg);
    color: var(--ls-heading);
  }

  .last-searched__empty-icon svg {
    width: 20px;
    height: 20px;
  }

  .last-searched__empty h3 {
    margin: 0;
    color: var(--ls-heading);
    font-size: 15px;
    font-weight: 650;
  }

  .last-searched__empty p {
    max-width: 42ch;
    margin: 0;
    color: var(--ls-text);
    font-size: 12px;
    line-height: 1.6;
  }

  @media screen and (min-width: 750px) and (max-width: 1100px) {
    .last-searched__inner {
      width: calc(100% - 64px);
    }

    .last-searched__layout {
      grid-template-columns: minmax(0, 1.3fr) minmax(240px, .9fr);
      gap: 16px;
    }

    .last-searched__panel {
      padding: 16px;
    }

    .last-searched__products--two {
      gap: 10px;
    }

    .last-searched__product {
      padding: 8px;
    }
  }

  @media screen and (max-width: 749px) {
    .last-searched__inner {
      width: calc(100% - 48px);
    }

    .last-searched__header {
      margin-bottom: 16px;
    }

    .last-searched__heading {
      font-size: clamp(23px, 6vw, 29px);
    }

    .last-searched__subheading {
      font-size: 12px;
    }

    .last-searched__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    .last-searched__chips {
      gap: 6px;
      margin-bottom: 10px;
    }

    .last-searched__chip {
      min-height: 28px;
      padding: 5px 9px;
      font-size: 10px;
    }

    .last-searched__products {
      gap: 10px;
    }

    .last-searched__products--two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .last-searched__product {
      padding: 7px;
    }

    .last-searched__product-media {
      aspect-ratio: .92 / 1;
    }

    .last-searched__product-info {
      gap: 5px;
      padding: 9px 1px;
    }

    .last-searched__product-title {
      font-size: 12px;
    }

    .last-searched__price {
      font-size: 12px;
    }

    .last-searched__compare-price {
      font-size: 10px;
    }

    .last-searched__button {
      min-height: 35px;
      gap: 5px;
      padding: 8px 5px;
      font-size: 11px;
    }

    .last-searched__panel {
      padding: 15px;
    }

    .last-searched__panel-heading {
      margin-bottom: 12px;
      font-size: 15px;
    }

    .last-searched__updates {
      gap: 8px;
    }

    .last-searched__update {
      padding: 11px;
    }
  }

  @media screen and (max-width: 360px) {
    .last-searched__inner {
      width: calc(100% - 32px);
    }

    .last-searched__products--two {
      grid-template-columns: minmax(0, 1fr);
    }

    .last-searched__product-media {
      aspect-ratio: 1.2 / 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .last-searched *,
    .last-searched *::before,
    .last-searched *::after {
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Last searched products",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above heading",
      "default": "PICKED FOR YOU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Products to explore"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover selected products from the Bluekites collection."
    },
    {
      "type": "product",
      "id": "main_product",
      "label": "First product"
    },
    {
      "type": "product",
      "id": "second_product",
      "label": "Second product (optional)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Product button label",
      "default": "View product"
    },
    {
      "type": "text",
      "id": "panel_heading",
      "label": "Information panel heading",
      "default": "The Bluekites difference"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FCFBFA"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#3A1E25"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Supporting text color",
      "default": "#5C454A"
    },
    {
      "type": "color",
      "id": "pill_background",
      "label": "Highlight background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "pill_text_color",
      "label": "Highlight text",
      "default": "#5A3B41"
    },
    {
      "type": "color",
      "id": "pill_border_color",
      "label": "Border color",
      "default": "#E5DCDD"
    },
    {
      "type": "color",
      "id": "pill_active_background",
      "label": "Active highlight background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "pill_active_text_color",
      "label": "Active highlight text",
      "default": "#3A1E25"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Information panel background",
      "default": "#F8F5F2"
    },
    {
      "type": "color",
      "id": "panel_heading_color",
      "label": "Panel heading color",
