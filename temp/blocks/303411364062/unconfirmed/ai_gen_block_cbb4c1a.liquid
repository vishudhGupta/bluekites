{% doc %}
  @prompt
    Create a new stylish, modern, professional full-width homepage hero for Bluekites Global, inspired by the polished ecommerce promotional layouts of Flipkart and Amazon without copying their branding. The hero must be exactly 35vh tall on desktop and mobile, with compact responsive content and no large minimum height or excessive outside spacing. Design it to sit immediately above the existing Deals of the Day section so both the hero and the start of Deals of the Day are visible together on the initial screen wherever viewport height and the existing header allow. Use an elegant blue gradient with optional background image, a small New Arrivals badge, bold concise headline 'Discover Your Next Favourite', short subtitle, and prominent 'Shop Now' button. Keep the content readable within 35vh on small screens. Allow customization of text, colors, image, button label and link through theme settings. Do not invent discounts or promotional claims. Do not recreate the existing Deals of the Day section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-home-hero-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    height: 35vh;
    min-height: 0;
    overflow: hidden;
    isolation: isolate;
    color: {{ block.settings.text_color }};
    background: linear-gradient(115deg, {{ block.settings.gradient_start }} 0%, {{ block.settings.gradient_end }} 100%);
  }

  .ai-home-hero-{{ ai_gen_id }}__image {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .ai-home-hero-{{ ai_gen_id }}__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-home-hero-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, {{ block.settings.gradient_start }} 0%, {{ block.settings.gradient_end }} 78%);
    opacity: 0.88;
  }

  .ai-home-hero-{{ ai_gen_id }}__content {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: clamp(14px, 3vw, 42px);
  }

  .ai-home-hero-{{ ai_gen_id }}__badge {
    display: inline-flex;
    align-items: center;
    margin: 0 0 clamp(7px, 1.2vh, 12px);
    padding: 5px 11px;
    border-radius: 999px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    font-size: clamp(10px, 1vw, 12px);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .ai-home-hero-{{ ai_gen_id }}__heading {
    max-width: 680px;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: clamp(25px, 4vw, 52px);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .ai-home-hero-{{ ai_gen_id }}__subtitle {
    max-width: 520px;
    margin: clamp(6px, 1.2vh, 12px) 0 0;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: clamp(12px, 1.35vw, 16px);
    line-height: 1.45;
  }

  .ai-home-hero-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    margin-top: clamp(10px, 1.8vh, 18px);
    padding: 9px 22px;
    border: 1px solid {{ block.settings.button_background }};
    border-radius: 999px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .ai-home-hero-{{ ai_gen_id }}__button:hover {
    background: {{ block.settings.button_hover_background }};
    border-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-home-hero-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-home-hero-{{ ai_gen_id }} {
      width: 100%;
      height: 35vh;
    }

    .ai-home-hero-{{ ai_gen_id }}__content {
      padding: 14px 18px;
    }

    .ai-home-hero-{{ ai_gen_id }}__heading {
      max-width: 420px;
      font-size: clamp(24px, 7vw, 36px);
    }

    .ai-home-hero-{{ ai_gen_id }}__subtitle {
      max-width: 360px;
      font-size: 12px;
    }

    .ai-home-hero-{{ ai_gen_id }}__button {
      min-height: 36px;
      margin-top: 9px;
      padding: 8px 18px;
      font-size: 13px;
    }
  }
{% endstyle %}

<div class="ai-home-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.background_image != blank %}
    <div class="ai-home-hero-{{ ai_gen_id }}__image">
      <img src="{{ block.settings.background_image | image_url: width: 2000 }}" alt="{{ block.settings.background_image.alt | escape }}" loading="lazy" width="{{ block.settings.background_image.width }}" height="{{ block.settings.background_image.height }}">
    </div>
  {% endif %}
  <div class="ai-home-hero-{{ ai_gen_id }}__shade" aria-hidden="true"></div>
  <div class="ai-home-hero-{{ ai_gen_id }}__content">
    {% if block.settings.badge_text != blank %}<p class="ai-home-hero-{{ ai_gen_id }}__badge">{{ block.settings.badge_text | escape }}</p>{% endif %}
    <h1 class="ai-home-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h1>
    {% if block.settings.subtitle != blank %}<p class="ai-home-hero-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle | escape }}</p>{% endif %}
    {% if block.settings.button_link != blank %}
      <a class="ai-home-hero-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
    {% else %}
      <span class="ai-home-hero-{{ ai_gen_id }}__button">{{ block.settings.button_label | escape }}</span>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Bluekites home hero",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "badge_text", "label": "Badge", "default": "New arrivals" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Discover Your Next Favourite" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Thoughtful finds for every day, all in one place." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Background and colors" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "color", "id": "gradient_start", "label": "Gradient start", "default": "#102A56" },
    { "type": "color", "id": "gradient_end", "label": "Gradient end", "default": "#1769AA" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "badge_background", "label": "Badge background", "default": "#F4C95D" },
    { "type": "color", "id": "badge_text_color", "label": "Badge text", "default": "#17243A" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#FFFFFF" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#102A56" },
    { "type": "color", "id": "button_hover_background", "label": "Button hover background", "default": "#F4C95D" },
    { "type": "color", "id": "button_hover_text_color", "label": "Button hover text", "default": "#17243A" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [
    { "name": "Bluekites home hero" }
  ],
  "tag": null,
  "class": "bluekites-home-hero-block"
}
{% endschema %}