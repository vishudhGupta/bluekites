{% doc %}
  Header search bar. Always-visible, clean pill-style search field.
  Add it where the theme supports blocks; it does not modify the existing header by itself.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-header-search-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding-block: 10px;
    color: #171717;
    font-family: inherit;
  }

  .ai-header-search-{{ ai_gen_id }}__form {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 6px 0 18px;
    border: 1px solid transparent;
    border-radius: 14px;
    background: #f5f5f5;
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ai-header-search-{{ ai_gen_id }}__form:hover {
    background: #f0f0f0;
  }

  .ai-header-search-{{ ai_gen_id }}__form:focus-within {
    background: #ffffff;
    border-color: #d4d4d4;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .ai-header-search-{{ ai_gen_id }}__icon {
    display: inline-flex;
    flex: 0 0 auto;
    color: #7a7a7a;
  }

  .ai-header-search-{{ ai_gen_id }}__icon svg {
    width: 20px;
    height: 20px;
  }

  .ai-header-search-{{ ai_gen_id }}__input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: 0;
    padding: 0;
    background: transparent;
    color: #171717;
    font: inherit;
    font-size: 16px;
    letter-spacing: 0.01em;
    box-shadow: none;
  }

  .ai-header-search-{{ ai_gen_id }}__input::placeholder {
    color: #8a8a8a;
    opacity: 1;
  }

  .ai-header-search-{{ ai_gen_id }}__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .ai-header-search-{{ ai_gen_id }}__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    height: 36px;
    padding: 0 18px;
    border: 0;
    border-radius: 10px;
    background: #171717;
    color: #ffffff;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }

  .ai-header-search-{{ ai_gen_id }}__submit:hover {
    background: #333333;
  }

  .ai-header-search-{{ ai_gen_id }}__submit:active {
    transform: scale(0.97);
  }

  .ai-header-search-{{ ai_gen_id }} button:focus-visible {
    outline: 2px solid #171717;
    outline-offset: 2px;
  }

  .ai-header-search-{{ ai_gen_id }} .ai-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-header-search-{{ ai_gen_id }} {
      width: 100%;
      padding-block: 8px;
    }

    .ai-header-search-{{ ai_gen_id }}__form {
      height: 44px;
      padding-left: 14px;
    }

    .ai-header-search-{{ ai_gen_id }}__input {
      font-size: 16px; /* keeps iOS from zooming on focus */
    }

    .ai-header-search-{{ ai_gen_id }}__submit {
      height: 32px;
      padding: 0 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-header-search-{{ ai_gen_id }}__form,
    .ai-header-search-{{ ai_gen_id }}__submit {
      transition: none;
    }
  }
{% endstyle %}

<div class="ai-header-search-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <form
    class="ai-header-search-{{ ai_gen_id }}__form"
    action="{{ routes.search_url }}"
    method="get"
    role="search"
  >
    <span class="ai-header-search-{{ ai_gen_id }}__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <circle cx="10.8" cy="10.8" r="6.8"></circle>
        <path d="m16 16 4.2 4.2"></path>
      </svg>
    </span>

    <label class="ai-visually-hidden" for="ai-header-search-input-{{ ai_gen_id }}">Search products</label>
    <input
      id="ai-header-search-input-{{ ai_gen_id }}"
      class="ai-header-search-{{ ai_gen_id }}__input"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ block.settings.placeholder | escape }}"
      autocomplete="off"
    >
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">

    <button class="ai-header-search-{{ ai_gen_id }}__submit" type="submit">Search</button>
  </form>
</div>

{% schema %}
{
  "name": "Header search bar",
  "settings": [
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder text",
      "default": "Search..."
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Header search bar"
    }
  ],
  "tag": null,
  "class": "header-search-row"
}
{% endschema %}