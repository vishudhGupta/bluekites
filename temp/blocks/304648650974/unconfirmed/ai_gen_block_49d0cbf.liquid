{% doc %}
  @prompt
    Create a new section at the bottom of the surgical-products collection page, above the footer, matching the current theme. Include a clearly visible button labeled Download PDF. Provide an editable PDF URL setting so the merchant can connect their PDF file. When a valid PDF URL is configured, make the button link to that actual file and request a download where browser support allows. Do not use a fake link or fabricate a PDF; when no URL is set, show an editor-only instruction to connect a PDF and do not show visitors a broken or nonfunctional button. Keep button label, spacing, and alignment editable and make the section mobile friendly and accessible.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pdf-download-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: {{ block.settings.vertical_spacing }}px 20px;
    text-align: {{ block.settings.alignment }};
    color: rgb(var(--color-foreground, 0 0 0));
    background: rgb(var(--color-background, 255 255 255));
  }

  .ai-pdf-download-{{ ai_gen_id }}__inner {
    width: 100%;
    margin: 0 auto;
    display: flex;
    justify-content: {% if block.settings.alignment == 'left' %}flex-start{% elsif block.settings.alignment == 'right' %}flex-end{% else %}center{% endif %};
  }

  .ai-pdf-download-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    max-width: 100%;
    padding: 13px 28px;
    border: 1px solid rgb(var(--color-primary-button-border, 0 0 0));
    border-radius: var(--style-border-radius-buttons-primary, 999px);
    background: rgb(var(--color-primary-button-background, 195 204 166));
    color: rgb(var(--color-primary-button-text, 0 0 0));
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    line-height: 1.25;
    cursor: pointer;
    text-align: center;
  }

  .ai-pdf-download-{{ ai_gen_id }}__button:hover {
    background: rgb(var(--color-primary-button-hover-background, 0 0 0));
    color: rgb(var(--color-primary-button-hover-text, 255 255 255));
    border-color: rgb(var(--color-primary-button-hover-border, 0 0 0));
  }

  .ai-pdf-download-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }

  .ai-pdf-download-{{ ai_gen_id }}__instruction {
    margin: 0;
    padding: 12px 16px;
    border: 1px solid currentColor;
    border-radius: 4px;
    font-size: 14px;
    line-height: 1.5;
  }

  .ai-pdf-download-{{ ai_gen_id }}__icon {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }

  @media screen and (max-width: 749px) {
    .ai-pdf-download-{{ ai_gen_id }} {
      width: 100%;
      padding-right: 16px;
      padding-left: 16px;
    }
  }
{% endstyle %}

<div class="ai-pdf-download-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-pdf-download-{{ ai_gen_id }}__inner">
    {% if block.settings.pdf_url != blank %}
      {% assign pdf_path = block.settings.pdf_url | downcase | split: '?' | first | split: '#' | first %}
      {% assign pdf_extension = pdf_path | split: '.' | last %}
      {% if pdf_extension == 'pdf' %}
        <a class="ai-pdf-download-{{ ai_gen_id }}__button" href="{{ block.settings.pdf_url }}" download aria-label="{{ block.settings.button_label | escape }}">
          <svg class="ai-pdf-download-{{ ai_gen_id }}__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <path d="m7 10 5 5 5-5"/>
            <path d="M12 15V3"/>
          </svg>
          <span>{{ block.settings.button_label | escape }}</span>
        </a>
      {% elsif request.design_mode %}
        <p class="ai-pdf-download-{{ ai_gen_id }}__instruction" role="status">Connect a direct PDF file URL in this block's settings to show the download button.</p>
      {% endif %}
    {% elsif request.design_mode %}
      <p class="ai-pdf-download-{{ ai_gen_id }}__instruction" role="status">Add a direct PDF file URL in this block's settings. The download button will appear for visitors once configured.</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "PDF download button",
  "settings": [
    {
      "type": "url",
      "id": "pdf_url",
      "label": "PDF file URL"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Download PDF"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "vertical_spacing",
      "label": "Vertical spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "PDF download button"
    }
  ],
  "tag": null,
  "class": "pdf-download-button-block"
}
{% endschema %}