{% doc %}
  @prompt
    Create a complete new product information section for the current product template. Use a polished, compact ecommerce layout matching the existing theme. Perfectly align the product media and information columns on desktop, with consistent spacing, aligned headings, price, variant controls, quantity and purchase buttons; stack cleanly on mobile without overflow. Use the current product's real dynamic content and functional product form, not sample content. Include a description area and an accessible accordion labeled Details. When the product description includes a heading named Specification or Specifications (case-insensitive), display that heading's content under the Details accordion instead of duplicating it in the visible description. Preserve formatted paragraphs, lists and tables, and keep subsequent unrelated heading sections in the description. If no specification heading exists, preserve the full description and hide an empty Details accordion. Do not modify saved product descriptions. Make labels, spacing and layout options editable. Ensure accessible accordion keyboard controls and responsive tables.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture form_class %}ai-product-info-{{ ai_gen_id }}__form{% endcapture %}
{% style %}
.ai-product-info-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin-inline:auto;color:#171717}.ai-product-info-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.86fr);gap:{{ block.settings.column_gap }}px;align-items:start}.ai-product-info-{{ ai_gen_id }}__media{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;min-width:0}.ai-product-info-{{ ai_gen_id }}__media-item{overflow:hidden;background:#f6f6f4;border-radius:10px}.ai-product-info-{{ ai_gen_id }}__media-item img,.ai-product-info-{{ ai_gen_id }}__placeholder svg{display:block;width:100%;height:auto;object-fit:cover}.ai-product-info-{{ ai_gen_id }}__placeholder{width:100%;aspect-ratio:1;display:grid;place-items:center;background:#f6f6f4}.ai-product-info-{{ ai_gen_id }}__placeholder svg{height:100%}.ai-product-info-{{ ai_gen_id }}__details{position:sticky;top:24px;min-width:0}.ai-product-info-{{ ai_gen_id }}__vendor{margin:0 0 8px;font-size:12px;letter-spacing:.08em;text-transform:uppercase}.ai-product-info-{{ ai_gen_id }}__title{margin:0 0 12px;font-size:clamp(24px,3vw,36px);line-height:1.15}.ai-product-info-{{ ai_gen_id }}__price{margin:0 0 22px;font-size:20px;font-weight:600}.ai-product-info-{{ ai_gen_id }}__compare{margin-inline-start:8px;color:#595959;font-size:14px;font-weight:400}.ai-product-info-{{ ai_gen_id }}__form{display:grid;gap:14px}.ai-product-info-{{ ai_gen_id }}__label{display:block;margin-bottom:6px;font-size:13px;font-weight:600}.ai-product-info-{{ ai_gen_id }}__select,.ai-product-info-{{ ai_gen_id }}__quantity{width:100%;min-height:46px;padding:10px 12px;color:#171717;background:#fff;border:1px solid #767676;border-radius:6px;font:inherit}.ai-product-info-{{ ai_gen_id }}__quantity{max-width:100px}.ai-product-info-{{ ai_gen_id }}__button{width:100%;min-height:48px;padding:12px 18px;border:1px solid #000f9f;border-radius:24px;color:#fff;background:#000f9f;font:inherit;font-weight:600;cursor:pointer}.ai-product-info-{{ ai_gen_id }}__button:hover{background:#000;border-color:#000}.ai-product-info-{{ ai_gen_id }}__button:disabled{opacity:.55;cursor:not-allowed}.ai-product-info-{{ ai_gen_id }}__description{margin-top:24px;line-height:1.65;overflow-wrap:anywhere}.ai-product-info-{{ ai_gen_id }}__description img{max-width:100%;height:auto}.ai-product-info-{{ ai_gen_id }}__description table,.ai-product-info-{{ ai_gen_id }}__spec-content table{display:block;max-width:100%;overflow-x:auto;border-collapse:collapse}.ai-product-info-{{ ai_gen_id }}__accordion{margin-top:18px;border-block:1px solid #d8d8d8}.ai-product-info-{{ ai_gen_id }}__accordion[hidden],.ai-product-info-{{ ai_gen_id }}__accordion-panel[hidden]{display:none}.ai-product-info-{{ ai_gen_id }}__accordion-button{width:100%;padding:15px 0;display:flex;justify-content:space-between;align-items:center;gap:12px;text-align:left;color:inherit;background:transparent;border:0;font:inherit;font-weight:600;cursor:pointer}.ai-product-info-{{ ai_gen_id }}__accordion-button:focus-visible,.ai-product-info-{{ ai_gen_id }}__select:focus-visible,.ai-product-info-{{ ai_gen_id }}__quantity:focus-visible,.ai-product-info-{{ ai_gen_id }}__button:focus-visible{outline:3px solid #000f9f;outline-offset:3px}.ai-product-info-{{ ai_gen_id }}__accordion-panel{padding:0 0 16px;line-height:1.6;overflow-wrap:anywhere}.ai-product-info-{{ ai_gen_id }}__error{color:#9b1c1c}@media(max-width:749px){.ai-product-info-{{ ai_gen_id }}{width:100%}.ai-product-info-{{ ai_gen_id }}__grid{grid-template-columns:minmax(0,1fr);gap:22px}.ai-product-info-{{ ai_gen_id }}__details{position:static}}
{% endstyle %}
<product-info-{{ ai_gen_id }} class="ai-product-info-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
{% if product != blank %}<div class="ai-product-info-{{ ai_gen_id }}__grid"><div class="ai-product-info-{{ ai_gen_id }}__media" aria-label="Product images">{% for media in product.media %}{% if media.media_type == 'image' %}<div class="ai-product-info-{{ ai_gen_id }}__media-item"><img src="{{ media | image_url: width: 1200 }}" alt="{{ media.alt | default: product.title | escape }}" width="{{ media.width }}" height="{{ media.height }}" loading="lazy"></div>{% endif %}{% endfor %}{% if product.media.size == 0 %}<div class="ai-product-info-{{ ai_gen_id }}__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-product-info-{{ ai_gen_id }}__details">{% if block.settings.show_vendor and product.vendor != blank %}<p class="ai-product-info-{{ ai_gen_id }}__vendor">{{ product.vendor | escape }}</p>{% endif %}<h1 class="ai-product-info-{{ ai_gen_id }}__title">{{ product.title | escape }}</h1><p class="ai-product-info-{{ ai_gen_id }}__price" data-price>{{ product.selected_or_first_available_variant.price | money }}{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<s class="ai-product-info-{{ ai_gen_id }}__compare" data-compare>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>{% else %}<s class="ai-product-info-{{ ai_gen_id }}__compare" data-compare hidden></s>{% endif %}</p>
{% form 'product', product, class: form_class %}{% if product.has_only_default_variant == false %}<div><label class="ai-product-info-{{ ai_gen_id }}__label" for="variant-{{ ai_gen_id }}">{{ block.settings.variant_label | escape }}</label><select id="variant-{{ ai_gen_id }}" name="id" class="ai-product-info-{{ ai_gen_id }}__select" data-variant>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" {% if variant.id == product.selected_or_first_available_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} — {{ block.settings.sold_out_label | escape }}{% endunless %}</option>{% endfor %}</select></div>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant>{% endif %}<div><label class="ai-product-info-{{ ai_gen_id }}__label" for="quantity-{{ ai_gen_id }}">{{ block.settings.quantity_label | escape }}</label><input id="quantity-{{ ai_gen_id }}" class="ai-product-info-{{ ai_gen_id }}__quantity" type="number" name="quantity" value="1" min="1" step="1"></div><button class="ai-product-info-{{ ai_gen_id }}__button" type="submit" name="add" data-submit {% unless product.available %}disabled{% endunless %}>{% if product.available %}{{ block.settings.add_label | escape }}{% else %}{{ block.settings.sold_out_label | escape }}{% endif %}</button>{% endform %}
{% if product.description != blank %}<div class="ai-product-info-{{ ai_gen_id }}__description" data-description>{{ product.description }}</div>{% endif %}<div class="ai-product-info-{{ ai_gen_id }}__accordion" data-accordion hidden><button class="ai-product-info-{{ ai_gen_id }}__accordion-button" type="button" aria-expanded="false" aria-controls="spec-panel-{{ ai_gen_id }}" data-accordion-button>{{ block.settings.details_label | escape }}<span aria-hidden="true" data-chevron>+</span></button><div class="ai-product-info-{{ ai_gen_id }}__accordion-panel" id="spec-panel-{{ ai_gen_id }}" data-panel hidden><div class="ai-product-info-{{ ai_gen_id }}__spec-content" data-spec-content></div></div></div></div></div>{% else %}<div class="ai-product-info-{{ ai_gen_id }}__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>{% endif %}</product-info-{{ ai_gen_id }}>
<script>(()=>{const tag='product-info-{{ ai_gen_id }}';if(customElements.get(tag))return;class ProductInfo extends HTMLElement{connectedCallback(){const d=this.querySelector('[data-description]'),a=this.querySelector('[data-accordion]');if(d&&a){let extracting=false,found=false;const target=this.querySelector('[data-spec-content]');Array.from(d.childNodes).forEach(n=>{if(n.nodeType===1&&/^H[1-6]$/.test(n.tagName)){const t=n.textContent.trim().replace(/\s+/g,' ').toLowerCase();if(t==='specification'||t==='specifications'){extracting=true;found=true;n.remove();return}if(extracting)extracting=false}if(extracting)target.appendChild(n)});if(found)a.hidden=false;else a.remove()}const b=this.querySelector('[data-accordion-button]'),p=this.querySelector('[data-panel]');if(b&&p)b.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!open));p.hidden=open;b.querySelector('[data-chevron]').textContent=open?'+':'−'});const s=this.querySelector('select[data-variant]');if(s)s.addEventListener('change',()=>this.update(s.selectedOptions[0]))}update(o){const price=this.querySelector('[data-price]'),compare=this.querySelector('[data-compare]'),submit=this.querySelector('[data-submit]');if(!o)return;const amount=Number(o.dataset.price),old=Number(o.dataset.compare),available=o.dataset.available==='true';if(price){price.childNodes[0].textContent=new Intl.NumberFormat('{{ request.locale.iso_code | escape }}',{style:'currency',currency:'{{ cart.currency.iso_code | default: shop.currency | escape }}'}).format(amount/100);if(compare){compare.hidden=old<=amount;compare.textContent=old>amount?new Intl.NumberFormat('{{ request.locale.iso_code | escape }}',{style:'currency',currency:'{{ cart.currency.iso_code | default: shop.currency | escape }}'}).format(old/100):''}}if(submit){submit.disabled=!available;submit.textContent=available?'{{ block.settings.add_label | escape }}':'{{ block.settings.sold_out_label | escape }}'}}}customElements.define(tag,ProductInfo)})();</script>
{% schema %}{"name":"Product information","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"column_gap","label":"Column spacing","min":16,"max":64,"step":4,"unit":"px","default":40},{"type":"checkbox","id":"show_vendor","label":"Show vendor","default":true},{"type":"header","content":"Product form"},{"type":"text","id":"variant_label","label":"Variant label","default":"Options"},{"type":"text","id":"quantity_label","label":"Quantity label","default":"Quantity"},{"type":"text","id":"add_label","label":"Purchase button","default":"Add to cart"},{"type":"text","id":"sold_out_label","label":"Unavailable label","default":"Sold out"},{"type":"header","content":"Description"},{"type":"text","id":"details_label","label":"Accordion label","default":"Details"}],"presets":[{"name":"Product information"}],"tag":null,"class":"product-information-block"}{% endschema %}