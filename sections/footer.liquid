<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} bk-footer"
>
  {% liquid
    assign total_blocks = section.blocks.size
    assign grid_columns = total_blocks | at_most: 4
    assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 4 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}

  <div
    class="
      footer-content
      bk-footer__content
      spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
    "
  >
    {% content_for 'blocks' %}
  </div>

  <div class="bk-footer__bottom">
    <p class="bk-footer__copyright">© {{ 'now' | date: '%Y' }} Bluekites. All rights reserved.</p>
    {% if shop.policies.size > 0 %}
      <nav class="bk-footer__legal" aria-label="Legal">
        {% for policy in shop.policies %}
          {% if policy != blank %}
            <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
          {% endif %}
        {% endfor %}
      </nav>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  /* Full-bleed footer background; keep all existing Shopify content blocks intact. */
  .section.bk-footer {
    width: 100vw !important;
    max-width: none !important;
    margin-inline: calc(50% - 50vw) !important;
    padding-inline: 0 !important;
    overflow: hidden;
  }

  .bk-footer {
    --bk-footer-bg: #10363d;
    --bk-footer-bg-deep: #0c2e35;
    --bk-footer-text: #d1e0e2;
    --bk-footer-heading: #f6fbfb;
    --bk-footer-muted: #b5cbd0;
    --bk-footer-line: rgba(207, 226, 229, .18);
    --bk-footer-accent: #b98245;
    position: relative;
    isolation: isolate;
    color: var(--bk-footer-text);
    background: var(--bk-footer-bg) !important;
    border: 0 !important;
  }

  .bk-footer,
  .bk-footer * { box-sizing: border-box; }

  .bk-footer .bk-footer__content {
    display: grid;
    grid-template-columns: minmax(250px, 1.35fr) minmax(170px, .8fr) minmax(170px, .8fr) minmax(250px, 1.05fr);
    align-items: start;
    gap: clamp(30px, 4vw, 76px);
    width: min(100% - 112px, 1740px);
    max-width: 1740px;
    margin-inline: auto;
    padding: clamp(58px, 6vw, 100px) 0 clamp(44px, 5vw, 76px);
    contain: none;
    content-visibility: visible;
  }

  .bk-footer .bk-footer__content > * {
    min-width: 0;
    align-self: start;
    justify-self: stretch;
  }

    /* Desktop: logo + social stacked in column 1, no empty space under the logo */
  @media screen and (min-width: 1100px) {
    .bk-footer .bk-footer__content {
      grid-template-rows: auto auto 1fr;
      row-gap: 24px;
    }
    .bk-footer .bk-footer__content > :nth-child(1) { grid-column: 1; grid-row: 1; }       /* Logo */
    .bk-footer .bk-footer__content > :nth-child(2) { grid-column: 2; grid-row: 1 / -1; }  /* Quick Links */
    .bk-footer .bk-footer__content > :nth-child(3) { grid-column: 3; grid-row: 1 / -1; }  /* Services */
    .bk-footer .bk-footer__content > :nth-child(4) { grid-column: 4; grid-row: 1 / -1; }  /* Contact Us */
    .bk-footer .bk-footer__content > :nth-child(5) { grid-column: 1; grid-row: 2; }       /* Social icons */
    .bk-footer .bk-footer__content > :nth-child(6) { grid-column: 1; grid-row: 3; }       /* Any extra block */
  }

  .bk-footer .bk-footer__content h2,
  .bk-footer .bk-footer__content h3,
  .bk-footer .bk-footer__content h4,
  .bk-footer .bk-footer__content .menu__heading,
  .bk-footer .bk-footer__content .menu__heading__default {
    position: relative;
    margin: 0 0 28px;
    padding: 0 0 14px;
    color: var(--bk-footer-heading) !important;
    font-family: inherit;
    font-size: clamp(20px, 1.35vw, 26px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -.02em;
    text-wrap: balance;
  }

  .bk-footer .bk-footer__content h2::after,
  .bk-footer .bk-footer__content h3::after,
  .bk-footer .bk-footer__content h4::after,
  .bk-footer .bk-footer__content .menu__heading::after,
  .bk-footer .bk-footer__content .menu__heading__default::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    bottom: 0;
    width: 34px;
    height: 2px;
    border-radius: 2px;
    background: var(--bk-footer-accent);
  }

  .bk-footer .bk-footer__content p {
    margin: 0 0 18px;
    color: var(--bk-footer-muted) !important;
    font-size: 14px;
    line-height: 1.8;
  }

  .bk-footer .bk-footer__content a {
    color: var(--bk-footer-text) !important;
    text-decoration: none;
    text-underline-offset: 4px;
    transition: color 180ms ease, opacity 180ms ease;
  }

  .bk-footer .bk-footer__content a:hover {
    color: #e2b77f !important;
    text-decoration: none;
  }

  .bk-footer .bk-footer__content a:focus-visible,
  .bk-footer__bottom a:focus-visible {
    outline: 2px solid var(--bk-footer-accent);
    outline-offset: 4px;
    border-radius: 3px;
  }

  .bk-footer .bk-footer__content ul,
  .bk-footer .bk-footer__content ol {
    display: grid;
    gap: 15px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bk-footer .bk-footer__content li {
    margin: 0;
    color: var(--bk-footer-text);
    font-size: 14px;
    line-height: 1.6;
  }

  /* Preserve the theme's configured logo dimensions; only prevent overflow. */
  .bk-footer .bk-footer__content img,
  .bk-footer .bk-footer__content svg {
    max-width: 100%;
  }

  .bk-footer .bk-footer__content input:not([type='checkbox']):not([type='radio']),
  .bk-footer .bk-footer__content select,
  .bk-footer .bk-footer__content textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 15px;
    border: 1px solid rgba(207, 226, 229, .35);
    border-radius: 2px;
    background: #f7f8f6;
    color: #183a40;
    font: inherit;
  }

  .bk-footer .bk-footer__content button,
  .bk-footer .bk-footer__content input[type='submit'] {
    min-height: 46px;
    padding: 11px 20px;
    border: 1px solid var(--bk-footer-accent);
    border-radius: 2px;
    background: var(--bk-footer-accent);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 180ms ease, transform 180ms ease;
  }

  .bk-footer .bk-footer__content button:hover,
  .bk-footer .bk-footer__content input[type='submit']:hover {
    background: #a56f37;
    transform: translateY(-1px);
  }

  .bk-footer .bk-footer__content .social-links,
  .bk-footer .bk-footer__content .social-links__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .bk-footer .bk-footer__content .social-links a,
  .bk-footer .bk-footer__content .social-links__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--bk-footer-line);
    border-radius: 50%;
    background: transparent;
    color: var(--bk-footer-heading) !important;
  }

  .bk-footer .bk-footer__content .social-links a:hover,
  .bk-footer .bk-footer__content .social-links__link:hover {
    border-color: var(--bk-footer-accent);
    background: var(--bk-footer-accent);
    color: #fff !important;
  }

  .bk-footer .bk-footer__content .payment-icons,
  .bk-footer .bk-footer__content .list-payment {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .bk-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 14px 28px;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 24px max(56px, calc((100% - 1740px) / 2));
    border-top: 1px solid var(--bk-footer-line);
    background: var(--bk-footer-bg-deep);
  }

  .bk-footer__copyright {
    margin: 0;
    color: var(--bk-footer-muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .bk-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }

  .bk-footer__legal a {
    color: var(--bk-footer-muted) !important;
    font-size: 13px;
    line-height: 1.6;
    text-decoration: none;
  }

  .bk-footer__legal a:hover {
    color: #e2b77f !important;
  }

  @media screen and (min-width: 750px) and (max-width: 1099px) {
    .bk-footer .bk-footer__content {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 42px 48px;
      width: calc(100% - 72px);
      padding-block: 54px 44px;
    }
    .bk-footer__bottom { padding-inline: 36px; }
  }

  @media screen and (max-width: 749px) {
    .bk-footer .bk-footer__content {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px 24px;
      width: calc(100% - 40px);
      padding-block: 42px 34px;
    }
    .bk-footer .bk-footer__content h2,
    .bk-footer .bk-footer__content h3,
    .bk-footer .bk-footer__content h4,
    .bk-footer .bk-footer__content .menu__heading,
    .bk-footer .bk-footer__content .menu__heading__default {
      margin-bottom: 20px;
      font-size: 20px;
    }
    .bk-footer .bk-footer__content p,
    .bk-footer .bk-footer__content li { font-size: 13px; }
    .bk-footer .bk-footer__content ul,
    .bk-footer .bk-footer__content ol { gap: 12px; }
    .bk-footer__bottom {
      justify-content: center;
      text-align: center;
      padding: 20px;
    }
    .bk-footer__legal { justify-content: center; }
  }

  @media screen and (max-width: 480px) {
    .bk-footer .bk-footer__content {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
      width: calc(100% - 40px);
    }
    .bk-footer .bk-footer__content > * { width: 100%; }
    .bk-footer__bottom { padding-inline: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bk-footer *, .bk-footer *::before, .bk-footer *::after {
      scroll-behavior: auto !important;
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "blocks": [
    { "type": "_divider" },
    { "type": "@app" },
    { "type": "button" },
    { "type": "follow-on-shop" },
    { "type": "group" },
    { "type": "icon" },
    { "type": "image" },
    { "type": "menu" },
    { "type": "payment-icons" },
    { "type": "text" },
    { "type": "logo" },
    { "type": "jumbo-text" },
    { "type": "social-links" },
    { "type": "email-signup" }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer",
      "settings": {
        "gap": 0,
        "color_scheme": "scheme-1",
        "padding-block-start": 20,
        "padding-block-end": 20
      },
      "blocks": {
        "newsletter-group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "gap": 6,
            "width": "fill",
            "inherit_color_scheme": true
          },
          "blocks": {
            "newsletter-heading": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.join_our_email_list",
                "width": "100%",
                "alignment": "left",
                "type_preset": "h3"
              }
            },
            "newsletter-text": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.get_exclusive_deals_and_early_access_to_new_products",
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte"
              }
            }
          },
          "block_order": ["newsletter-heading", "newsletter-text"]
        },
        "newsletter-form": {
          "type": "email-signup",
          "settings": {
            "width": "fill"
          }
        }
      },
      "block_order": ["newsletter-group", "newsletter-form"]
    }
  ]
}
{% endschema %}
