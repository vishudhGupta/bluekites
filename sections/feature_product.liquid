{%- liquid
  assign add_label = section.settings.button_label | default: 'Add to cart'

  case section.settings.color_palette
    when 'amber'
      assign c_bg = '#FFF9E8'
      assign c_head = '#FDC656'
      assign c_head_text = '#171717'
      assign c_btn = '#000000'
      assign c_btn_text = '#FFFFFF'
    when 'mauve'
      assign c_bg = '#F7F0F2'
      assign c_head = '#745862'
      assign c_head_text = '#FFFFFF'
      assign c_btn = '#3F2A31'
      assign c_btn_text = '#FFFFFF'
    when 'custom'
      assign c_bg = section.settings.section_background
      assign c_head = section.settings.header_background
      assign c_head_text = section.settings.header_text
      assign c_btn = section.settings.button_background
      assign c_btn_text = section.settings.button_text
    else
      assign c_bg = '#EEF5FB'
      assign c_head = '#800000'
      assign c_head_text = '#FFFFFF'
      assign c_btn = '#102A56'
      assign c_btn_text = '#FFFFFF'
  endcase

  assign has_products = false
  for block in section.blocks
    if block.settings.product != blank
      assign has_products = true
      break
    endif
  endfor
-%}

{%- if has_products or request.design_mode -%}
  <div
    id="FeatureProducts-{{ section.id }}"
    class="fp-section"
    style="
      --fp-bg: {{ c_bg }};
      --fp-header-bg: {{ c_head }};
      --fp-header-text: {{ c_head_text }};
      --fp-btn-bg: {{ c_btn }};
      --fp-btn-text: {{ c_btn_text }};
      --fp-card-w: {{ section.settings.card_width }}px;
      --fp-gap: {{ section.settings.card_gap }}px;
      --fp-card-radius: {{ section.settings.card_radius }}px;
      --fp-pad-top: {{ section.settings.padding_top }}px;
      --fp-pad-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="page-width-normal fp__inner">
      <bk-featured-strip
        class="fp{% if section.settings.show_arrows %} fp--arrows{% endif %}"
        {% if section.settings.show_timer %}data-end="{{ section.settings.end_time | escape }}"{% endif %}
      >
        <header class="fp__header">
          <div class="fp__head-text">
            {%- if section.settings.heading != blank -%}
              <h2 class="fp__title">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.subheading != blank -%}
              <p class="fp__subtitle">{{ section.settings.subheading | escape }}</p>
            {%- endif -%}
          </div>

          {%- if section.settings.show_timer or section.settings.view_all_url != blank -%}
            <div class="fp__head-actions">
              {%- if section.settings.show_timer -%}
                <div class="fp__timer-wrap">
                  <div class="fp__timer" role="timer" aria-label="Time left" aria-live="off">
                    <span class="fp__unit" data-hours>00</span><span aria-hidden="true">:</span><span class="fp__unit" data-minutes>00</span><span aria-hidden="true">:</span><span class="fp__unit" data-seconds>00</span>
                  </div>
                </div>
              {%- endif -%}
              {%- if section.settings.view_all_url != blank -%}
                <a class="fp__view-all" href="{{ section.settings.view_all_url }}">
                  {{- section.settings.view_all_label | default: 'View all' | escape -}}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </header>

        <div class="fp__body">
          {%- if has_products -%}
            <button class="fp__arrow fp__arrow--prev" type="button" data-prev aria-label="Previous products" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>
            </button>

            <div class="fp__track" data-track tabindex="0" role="region" aria-label="{{ section.settings.heading | default: 'Featured products' | escape }}">
              {%- for block in section.blocks -%}
                {%- assign product = block.settings.product -%}
                {%- if product != blank -%}
                  {%- assign variant = product.selected_or_first_available_variant -%}
                  {%- assign has_discount = false -%}
                  {%- assign discount_percent = 0 -%}
                  {%- if variant.compare_at_price > variant.price and variant.compare_at_price > 0 and product.price_varies == false -%}
                    {%- assign has_discount = true -%}
                    {%- assign discount_amount = variant.compare_at_price | minus: variant.price -%}
                    {%- assign discount_percent = discount_amount | times: 100.0 | divided_by: variant.compare_at_price | round -%}
                  {%- endif -%}
                  {%- assign img_alt = product.featured_media.alt | default: product.title -%}

                  <article class="fp-card" {{ block.shopify_attributes }}>
                    <a class="fp-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                      {%- if product.featured_media != blank -%}
                        {{
                          product.featured_media
                          | image_url: width: 600
                          | image_tag:
                            widths: '200, 300, 400, 600',
                            sizes: '(max-width: 749px) 150px, 200px',
                            class: 'fp-card__image',
                            loading: 'lazy',
                            alt: img_alt
                        }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'fp-card__image fp-card__image--placeholder' }}
                      {%- endif -%}
                      {%- if has_discount -%}
                        <span class="fp-card__badge fp-card__badge--sale">{{ discount_percent }}% OFF</span>
                      {%- endif -%}
                      {%- if block.settings.badge_text != blank -%}
                        <span class="fp-card__badge fp-card__badge--tag">{{ block.settings.badge_text | escape }}</span>
                      {%- endif -%}
                    </a>

                    <h3 class="fp-card__name"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>

                    <div class="fp-card__prices">
                      {%- if product.price_varies -%}
                        <span class="fp-card__from">{{ section.settings.from_label | default: 'From' | escape }}</span>
                      {%- endif -%}
                      <span class="fp-card__price">{{ variant.price | money }}</span>
                      {%- if has_discount -%}
                        <s class="fp-card__compare">{{ variant.compare_at_price | money }}</s>
                      {%- endif -%}
                    </div>

                    <div class="fp-card__action">
                      {%- if product.available == false -%}
                        <a class="fp-card__btn fp-card__btn--muted" href="{{ product.url }}">{{ section.settings.sold_out_label | default: 'Sold out' | escape }}</a>
                      {%- elsif product.variants.size > 1 -%}
                        <a class="fp-card__btn fp-card__btn--outline" href="{{ product.url }}">{{ section.settings.options_label | default: 'Choose options' | escape }}</a>
                      {%- else -%}
                        <form class="fp-card__form" method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8">
                          <input type="hidden" name="id" value="{{ variant.id }}">
                          <input type="hidden" name="quantity" value="1">
                          <button class="fp-card__btn" type="submit" aria-label="{{ add_label | escape }}: {{ product.title | escape }}">{{ add_label | escape }}</button>
                        </form>
                      {%- endif -%}
                    </div>
                  </article>
                {%- endif -%}
              {%- endfor -%}
            </div>

            <button class="fp__arrow fp__arrow--next" type="button" data-next aria-label="Next products" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
            </button>
          {%- else -%}
            <p class="fp__empty">Add product blocks to show featured products.</p>
          {%- endif -%}
        </div>
      </bk-featured-strip>
    </div>
  </div>
{%- endif -%}

<script>
  (function () {
    if (customElements.get('bk-featured-strip')) return;

    class BkFeaturedStrip extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.prev = this.querySelector('[data-prev]');
        this.next = this.querySelector('[data-next]');
        this.reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (this.track) {
          this.onScroll = () => this.update();
          this.track.addEventListener('scroll', this.onScroll, { passive: true });
          if (this.prev) this.prev.addEventListener('click', () => this.page(-1));
          if (this.next) this.next.addEventListener('click', () => this.page(1));
          if ('ResizeObserver' in window) {
            this.resizeObserver = new ResizeObserver(() => this.update());
            this.resizeObserver.observe(this.track);
          }
          this.update();
        }

        this.endTime = Date.parse(this.dataset.end || '');
        this.hoursEl = this.querySelector('[data-hours]');
        this.minutesEl = this.querySelector('[data-minutes]');
        this.secondsEl = this.querySelector('[data-seconds]');
        if (this.hoursEl && this.minutesEl && this.secondsEl) {
          this.tick();
          this.timerInterval = window.setInterval(() => this.tick(), 1000);
        }
      }

      disconnectedCallback() {
        if (this.track && this.onScroll) this.track.removeEventListener('scroll', this.onScroll);
        if (this.resizeObserver) this.resizeObserver.disconnect();
        window.clearInterval(this.timerInterval);
      }

      page(direction) {
        var distance = this.track.clientWidth * 0.85;
        this.track.scrollBy({ left: direction * distance, behavior: this.reduceMotion ? 'auto' : 'smooth' });
      }

      update() {
        var t = this.track;
        var max = t.scrollWidth - t.clientWidth;
        var overflow = max > 2;
        if (this.prev) {
          this.prev.hidden = !overflow;
          this.prev.disabled = t.scrollLeft <= 2;
        }
        if (this.next) {
          this.next.hidden = !overflow;
          this.next.disabled = t.scrollLeft >= max - 2;
        }
      }

      tick() {
        var remaining = Number.isFinite(this.endTime) ? Math.max(0, Math.floor((this.endTime - Date.now()) / 1000)) : 0;
        var pad = (n) => String(n).padStart(2, '0');
        this.hoursEl.textContent = pad(Math.floor(remaining / 3600));
        this.minutesEl.textContent = pad(Math.floor((remaining % 3600) / 60));
        this.secondsEl.textContent = pad(remaining % 60);
      }
    }

    customElements.define('bk-featured-strip', BkFeaturedStrip);
  })();
</script>

{% stylesheet %}
  .fp-section {
    padding-top: var(--fp-pad-top, 20px);
    padding-bottom: var(--fp-pad-bottom, 20px);
  }

  .fp__inner {
    --fp-page-margin: 16px;
    width: min(var(--narrow-page-width, 1400px), calc(100% - (var(--fp-page-margin) * 2)));
    margin-inline: auto;
  }

  @media screen and (min-width: 750px) {
    .fp__inner {
      --fp-page-margin: 40px;
    }
  }

  .fp {
    display: block;
    position: relative;
    overflow: hidden;
    color: #171717;
    font-family: var(--font-body--family, inherit);
    background: var(--fp-bg, #fff9e8);
    border-radius: 12px;
  }

  .fp *,
  .fp *::before,
  .fp *::after {
    box-sizing: border-box;
  }

  /* ---------- Header band ---------- */
  .fp__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 12px 20px;
    color: var(--fp-header-text, #171717);
    background: var(--fp-header-bg, #fdc656);
  }

  .fp__head-text {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 100%;
  }

  .fp__title {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(1.125rem, 1rem + 0.9vw, 1.625rem);
    font-weight: 700;
    line-height: 1.2;
    color: inherit;
  }

  .fp__subtitle {
    margin: 2px 0 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: inherit;
    opacity: 0.92;
  }

  .fp__head-actions {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 8px 14px;
  }

  .fp__timer-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .fp__timer {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .fp__unit {
    min-width: 36px;
    padding: 5px;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    text-align: center;
    color: var(--fp-btn-text, #fff);
    background: var(--fp-btn-bg, #202020);
    border-radius: 5px;
  }

  .fp__view-all {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    min-height: 36px;
    padding: 6px 8px 6px 14px;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1;
    color: var(--fp-header-bg, #fff);
    text-decoration: none;
    white-space: nowrap;
    background: var(--fp-header-text, #202020);
    border-radius: 999px;
    transition: filter 0.15s ease;
  }

  .fp__view-all:hover {
    filter: brightness(0.92);
  }

  .fp__view-all svg {
    width: 16px;
    height: 16px;
  }

  /* ---------- Track ---------- */
  .fp__body {
    position: relative;
  }

  .fp__track {
    display: flex;
    align-items: stretch;
    gap: var(--fp-gap, 12px);
    padding: 14px 16px 18px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: 16px;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  .fp--arrows .fp__track {
    scrollbar-width: none;
  }

  .fp--arrows .fp__track::-webkit-scrollbar {
    display: none;
  }

  .fp__track:focus-visible {
    outline: 3px solid #1d4ed8;
    outline-offset: -3px;
  }

  .fp__empty {
    margin: 0;
    padding: 28px 16px;
    font-size: 0.9375rem;
    text-align: center;
    color: #555;
  }

  /* ---------- Arrows (desktop, mouse) ---------- */
  .fp__arrow {
    position: absolute;
    top: calc(50% - 10px);
    z-index: 2;
    display: none;
    width: 40px;
    height: 40px;
    padding: 0;
    margin-top: -20px;
    place-items: center;
    color: #171717;
    cursor: pointer;
    background: #fff;
    border: 0;
    border-radius: 50%;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.22);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .fp__arrow[hidden] {
    display: none;
  }

  .fp__arrow svg {
    width: 20px;
    height: 20px;
  }

  .fp__arrow--prev {
    left: 8px;
  }

  .fp__arrow--next {
    right: 8px;
  }

  .fp__arrow:hover:not(:disabled) {
    transform: scale(1.08);
  }

  .fp__arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .fp__arrow:focus-visible {
    outline: 3px solid #1d4ed8;
    outline-offset: 2px;
  }

  @media screen and (min-width: 750px) and (hover: hover) {
    .fp--arrows .fp__arrow:not([hidden]) {
      display: grid;
    }
  }

  /* ---------- Card ---------- */
  .fp-card {
    position: relative;
    display: flex;
    flex: 0 0 var(--fp-card-w, 168px);
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 8px;
    background: #fff;
    border-radius: var(--fp-card-radius, 9px);
    box-shadow: 0 2px 9px rgb(0 0 0 / 0.09);
    scroll-snap-align: start;
    transition: box-shadow 0.18s ease, transform 0.18s ease;
  }

  .fp-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 14px rgb(0 0 0 / 0.14);
  }

  .fp-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f5f5f5;
    border-radius: max(4px, calc(var(--fp-card-radius, 9px) - 3px));
  }

  .fp-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 6px;
    object-fit: contain;
    mix-blend-mode: multiply; /* white product photos blend into the grey tile */
  }

  .fp-card__image--placeholder {
    color: rgb(0 0 0 / 0.25);
    mix-blend-mode: normal;
  }

  .fp-card__badge {
    position: absolute;
    z-index: 1;
    padding: 3px 6px;
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: #fff;
    border-radius: 4px;
  }

  .fp-card__badge--sale {
    top: 6px;
    left: 6px;
    background: #d62d20;
  }

  .fp-card__badge--tag {
    top: 6px;
    right: 6px;
    background: rgb(23 23 23 / 0.85);
  }

  .fp-card__name {
    display: -webkit-box;
    min-height: calc(1.3em * 2);
    margin: 0;
    overflow: hidden;
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    color: #171717;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .fp-card__name a {
    color: inherit;
    text-decoration: none;
  }

  .fp-card__name a:hover {
    text-decoration: underline;
  }

  .fp-card__name a:focus-visible {
    outline: 2px solid #1d4ed8;
    outline-offset: 2px;
  }

  .fp-card__prices {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 6px;
  }

  .fp-card__from {
    font-size: 0.6875rem;
    color: #686868;
  }

  .fp-card__price {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.2;
    color: #171717;
  }

  .fp-card__compare {
    font-size: 0.6875rem;
    color: #686868;
  }

  .fp-card__action {
    margin-top: auto;
    padding-top: 2px;
  }

  .fp-card__form {
    margin: 0;
  }

  .fp-card__btn {
    display: block;
    width: 100%;
    min-height: 36px;
    padding: 8px 6px;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--fp-btn-text, #fff);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    background: var(--fp-btn-bg, #000);
    border: 1px solid var(--fp-btn-bg, #000);
    border-radius: 5px;
    transition: filter 0.15s ease, transform 0.1s ease;
  }

  .fp-card__btn:hover {
    filter: brightness(0.92);
  }

  .fp-card__btn:active {
    transform: scale(0.98);
  }

  .fp-card__btn:focus-visible {
    outline: 3px solid #1d4ed8;
    outline-offset: 2px;
  }

  .fp-card__btn--outline {
    color: var(--fp-btn-bg, #000);
    background: transparent;
  }

  .fp-card__btn--outline:hover {
    filter: none;
    color: var(--fp-btn-text, #fff);
    background: var(--fp-btn-bg, #000);
  }

  .fp-card__btn--muted {
    color: #686868;
    cursor: default;
    background: #ececec;
    border-color: #ececec;
  }

  .fp-card__btn--muted:hover {
    filter: none;
  }

  /* ---------- Mobile ---------- */
  @media screen and (max-width: 749px) {
    .fp__header {
      padding: 10px 14px;
    }

    .fp__timer-wrap {
      gap: 5px;
      font-size: 0.6875rem;
    }

    .fp__unit {
      min-width: 28px;
      padding: 4px;
      font-size: 0.75rem;
    }

    .fp__track {
      padding: 12px 14px 16px;
      scroll-padding-inline: 14px;
    }

    .fp-card {
      flex-basis: min(var(--fp-card-w, 168px), 148px);
      padding: 7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fp-card,
    .fp__arrow,
    .fp-card__btn,
    .fp__view-all {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Feature product strip",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Popular picks from our range"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "\"View all\" link",
      "info": "The button only appears when a link is set."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" label",
      "default": "View all"
    },
    {
      "type": "header",
      "content": "Countdown timer"
    },
    {
      "type": "checkbox",
      "id": "show_timer",
      "label": "Show countdown timer",
      "info": "Only turn this on for a real offer with an end date.",
      "default": false
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "Countdown end time",
      "info": "Format: 2026-12-31T23:59:59+05:30",
      "default": "2026-12-31T23:59:59+05:30",
      "visible_if": "{{ section.settings.show_timer }}"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add button label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "options_label",
      "label": "Label for products with options",
      "default": "Choose options"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "from_label",
      "label": "Label before a price range",
      "default": "From"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "select",
      "id": "color_palette",
      "label": "Color scheme",
      "options": [
        { "value": "blue", "label": "Brand blue" },
        { "value": "amber", "label": "Amber (like Deals of the Day)" },
        { "value": "mauve", "label": "Mauve" },
        { "value": "custom", "label": "Custom colors" }
      ],
