{
  "name": "Product information",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "column_gap", "label": "Column spacing", "min": 16, "max": 64, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#000f9f" },
    { "type": "header", "content": "Gallery" },
    { "type": "checkbox", "id": "sticky_gallery", "label": "Keep gallery in view while scrolling (desktop)", "default": true },
    {
      "type": "select",
      "id": "gallery_ratio",
      "label": "Image shape",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "Portrait" },
        { "value": "4/3", "label": "Landscape" }
      ],
      "default": "1/1"
    },
    { "type": "text", "id": "gallery_label", "label": "Gallery accessible label", "default": "Product images" },
    { "type": "text", "id": "thumb_label", "label": "Thumbnail accessible label", "default": "Show image" },
    { "type": "header", "content": "Product form" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true },
    { "type": "text", "id": "variant_label", "label": "Variant label", "default": "Options" },
    {
      "type": "select",
      "id": "variant_style",
      "label": "Variant style",
      "options": [
       { "value": "auto", "label": "Auto (buttons up to 6, else dropdown)" },
        { "value": "buttons", "label": "Buttons" },
        { "value": "dropdown", "label": "Dropdown" }
      ],
      "default": "auto"
    },
    { "type": "text", "id": "quantity_label", "label": "Quantity label", "default": "Quantity" },
    { "type": "text", "id": "decrease_label", "label": "Decrease quantity (accessible label)", "default": "Decrease quantity" },
    { "type": "text", "id": "increase_label", "label": "Increase quantity (accessible label)", "default": "Increase quantity" },
    { "type": "text", "id": "add_label", "label": "Purchase button", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Unavailable label", "default": "Sold out" },
    { "type": "text", "id": "save_label", "label": "Discount badge label", "default": "Save" },
    { "type": "header", "content": "Description" },
    { "type": "text", "id": "description_label", "label": "Description heading (leave blank to hide)", "default": "Description" },
    { "type": "text", "id": "details_label", "label": "Accordion label", "default": "Details" },
    { "type": "checkbox", "id": "open_details", "label": "Open Details by default", "default": false },
    { "type": "text", "id": "table_label", "label": "Scrollable table accessible label", "default": "Scrollable table" }
  ],
  "presets": [
    { "name": "Product information" }
  ],
  "tag": null,
  "class": "product-information-block"
}
