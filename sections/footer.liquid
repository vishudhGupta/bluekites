<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} bk-footer"
  id="BkFooter-{{ section.id }}"
>
  {% liquid
    assign s = section.settings
    assign total_blocks = section.blocks.size
    assign grid_columns = total_blocks | at_most: 4
    assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 4 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}

  {%- if s.show_back_to_top -%}
    <button class="bk-footer__top" type="button" aria-label="Back to top" data-bk-top>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 15 6-6 6 6"/></svg>
    </button>
  {%- endif -%}

  <div
    class="
      footer-content
      bk-footer__content
      spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
    "
  >
    {% content_for 'blocks' %}
  </div>

  <div class="bk-footer__bottom">
    <p class="bk-footer__copyright">© {{ 'now' | date: '%Y' }} {{ s.copyright_name | default: shop.name | escape }}. All rights reserved.</p>

    {% if shop.policies.size > 0 %}
      <nav class="bk-footer__legal" aria-label="Legal">
        {% for policy in shop.policies %}
          {% if policy != blank %}
            <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
          {% endif %}
        {% endfor %}
      </nav>
    {% endif %}

    {%- if s.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="bk-footer__pay" role="list" aria-label="Accepted payments">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'bk-footer__pay-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  /* Full-bleed footer background; keep all existing Shopify content blocks intact. */
  .section.bk-footer {
    width: 100vw !important;
    max-width: none !important;
    margin-inline: calc(50% - 50vw) !important;
    padding-inline: 0 !important;
    overflow: visible;
  }

  .bk-footer {
    --bk-footer-bg: #10363d;
    --bk-footer-bg-deep: #0c2e35;
    --bk-footer-text: #d1e0e2;
    --bk-footer-heading: #f6fbfb;
    --bk-footer-muted: #b5cbd0;
    --bk-footer-line: rgba(207, 226, 229, .14);
    --bk-footer-glass: rgba(255, 255, 255, .06);
    --bk-footer-accent: #b98245;
    --bk-footer-accent-hover: #e2b77f;
    --bk-footer-max: 1240px;

    position: relative;
    isolation: isolate;
    color: var(--bk-footer-text);
    background:
      radial-gradient(900px 420px at 0% 0%, rgba(255, 255, 255, .07), transparent 70%),
      radial-gradient(700px 380px at 100% 100%, rgba(185, 130, 69, .12), transparent 70%),
      linear-gradient(180deg, var(--bk-footer-bg), var(--bk-footer-bg-deep)) !important;
    border: 0 !important;
  }

  .bk-footer,
  .bk-footer * { box-sizing: border-box; }

  .bk-footer__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---------- Back to top ---------- */
  .bk-footer__top {
    position: absolute;
    top: -22px;
    right: max(20px, calc((100% - var(--bk-footer-max)) / 2));
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: #fff;
    background: var(--bk-footer-accent);
    border: 0;
    border-radius: 50%;
    box-shadow: 0 10px 24px -8px rgba(0, 0, 0, .5);
    cursor: pointer;
    transition: transform .2s ease, background .2s ease;
  }
  .bk-footer__top:hover { transform: translateY(-3px); background: var(--bk-footer-accent-hover); }
  .bk-footer__top svg { width: 18px; height: 18px; }

  /* ---------- Main grid (compact) ---------- */
  .bk-footer .bk-footer__content {
    display: grid;
    grid-template-columns: auto minmax(0, 2fr) minmax(0, 1fr);
    align-items: start;
    gap: 24px clamp(32px, 5vw, 72px);
    width: min(100% - 40px, var(--bk-footer-max));
    max-width: var(--bk-footer-max);
    margin-inline: auto;
    padding: 36px 0 28px !important;
    contain: none;
    content-visibility: visible;
  }

  .bk-footer .bk-footer__content > * {
    min-width: 0;
    align-self: start;
    justify-self: stretch;
  }

  /* Desktop: logo + social in column 1, Quick Links (2 columns) + Services beside */
  @media screen and (min-width: 1100px) {
    .bk-footer .bk-footer__content { grid-template-rows: auto 1fr; row-gap: 16px; }
    .bk-footer .bk-footer__content > :nth-child(1) { grid-column: 1; grid-row: 1; }       /* Logo */
    .bk-footer .bk-footer__content > :nth-child(2) { grid-column: 2; grid-row: 1 / -1; }  /* Quick Links */
    .bk-footer .bk-footer__content > :nth-child(3) { grid-column: 3; grid-row: 1 / -1; }  /* Services */
    .bk-footer .bk-footer__content > :nth-child(4) { grid-column: 1; grid-row: 2; }       /* Social icons */
    .bk-footer .bk-footer__content > :nth-child(n+5) { grid-column: 1; }                  /* Extra blocks */

    /* Long Quick Links list flows into 2 columns to keep the footer short */
    .bk-footer .bk-footer__content > :nth-child(2) ul,
    .bk-footer .bk-footer__content > :nth-child(2) ol {
      display: block;
      column-count: 2;
      column-gap: 32px;
    }
    .bk-footer .bk-footer__content > :nth-child(2) li {
      break-inside: avoid;
      margin-bottom: 8px;
    }
  }

  /* Headings with accent underline */
  .bk-footer .bk-footer__content h2,
  .bk-footer .bk-footer__content h3,
  .bk-footer .bk-footer__content h4,
  .bk-footer .bk-footer__content .menu__heading,
  .bk-footer .bk-footer__content .menu__heading__default {
    position: relative;
    margin: 0 0 14px;
    padding: 0 0 8px;
    color: var(--bk-footer-heading) !important;
    font-family: var(--font-body--family, inherit);
    font-size: 13px !important;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .bk-footer .bk-footer__content h2::after,
  .bk-footer .bk-footer__content h3::after,
  .bk-footer .bk-footer__content h4::after,
  .bk-footer .bk-footer__content .menu__heading::after,
  .bk-footer .bk-footer__content .menu__heading__default::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    bottom: 0;
    width: 24px;
    height: 2px;
    border-radius: 2px;
    background: var(--bk-footer-accent);
  }

  .bk-footer .bk-footer__content p {
    margin: 0 0 14px;
    color: var(--bk-footer-muted) !important;
    font-size: 13px;
    line-height: 1.75;
  }

  .bk-footer .bk-footer__content a {
    display: inline-block;
    color: var(--bk-footer-text) !important;
    text-decoration: none;
    transition: color .2s ease, transform .2s ease;
  }

  .bk-footer .bk-footer__content li a:hover,
  .bk-footer .bk-footer__content p a:hover {
    color: var(--bk-footer-accent-hover) !important;
    transform: translateX(4px);
  }

  .bk-footer a:focus-visible,
  .bk-footer button:focus-visible,
  .bk-footer input:focus-visible {
    outline: 2px solid var(--bk-footer-accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .bk-footer .bk-footer__content ul,
  .bk-footer .bk-footer__content ol {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bk-footer .bk-footer__content li {
    margin: 0;
    color: var(--bk-footer-text);
    font-size: 13px;
    line-height: 1.45;
  }

  /* Keep the theme's logo size, just prevent overflow */
  .bk-footer .bk-footer__content img,
  .bk-footer .bk-footer__content svg { max-width: 100%; }

  /* Inputs inside any email-signup block */
  .bk-footer .bk-footer__content input:not([type='checkbox']):not([type='radio']),
  .bk-footer .bk-footer__content select,
  .bk-footer .bk-footer__content textarea {
    width: 100%;
    min-height: 44px;
    padding: 10px 16px;
    color: var(--bk-footer-heading);
    background: var(--bk-footer-glass);
    border: 1px solid var(--bk-footer-line);
    border-radius: 999px;
    font: inherit;
  }

  .bk-footer .bk-footer__content button,
  .bk-footer .bk-footer__content input[type='submit'] {
    min-height: 44px;
    padding: 10px 20px;
    color: #fff;
    background: var(--bk-footer-accent);
    border: 0;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background .2s ease, transform .2s ease;
  }

  .bk-footer .bk-footer__content button:hover,
  .bk-footer .bk-footer__content input[type='submit']:hover {
    background: var(--bk-footer-accent-hover);
    transform: translateY(-1px);
  }

  /* Social icons */
  .bk-footer .bk-footer__content .social-links,
  .bk-footer .bk-footer__content .social-links__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .bk-footer .bk-footer__content .social-links a,
  .bk-footer .bk-footer__content .social-links__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    color: var(--bk-footer-heading) !important;
    background: var(--bk-footer-glass);
    border: 1px solid var(--bk-footer-line);
    border-radius: 50%;
    transition: background .2s ease, border-color .2s ease, transform .2s ease;
  }
  .bk-footer .bk-footer__content .social-links svg { width: 16px; height: 16px; }

  .bk-footer .bk-footer__content .social-links a:hover,
  .bk-footer .bk-footer__content .social-links__link:hover {
    color: #fff !important;
    background: var(--bk-footer-accent);
    border-color: var(--bk-footer-accent);
    transform: translateY(-3px);
  }

  /* ---------- Bottom bar ---------- */
  .bk-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 14px 28px;
    width: 100%;
    margin: 0;
    padding: 14px max(20px, calc((100% - var(--bk-footer-max)) / 2));
    background: rgba(0, 0, 0, .18);
    border-top: 1px solid var(--bk-footer-line);
  }

  .bk-footer__copyright { margin: 0; color: var(--bk-footer-muted); font-size: 12px; line-height: 1.6; }

  .bk-footer__legal { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .bk-footer__legal a {
    color: var(--bk-footer-muted) !important;
    font-size: 12px;
    line-height: 1.6;
    text-decoration: none;
    transition: color .2s ease;
  }
  .bk-footer__legal a:hover { color: var(--bk-footer-accent-hover) !important; }

  .bk-footer__pay { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .bk-footer__pay-icon { display: block; width: 38px; height: 24px; border-radius: 4px; }

  /* ---------- Responsive ---------- */
  @media screen and (min-width: 750px) and (max-width: 1099px) {
    .bk-footer .bk-footer__content {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px 40px;
      padding-block: 32px 24px !important;
    }
  }

  @media screen and (max-width: 749px) {
    .bk-footer .bk-footer__content {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 20px;
      padding-block: 28px 20px !important;
    }
    .bk-footer__bottom { flex-direction: column; justify-content: center; text-align: center; padding: 20px; }
    .bk-footer__legal,
    .bk-footer__pay { justify-content: center; }
  }

  @media screen and (max-width: 480px) {
    .bk-footer .bk-footer__content { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .bk-footer .bk-footer__content > * { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bk-footer *, .bk-footer *::before, .bk-footer *::after {
      scroll-behavior: auto !important;
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const btn = document.querySelector('#BkFooter-{{ section.id }} [data-bk-top]');
    if (!btn || btn.dataset.ready) return;
    btn.dataset.ready = 'true';
    btn.addEventListener('click', () => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });
  })();
</script>

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "blocks": [
    { "type": "_divider" },
    { "type": "@app" },
    { "type": "button" },
    { "type": "follow-on-shop" },
    { "type": "group" },
    { "type": "icon" },
    { "type": "image" },
    { "type": "menu" },
    { "type": "payment-icons" },
    { "type": "text" },
    { "type": "logo" },
    { "type": "jumbo-text" },
    { "type": "social-links" },
    { "type": "email-signup" }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "copyright_name", "label": "Copyright name", "default": "Bluekites Services" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_back_to_top", "label": "Show back-to-top button", "default": true },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer",
      "settings": {
        "gap": 0,
        "color_scheme": "scheme-1",
        "padding-block-start": 20,
        "padding-block-end": 20
      }
    }
  ]
}
{% endschema %}
