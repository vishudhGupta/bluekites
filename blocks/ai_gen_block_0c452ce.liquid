{% doc %}

  @prompt

    Create a new navigation bar inspired by the attached reference's clean ivory-white background, charcoal text and icons, subtle lime-yellow accent, and deep botanical green accents. Use a smaller store logo for balanced proportions. Display the store's existing navigation items as recognizable icons, with their text labels appearing on hover and keyboard focus. Keep Login and Cart icons accompanied by permanently visible text labels for clarity. Make navigation usable on mobile, where labels must remain accessible without hover. Keep the styling clean and refined.

{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}



{% style %}

  .ai-refined-nav-{{ ai_gen_id }} {

    display: block;

    width: {{ block.settings.desktop_width_percent }}%;

    max-width: 100%;

    background: {{ block.settings.background_color }};

    color: {{ block.settings.text_color }};

    border-bottom: 1px solid {{ block.settings.border_color }};

    font-family: {{ settings.type_body_font.family }}, sans-serif;

  }

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__inner {

    min-height: 76px;

    padding: 12px clamp(16px, 4vw, 56px);

    display: grid;

    grid-template-columns: 1fr auto 1fr;

    align-items: center;

    gap: 24px;

  }

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__logo {

    display: inline-flex;

    align-items: center;

    justify-self: start;

    color: {{ block.settings.text_color }};

    text-decoration: none;

  }

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__logo img {

    display: block;

    width: auto;

    max-width: 160px;

    height: {{ block.settings.logo_height }}px;

    object-fit: contain;

  }

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__brand {

    font-family: {{ settings.type_heading_font.family }}, serif;

    font-size: 20px;

    font-weight: 600;

    letter-spacing: .02em;

  }

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__menu,

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__actions {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    margin: 0;

    padding: 0;

    list-style: none;

  }

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__actions { justify-self: end; gap: 18px; }

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__link {

    position: relative;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    min-height: 44px;

    padding: 9px 12px;

    border-radius: 24px;

    color: {{ block.settings.text_color }};

    text-decoration: none;

    font-size: 13px;

    line-height: 1.2;

    white-space: nowrap;

    transition: background-color .18s ease, color .18s ease;

  }

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__menu-link .ai-refined-nav__label {

    position: absolute;

    left: 50%;

    top: calc(100% + 5px);

    z-index: 3;

    transform: translate(-50%, -3px);

    padding: 7px 11px;

    border-radius: 5px;

    background: {{ block.settings.green_color }};

    color: #ffffff;

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transition: opacity .15s ease, transform .15s ease, visibility .15s ease;

  }

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__menu-link:hover .ai-refined-nav__label,

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__menu-link:focus-visible .ai-refined-nav__label {

    opacity: 1;

    visibility: visible;

    transform: translate(-50%, 0);

  }

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__link:hover,

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__link:focus-visible {

    background: {{ block.settings.accent_color }};

    color: {{ block.settings.green_color }};

  }

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__link:focus-visible { outline: 2px solid {{ block.settings.green_color }}; outline-offset: 2px; }

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__icon {
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: #f5f1e9;
    font-size: 20px;
    line-height: 1;
  }

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__menu-link:first-child .ai-refined-nav__icon {
    background: transparent;
    font-size: 27px;
  }

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__actions .ai-refined-nav__link { gap: 7px; padding-inline: 5px; }

  .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__cart-count {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-width: 18px;

    height: 18px;

    padding: 0 4px;

    border-radius: 10px;

    background: {{ block.settings.accent_color }};

    color: {{ block.settings.green_color }};

    font-size: 11px;

    font-weight: 700;

  }

  @media (max-width: 749px) {

    .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__inner {

      grid-template-columns: auto 1fr auto;

      min-height: 68px;

      gap: 8px;

      padding: 10px 12px;

    }

    .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__logo img { height: {{ block.settings.logo_height | at_most: 32 }}px; max-width: 100px; }

    .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__brand { font-size: 15px; }

    .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__menu { gap: 0; }

    .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__menu-link { flex-direction: column; gap: 2px; min-width: 40px; padding: 6px 4px; font-size: 10px; }

    .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__menu-link .ai-refined-nav__label { position: static; transform: none; opacity: 1; visibility: visible; pointer-events: auto; padding: 0; background: transparent; color: {{ block.settings.text_color }}; font-size: 10px; }

    .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__actions { gap: 7px; }

    .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__actions .ai-refined-nav__link { flex-direction: column; gap: 2px; font-size: 10px; padding: 5px 2px; }

    .ai-refined-nav-{{ ai_gen_id }} .ai-refined-nav__icon { width: 19px; height: 19px; flex-basis: 19px; }

  }

{% endstyle %}



<nav class="ai-refined-nav-{{ ai_gen_id }}" aria-label="Main navigation" {{ block.shopify_attributes }}>

  <div class="ai-refined-nav__inner">

    <a class="ai-refined-nav__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">

      {% if settings.logo != blank %}

        {{ settings.logo | image_url: width: 320 | image_tag: alt: shop.name, loading: 'lazy' }}

      {% else %}

        <span class="ai-refined-nav__brand">{{ shop.name | escape }}</span>

      {% endif %}

    </a>

    <ul class="ai-refined-nav__menu">

      {% if block.settings.menu != blank %}

        {% for link in block.settings.menu.links %}

          {% assign nav_label = link.title | downcase %}

          <li>

            <a class="ai-refined-nav__link ai-refined-nav__menu-link" href="{{ link.url }}" aria-label="{{ link.title | escape }}">

              <span class="ai-refined-nav__icon" aria-hidden="true">
                {% if nav_label contains 'home' %}⌂
                {% elsif nav_label contains 'surgical' or nav_label contains 'product' or nav_label contains 'catalog' or nav_label contains 'shop' or nav_label contains 'collection' %}🩺
                {% elsif nav_label contains 'handrub' or nav_label contains 'disinfect' or nav_label contains 'sanit' %}🧴
                {% elsif nav_label contains 'health' or nav_label contains 'medical' or nav_label contains 'care' or nav_label contains 'service' or nav_label contains 'support' %}🩺
                {% elsif nav_label contains 'cosmetic' or nav_label contains 'beauty' or nav_label contains 'skin' %}💄
                {% elsif nav_label contains 'about' or nav_label contains 'story' %}🌿
                {% elsif nav_label contains 'contact' %}✉️
                {% elsif nav_label contains 'blog' or nav_label contains 'article' or nav_label contains 'journal' or nav_label contains 'news' %}📰
                {% elsif nav_label contains 'faq' or nav_label contains 'question' %}❔
                {% elsif nav_label contains 'sale' or nav_label contains 'offer' or nav_label contains 'discount' %}🏷️
                {% elsif nav_label contains 'track' or nav_label contains 'delivery' or nav_label contains 'shipping' %}🚚
                {% elsif nav_label contains 'location' or nav_label contains 'store' or nav_label contains 'find' %}📍
                {% elsif nav_label contains 'account' or nav_label contains 'profile' or nav_label contains 'login' %}👤
                {% elsif nav_label contains 'sustain' or nav_label contains 'eco' or nav_label contains 'nature' %}🍃
                {% else %}✦
                {% endif %}
              </span>

              <span class="ai-refined-nav__label">{{ link.title | escape }}</span>

            </a>

          </li>

        {% endfor %}

      {% endif %}

    </ul>

    <div class="ai-refined-nav__actions">

      <a class="ai-refined-nav__link" href="{{ routes.account_login_url }}" aria-label="Log in">

        <svg class="ai-refined-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg>

        <span>Login</span>

      </a>

      <a class="ai-refined-nav__link" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">

        <svg class="ai-refined-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 2-1.6L22 8H6"/><circle cx="10" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg>

        <span>Cart</span><span class="ai-refined-nav__cart-count">{{ cart.item_count }}</span>

      </a>

    </div>

  </div>

</nav>



{% schema %}

{

  "name": "Refined icon navigation",

  "settings": [

    { "type": "link_list", "id": "menu", "label": "Navigation menu" },

    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },

    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 28 },

    { "type": "color", "id": "background_color", "label": "Background", "default": "#FAF9F1" },

    { "type": "color", "id": "text_color", "label": "Text and icons", "default": "#292D29" },

    { "type": "color", "id": "green_color", "label": "Botanical green", "default": "#244D38" },

    { "type": "color", "id": "accent_color", "label": "Lime accent", "default": "#E5EC9A" },

    { "type": "color", "id": "border_color", "label": "Divider", "default": "#E4E5D9" }

  ],

  "presets": [{ "name": "Refined icon navigation" }],

  "tag": null,

  "class": "refined-icon-navigation"

}

{% endschema %}