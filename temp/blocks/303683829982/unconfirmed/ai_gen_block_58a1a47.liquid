{% doc %}
  @prompt
    Create a replacement for the selected Refined icon navigation block that preserves its existing menu, colors, logo size, hover labels, and visible Login and Cart text. Give each navigation item a distinct icon that matches its actual menu label instead of repeating the globe icon. Keep all other appearance and behavior unchanged.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign nav_menu = block.settings.menu %}

{% style %}
  .ai-refined-nav-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: inherit;
  }
  .ai-refined-nav-{{ ai_gen_id }}__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
  }
  .ai-refined-nav-{{ ai_gen_id }}__menu,
  .ai-refined-nav-{{ ai_gen_id }}__actions {
    display: flex;
    align-items: center;
    gap: {{ block.settings.item_gap }}px;
  }
  .ai-refined-nav-{{ ai_gen_id }}__menu {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ai-refined-nav-{{ ai_gen_id }}__item,
  .ai-refined-nav-{{ ai_gen_id }}__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  .ai-refined-nav-{{ ai_gen_id }}__item {
    padding: 8px 4px;
  }
  .ai-refined-nav-{{ ai_gen_id }}__icon {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: block;
    flex: 0 0 auto;
  }
  .ai-refined-nav-{{ ai_gen_id }}__label {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    z-index: 5;
    padding: 5px 8px;
    background: #ffffff;
    color: #111111;
    border: 1px solid rgba(0,0,0,.14);
    border-radius: 3px;
    font-size: 12px;
    line-height: 1.2;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -3px);
    pointer-events: none;
  }
  .ai-refined-nav-{{ ai_gen_id }}__item:hover .ai-refined-nav-{{ ai_gen_id }}__label,
  .ai-refined-nav-{{ ai_gen_id }}__item:focus-visible .ai-refined-nav-{{ ai_gen_id }}__label {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .ai-refined-nav-{{ ai_gen_id }}__logo {
    display: flex;
    flex: 0 1 auto;
    align-items: center;
    justify-content: center;
  }
  .ai-refined-nav-{{ ai_gen_id }}__logo img {
    display: block;
    width: auto;
    height: {{ settings.logo_height }}px;
    max-width: 100%;
    object-fit: contain;
  }
  .ai-refined-nav-{{ ai_gen_id }}__action {
    gap: 6px;
    font-size: inherit;
  }
  .ai-refined-nav-{{ ai_gen_id }}__action svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex: 0 0 auto;
  }
  .ai-refined-nav-{{ ai_gen_id }}__item:focus-visible,
  .ai-refined-nav-{{ ai_gen_id }}__action:focus-visible,
  .ai-refined-nav-{{ ai_gen_id }}__logo:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
  @media screen and (max-width: 749px) {
    .ai-refined-nav-{{ ai_gen_id }}__inner { gap: 10px; }
    .ai-refined-nav-{{ ai_gen_id }}__menu,
    .ai-refined-nav-{{ ai_gen_id }}__actions { gap: {{ block.settings.mobile_item_gap }}px; }
    .ai-refined-nav-{{ ai_gen_id }}__logo img { height: {{ settings.logo_height_mobile }}px; }
    .ai-refined-nav-{{ ai_gen_id }}__action { font-size: 12px; }
  }
{% endstyle %}

<nav class="ai-refined-nav-{{ ai_gen_id }}" aria-label="Main navigation" {{ block.shopify_attributes }}>
  <div class="ai-refined-nav-{{ ai_gen_id }}__inner">
    <ul class="ai-refined-nav-{{ ai_gen_id }}__menu">
      {% if nav_menu != blank %}
        {% for link in nav_menu.links %}
          {% assign nav_label = link.title | downcase %}
          <li>
            <a class="ai-refined-nav-{{ ai_gen_id }}__item" href="{{ link.url }}" aria-label="{{ link.title | escape }}">
              {% if nav_label contains 'home' %}
                <svg class="ai-refined-nav-{{ ai_gen_id }}__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7"/><path d="M5 9v12h14V9M9 21v-7h6v7"/></svg>
              {% elsif nav_label contains 'shop' or nav_label contains 'product' or nav_label contains 'store' %}
                <svg class="ai-refined-nav-{{ ai_gen_id }}__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h16l-1 13H5L4 8Z"/><path d="M8 9V6a4 4 0 0 1 8 0v3"/></svg>
              {% elsif nav_label contains 'about' or nav_label contains 'story' %}
                <svg class="ai-refined-nav-{{ ai_gen_id }}__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
              {% elsif nav_label contains 'contact' or nav_label contains 'support' %}
                <svg class="ai-refined-nav-{{ ai_gen_id }}__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v12H8l-4 3V5Z"/><path d="M8 9h8M8 13h5"/></svg>
              {% elsif nav_label contains 'blog' or nav_label contains 'journal' or nav_label contains 'news' %}
                <svg class="ai-refined-nav-{{ ai_gen_id }}__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h14v18H5zM8 7h8M8 11h8M8 15h5"/></svg>
              {% elsif nav_label contains 'sale' or nav_label contains 'offer' %}
                <svg class="ai-refined-nav-{{ ai_gen_id }}__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 13-7 7L3 10V3h7l10 10Z"/><circle cx="7.5" cy="7.5" r="1"/></svg>
              {% else %}
                <svg class="ai-refined-nav-{{ ai_gen_id }}__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>
              {% endif %}
              <span class="ai-refined-nav-{{ ai_gen_id }}__label">{{ link.title | escape }}</span>
            </a>
          </li>
        {% endfor %}
      {% endif %}
    </ul>
    <a class="ai-refined-nav-{{ ai_gen_id }}__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: 500 | image_tag: alt: shop.name, loading: 'lazy' }}
      {% else %}
        <span>{{ shop.name | escape }}</span>
      {% endif %}
    </a>
    <div class="ai-refined-nav-{{ ai_gen_id }}__actions">
      <a class="ai-refined-nav-{{ ai_gen_id }}__action" href="{{ routes.account_login_url }}" aria-label="Login">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg><span>Login</span>
      </a>
      <a class="ai-refined-nav-{{ ai_gen_id }}__action" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 2-1.6L21 8H6"/><circle cx="10" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg><span>Cart</span>
      </a>
    </div>
  </div>
</nav>

{% schema %}
{
  "name": "Refined icon navigation",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 16, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "item_gap", "label": "Item spacing", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "mobile_item_gap", "label": "Mobile spacing", "min": 2, "max": 20, "step": 2, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "Refined icon navigation" }],
  "tag": null,
  "class": "refined-icon-navigation"
}
{% endschema %}