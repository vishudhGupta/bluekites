{% doc %}
  @prompt
    ok now i want to have separate 5 category sections , in each section i want to add products of my own choice , so please write a new section so that i can use it again in other places, the heading subheading and product listing should be customisable.  the styling shoudl be just like the Our services, there shoudl be 5 - 6 products listed
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-products-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 40px 24px;
    color: #000000;
    background: #ffffff;
  }

  .ai-category-products-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-category-products-{{ ai_gen_id }}__heading {
    margin: 0;
    font-family: var(--font-heading--family, 'Almarai', sans-serif);
    font-size: clamp(26px, 3vw, 40px);
    line-height: 1.2;
    font-weight: 600;
    color: #000000;
  }

  .ai-category-products-{{ ai_gen_id }}__subheading {
    margin: 10px 0 26px;
    max-width: 720px;
    font-family: var(--font-body--family, 'Poppins', sans-serif);
    font-size: 15px;
    line-height: 1.6;
    color: #333333;
  }

  .ai-category-products-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 18px;
  }

  .ai-category-products-{{ ai_gen_id }}__card {
    min-width: 0;
    color: #000000;
    text-decoration: none;
    display: block;
  }

  .ai-category-products-{{ ai_gen_id }}__image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    background: #f5f5f5;
  }

  .ai-category-products-{{ ai_gen_id }}__image-wrap img,
  .ai-category-products-{{ ai_gen_id }}__image-wrap svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-category-products-{{ ai_gen_id }}__title {
    margin: 12px 0 6px;
    font-family: var(--font-body--family, 'Poppins', sans-serif);
    font-size: 15px;
    line-height: 1.4;
    font-weight: 500;
  }

  .ai-category-products-{{ ai_gen_id }}__price {
    font-family: var(--font-body--family, 'Poppins', sans-serif);
    font-size: 14px;
    color: #333333;
  }

  .ai-category-products-{{ ai_gen_id }}__empty {
    grid-column: 1 / -1;
    padding: 28px;
    text-align: center;
    background: #f7f7f7;
    border-radius: 10px;
    color: #333333;
    font-size: 14px;
  }

  .ai-category-products-{{ ai_gen_id }}__card:focus-visible {
    outline: 2px solid #000000;
    outline-offset: 4px;
    border-radius: 10px;
  }

  @media screen and (max-width: 989px) {
    .ai-category-products-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
  }

  @media screen and (max-width: 600px) {
    .ai-category-products-{{ ai_gen_id }} {
      padding: 30px 16px;
    }

    .ai-category-products-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 12px;
    }

    .ai-category-products-{{ ai_gen_id }}__subheading {
      margin-bottom: 20px;
    }
  }
{% endstyle %}

<div class="ai-category-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-products-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-category-products-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    {% if block.settings.subheading != blank %}
      <p class="ai-category-products-{{ ai_gen_id }}__subheading">{{ block.settings.subheading | escape }}</p>
    {% endif %}

    <div class="ai-category-products-{{ ai_gen_id }}__grid">
      {% if block.settings.products != blank %}
        {% for product in block.settings.products limit: 6 %}
          <a class="ai-category-products-{{ ai_gen_id }}__card" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            <div class="ai-category-products-{{ ai_gen_id }}__image-wrap">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
              {% else %}
                <div class="ai-category-products-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
              {% endif %}
            </div>
            <h3 class="ai-category-products-{{ ai_gen_id }}__title">{{ product.title | escape }}</h3>
            <span class="ai-category-products-{{ ai_gen_id }}__price">{{ product.price | money }}</span>
          </a>
        {% endfor %}
      {% else %}
        <div class="ai-category-products-{{ ai_gen_id }}__empty">Choose up to 6 products in this block’s settings to display them here.</div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore our collection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover products selected for you."
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 6
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Category products"
    }
  ],
  "tag": null,
  "class": "category-products-block"
}
{% endschema %}