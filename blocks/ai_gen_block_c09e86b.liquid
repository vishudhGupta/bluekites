{% doc %}
  @prompt
    Create a "Deals of the Day" section inspired by e-commerce platforms like Flipkart and Amazon. The section should include: a prominent header with "Deals of the Day" title and a live countdown timer showing hours, minutes, and seconds remaining. Product cards in a compact, slightly smaller layout displayed in a horizontal scrollable or grid row. Each product card should show a product image, product title, discounted price, original crossed-out price, discount percentage badge (e.g. "40% OFF") in a bright color like red or orange, and an "Add to Cart" button. The overall design should feel modern, clean, and deal-focused with a highlighted background for the section (like a light yellow or orange banner for the header). Cards should have a subtle shadow and hover effect. Keep the layout compact and dense similar to deal sections on major e-commerce sites.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-deals-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    margin-top: 10px;
    margin-bottom: 10px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    height: 40vh;
    min-height: 320px;
    color: #171717;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    background: {{ block.settings.section_background }};
    border-radius: 12px;
    overflow: hidden;
    box-sizing: border-box;
  }
  .ai-deals-{{ ai_gen_id }} * { box-sizing: border-box; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__header {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 20px;
    background: {{ block.settings.header_background }};
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__title { margin: 0; font-size: clamp(18px, 2.6vw, 26px); line-height: 1.2; font-weight: 700; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__timer-wrap { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; white-space: nowrap; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__timer { display: flex; align-items: center; gap: 4px; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__unit { min-width: 36px; padding: 5px; text-align: center; color: #fff; background: #202020; border-radius: 5px; font-size: 14px; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__products {
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    align-items: stretch;
    gap: 12px;
    padding: 12px 16px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 16px;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__card {
    position: relative;
    flex: 0 0 168px;
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px;
    background: #fff;
    border-radius: 9px;
    box-shadow: 0 2px 9px rgba(0,0,0,.09);
    scroll-snap-align: start;
    transition: box-shadow .18s ease, transform .18s ease;
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__card:hover { transform: translateY(-2px); box-shadow: 0 5px 14px rgba(0,0,0,.14); }
  .ai-deals-{{ ai_gen_id }} .ai-deals__media {
    position: relative;
    flex: 1 1 0;
    min-height: 0;
    display: block;
    overflow: hidden;
    background: #f5f5f5;
    border-radius: 6px;
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__media img,
  .ai-deals-{{ ai_gen_id }} .ai-deals__media svg,
  .ai-deals-{{ ai_gen_id }} .ai-deals__placeholder { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 6px; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__media img { mix-blend-mode: multiply; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__badge { position: absolute; top: 6px; left: 6px; z-index: 1; padding: 3px 6px; color: #fff; background: #d62d20; border-radius: 4px; font-size: 10px; line-height: 1.1; font-weight: 700; letter-spacing: .02em; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__name {
    flex: 0 0 auto;
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: #171717;
    font-family: inherit;
    font-size: 13px;
    line-height: 1.3;
    font-weight: 600;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .ai-deals-{{ ai_gen_id }} .ai-deals__prices { flex: 0 0 auto; display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__price { color: #171717; font-size: 15px; line-height: 1.2; font-weight: 700; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__compare { color: #686868; font-size: 11px; text-decoration: line-through; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__form { flex: 0 0 auto; margin: 0; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__button { display: block; width: 100%; min-height: 32px; padding: 7px 6px; border: 0; border-radius: 5px; background: {{ block.settings.button_background }}; color: {{ block.settings.button_text }}; text-align: center; text-decoration: none; font: inherit; font-size: 12px; line-height: 1.2; font-weight: 700; cursor: pointer; }
  .ai-deals-{{ ai_gen_id }} a.ai-deals__button { flex: 0 0 auto; opacity: .6; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__button:hover { filter: brightness(.92); }
  .ai-deals-{{ ai_gen_id }} .ai-deals__button:active { transform: scale(.98); }
  .ai-deals-{{ ai_gen_id }} .ai-deals__button:focus-visible, .ai-deals-{{ ai_gen_id }} .ai-deals__products:focus-visible { outline: 3px solid #1d4ed8; outline-offset: 2px; }
  .ai-deals-{{ ai_gen_id }} .ai-deals__empty { flex: 1; display: flex; align-items: center; justify-content: center; padding: 16px; text-align: center; color: #555; }
  @media (max-width: 600px) {
    .ai-deals-{{ ai_gen_id }} { width: 100%; }
    .ai-deals-{{ ai_gen_id }} .ai-deals__header { gap: 8px; padding: 8px 12px; }
    .ai-deals-{{ ai_gen_id }} .ai-deals__timer-wrap { gap: 5px; font-size: 11px; }
    .ai-deals-{{ ai_gen_id }} .ai-deals__unit { min-width: 28px; padding: 4px; font-size: 12px; }
    .ai-deals-{{ ai_gen_id }} .ai-deals__products { gap: 9px; padding: 10px 12px; }
    .ai-deals-{{ ai_gen_id }} .ai-deals__card { flex-basis: 148px; padding: 7px; }
    .ai-deals-{{ ai_gen_id }} .ai-deals__title { font-size: clamp(16px, 4.8vw, 20px); }
    .ai-deals-{{ ai_gen_id }} .ai-deals__button { min-height: 36px; }
  }
{% endstyle %}

<deals-of-day-{{ ai_gen_id }} class="ai-deals-{{ ai_gen_id }}" data-end="{{ block.settings.end_time | escape }}" {{ block.shopify_attributes }}>
  <div class="ai-deals__header">
    <h2 class="ai-deals__title">{{ block.settings.heading | escape }}</h2>
    <div class="ai-deals__timer-wrap"><span>{{ block.settings.timer_label | escape }}</span><div class="ai-deals__timer" role="timer" aria-live="off"><span class="ai-deals__unit" data-hours>00</span><span aria-hidden="true">:</span><span class="ai-deals__unit" data-minutes>00</span><span aria-hidden="true">:</span><span class="ai-deals__unit" data-seconds>00</span></div></div>
  </div>
  {% assign deal_products = block.settings.products %}
  {% if deal_products != blank %}
    <div class="ai-deals__products" tabindex="0" aria-label="Deal products">
      {% for product in deal_products %}
        {% assign deal_variant = product.selected_or_first_available_variant %}
        {% assign has_discount = false %}
        {% assign discount_percent = 0 %}
        {% if deal_variant.compare_at_price > deal_variant.price and deal_variant.compare_at_price > 0 %}
          {% assign has_discount = true %}
          {% assign discount_amount = deal_variant.compare_at_price | minus: deal_variant.price %}
          {% assign discount_percent = discount_amount | times: 100.0 | divided_by: deal_variant.compare_at_price | round %}
        {% endif %}
        <article class="ai-deals__card">
          <a class="ai-deals__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
            {% else %}
              <div class="ai-deals__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            {% endif %}
            {% if has_discount %}<span class="ai-deals__badge">{{ discount_percent }}% OFF</span>{% endif %}
          </a>
          <h3 class="ai-deals__name">{{ product.title | escape }}</h3>
          <div class="ai-deals__prices">
            <span class="ai-deals__price">{{ deal_variant.price | money }}</span>
            {% if has_discount %}<span class="ai-deals__compare">{{ deal_variant.compare_at_price | money }}</span>{% endif %}
          </div>
          {% if deal_variant.available %}
            <form class="ai-deals__form" method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ deal_variant.id }}">
              <input type="hidden" name="quantity" value="1">
              <button class="ai-deals__button" type="submit">{{ block.settings.button_label | escape }}</button>
            </form>
          {% else %}
            <a class="ai-deals__button" href="{{ product.url }}">{{ block.settings.sold_out_label | escape }}</a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-deals__empty">Select products in the block settings to show today's deals.</div>
  {% endif %}
</deals-of-day-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'deals-of-day-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class DealsOfDay extends HTMLElement {
      connectedCallback() {
        this.hours = this.querySelector('[data-hours]');
        this.minutes = this.querySelector('[data-minutes]');
        this.seconds = this.querySelector('[data-seconds]');
        this.endTime = Date.parse(this.dataset.end);
        this.updateTimer();
        this.timerInterval = window.setInterval(() => this.updateTimer(), 1000);
      }
      disconnectedCallback() {
        window.clearInterval(this.timerInterval);
      }
      updateTimer() {
        let remaining = Number.isFinite(this.endTime) ? Math.max(0, Math.floor((this.endTime - Date.now()) / 1000)) : 0;
        const hours = Math.floor(remaining / 3600);
        remaining %= 3600;
        const minutes = Math.floor(remaining / 60);
        const seconds = remaining % 60;
        this.hours.textContent = String(hours).padStart(2, '0');
        this.minutes.textContent = String(minutes).padStart(2, '0');
        this.seconds.textContent = String(seconds).padStart(2, '0');
      }
    }
    customElements.define(tagName, DealsOfDay);
  })();
</script>

{% schema %}
{
  "name": "Deals of the day",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Deals of the Day" },
    { "type": "text", "id": "timer_label", "label": "Timer label", "default": "Ends in" },
    { "type": "text", "id": "end_time", "label": "Countdown end time", "default": "2026-12-31T23:59:59+05:30" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Add button label", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Unavailable label", "default": "Sold out" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "#FFF9E8" },
    { "type": "color", "id": "header_background", "label": "Header background", "default": "#FDC656" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#000000" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#FFFFFF" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Deals of the day" }],
  "tag": null,
  "class": "deals-of-the-day-block"
}
{% endschema %}
